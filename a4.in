#!@PYTHON@
import os, argparse, pathlib, sys, platform, shutil, subprocess

DEBUG=0
A4_COMPLETION_START = "# START added automatically by ~/ascend/a4 completion"
A4_COMPLETION_END = "# END added automatically by ~/ascend/a4 completion"

def MSG(*args):
	if DEBUG:
		print(*args)
	else:
		pass
PYTHON=pathlib.Path(r'@PYTHON@')

def get_effective_home():
	home = os.environ.get('HOME')
	if home:
		return pathlib.Path(home)
	userprofile = os.environ.get('USERPROFILE')
	if userprofile:
		return pathlib.Path(userprofile)
	homedrive = os.environ.get('HOMEDRIVE')
	homepath = os.environ.get('HOMEPATH')
	if homedrive and homepath:
		return pathlib.Path(homedrive + homepath)
	return pathlib.Path.home()

def add_at_start(envvar,pathcomponents):
	"""
	Add path components at start of envvar, but only if they're not already in the path somewhere.
	@return 1 if changes made, 0 otherwise
	@TODO what about Windows path munging?
	"""

	# convert pathcomponents to absolute paths
	pathcomponents = [i.resolve() for i in pathcomponents]

	if not os.environ.get(envvar):
		# env var is not yet set; simply set it to requested value
		v = SEP.join([str(p) for p in pathcomponents])
		MSG("CREATED %s=%s" % (envvar,v))
		os.environ[envvar]=v
		return 1

	changed = 0
	# convert what's in there to absolute paths for comparison
	envvals = [pathlib.Path(i).resolve() for i in os.environ[envvar].split(SEP)]
	oldenv = os.environ[envvar]
	found = []
	for p in reversed(pathcomponents):
		if p not in envvals:
			envvals.insert(0,p)
			MSG("INSERTED into %s: %s"%(envvar,p))
			changed = 1

	# TODO if changes made, let's check for repeated path components and remove them (PyGTK All-in-one does this)	
			
	os.environ[envvar]=SEP.join([str(i) for i in envvals])
	if not changed:
		MSG("VAR %s UNCHANGED" % envvar)
	else:
		MSG("VAR %s CHANGED" % envvar)
		MSG("OLD %s = %s" % (envvar,oldenv))
		MSG("NEW %s = %s" % (envvar,os.environ[envvar]))
		
	return changed

def shebang(script,args):
	"""This excessively complex function allows us to launch shebang-encoded scripts when 'a4' is
	run on Windows. It depends on the 'cygpath' program, which in turn depends on some of the 
	MSYS2 environment variables. Does nothing on Linux. Arguably it would be much easier to just
	ask MSYS2 bash to look after all this directly."""
	if not platform.system()== "Windows":
		return [script] + args

	p = pathlib.Path(script)
	if not p.is_file() or not os.access(p, os.X_OK):
		MSG("checking PATHEXT extensions...")
		found = None
		for pe in os.environ.get('PATHEXT').split(";"):
			exe = pathlib.Path(str(script) + pe)
			MSG(f"checking for {exe}")
			if exe.is_file():
				found = exe
				break
		if not found:
			raise RuntimeError(f"script '{script}' either doesn't exist is or not executable")
		return [found]+args
	with open(p,'rb') as f:
		line1 = f.readline()
		if line1.startswith(b"#!"):
			interp = line1[2:].decode('utf-8', errors='replace').strip().split()
			if interp:
				pi = pathlib.Path(interp[0])
				if str(pi)[0] == "/":
					# MSYS path... convert to Windows
					wp = subprocess.run([shutil.which('cygpath'),'-w',pi],capture_output=True,check=True,encoding='utf-8')
					MSG(f"WP = {wp.stdout}")
					pi = pathlib.Path(wp.stdout.strip())
				if not pi.is_absolute():
					raise RuntimeError(f"in script {p}, the shebang line must contain an absolute path (got: '{pi}')")
				if not pi.is_file() or not os.access(pi, os.X_OK):
					raise RuntimeError(f"in script {p}, interpreter '{pi}' is not a file or is not flagged as executable")
				return [pi] + interp[1:] + [script] + args
			raise RuntimeError(f"Invalid shebang line in {script}")
	# does not start with shebang, could be natively executable (we'll just try)
	return [script]+args

def resolve_cmd_for_debugger(cmd):
	"""Resolve the target command before passing it to GDB.

	This is mainly needed on Windows, where GDB won't expand PATHEXT for a
	command like ``test/test`` but ``subprocess.run`` can still execute the
	corresponding ``test/test.exe``.
	"""
	if not cmd:
		return cmd
	return shebang(cmd[0], cmd[1:])

def norm_path(path_value):
	return os.path.normcase(str(pathlib.Path(path_value).resolve()))

def same_path(lhs, rhs):
	return norm_path(lhs) == norm_path(rhs)

def complete_models(sourceroot, filen, prefix):
	helper = r'''
import os, pathlib, platform, re, sys

MODEL_RE = re.compile(r'^\s*MODEL\s+([A-Za-z_][A-Za-z_0-9]*)\b', re.MULTILINE)

def norm_path(path_value):
	return os.path.normcase(str(pathlib.Path(path_value).resolve()))

def same_path(lhs, rhs):
	return norm_path(lhs) == norm_path(rhs)

def emit_regex_matches(filen, prefix):
	seen = set()
	text = filen.read_text(encoding='utf-8', errors='replace')
	for name in MODEL_RE.findall(text):
		if name in seen or not name.startswith(prefix):
			continue
		print(name)
		seen.add(name)

sourceroot = pathlib.Path(sys.argv[1])
filen = pathlib.Path(sys.argv[2])
prefix = sys.argv[3]
sys.path[:0] = [
	str(sourceroot / 'ascxx'),
	str(sourceroot / 'pygtk'),
	str(sourceroot / 'models' / 'johnpye' / 'fprops' / 'python'),
]
try:
	if platform.system() == 'Windows':
		os.add_dll_directory(str(sourceroot))
	import ascpy

	library = ascpy.Library()
	library.load(str(filen))
	seen = set()
	for module in library.getModules():
		module_filename = module.getFilename()
		if not module_filename or not same_path(module_filename, filen):
			continue
		for model_type in library.getModuleTypes(module):
			name = model_type.getName().toString()
			if not model_type.isModel() or name in seen or not name.startswith(prefix):
				continue
			print(name)
			seen.add(name)
except Exception:
	emit_regex_matches(filen, prefix)
'''
	proc = subprocess.run(
		[PYTHON, '-c', helper, str(sourceroot), str(filen), prefix],
		capture_output=True,
		encoding='utf-8',
	)
	if proc.stdout:
		sys.stdout.write(proc.stdout)

def cutest_listing(sourceroot, args):
	cmd = shebang(sourceroot / 'test' / 'test', args)
	proc = subprocess.run(cmd, capture_output=True, check=True, encoding='utf-8')
	items = []
	for line in (proc.stdout + proc.stderr).splitlines():
		if not line[:1].isspace():
			continue
		name = line.strip()
		if not name or " " in name:
			continue
		items.append(name)
	return items

def complete_cutest(sourceroot, prefix):
	suites = cutest_listing(sourceroot, ['-l'])
	if '.' not in prefix:
		for suite in suites:
			if suite.startswith(prefix):
				print(suite)
		return

	suite_prefix, test_prefix = prefix.split('.', 1)
	matched_suites = [suite for suite in suites if suite.startswith(suite_prefix)]

	if suite_prefix in suites:
		selected_suite = suite_prefix
	elif len(matched_suites) == 1:
		selected_suite = matched_suites[0]
	else:
		selected_suite = None

	if selected_suite is None:
		if test_prefix == "":
			for suite in matched_suites:
				print(f"{suite}.")
		return

	for test in cutest_listing(sourceroot, ['-t', selected_suite]):
		candidate = f"{selected_suite}.{test}"
		if candidate.startswith(prefix):
			print(candidate)

def completion_block(completion_script):
	completion_script = pathlib.Path(completion_script).resolve()
	return "\n".join([
		A4_COMPLETION_START,
		f'if [ -f "{completion_script}" ]; then',
		f'\t. "{completion_script}"',
		'fi',
		A4_COMPLETION_END,
	]) + "\n"

def install_bash_completion_profile(profile_path, completion_script):
	profile_path = pathlib.Path(profile_path)
	completion_script = pathlib.Path(completion_script).resolve()
	block = completion_block(completion_script)
	if profile_path.exists():
		existing = profile_path.read_text(encoding='utf-8')
	else:
		existing = ""

	lines = existing.splitlines()
	kept = []
	i = 0
	while i < len(lines):
		if lines[i] == A4_COMPLETION_START:
			i += 1
			while i < len(lines) and lines[i] != A4_COMPLETION_END:
				i += 1
			if i < len(lines):
				i += 1
			continue
		kept.append(lines[i])
		i += 1

	base = "\n".join(kept).rstrip()
	if base:
		updated = base + "\n\n" + block
	else:
		updated = block

	changed = updated != existing
	if changed:
		profile_path.write_text(updated, encoding='utf-8')
	return changed, profile_path, completion_script

def setup_bash_completion(sourceroot):
	profile_path = get_effective_home() / '.bashrc'
	completion_script = sourceroot / 'tools' / 'completion' / 'a4.bash'
	changed, profile_path, completion_script = install_bash_completion_profile(profile_path, completion_script)

	if changed:
		print(f"Updated {profile_path}")
	else:
		print(f"No changes needed in {profile_path}")

	print(f"Bash completion script: {completion_script}")
	print("Current shell was not modified: './a4 completion' runs in a child process and cannot source into the parent bash.")
	print(f"To enable it now in this shell, run: source \"{completion_script}\"")

if __name__ == "__main__":
	argv = list(sys.argv)
	if (
		len(argv) >= 3
		and argv[1] == 'cutest'
		and '--' not in argv[2:]
		and any(arg in ('-h', '--help') for arg in argv[2:])
	):
		argv[2:] = ['--help' if arg == '-h' else arg for arg in argv[2:]]
		# Forward cutest help flags to the underlying runner instead of
		# letting argparse consume them as subcommand help.
		argv.insert(2, '--')
	if (
		len(argv) >= 3
		and argv[1] == 'units'
		and '--' not in argv[2:]
		and any(arg in ('-h', '--help') for arg in argv[2:])
	):
		argv[2:] = ['--help' if arg == '-h' else arg for arg in argv[2:]]
		# Forward units help flags to the underlying runner instead of
		# letting argparse consume them as subcommand help.
		argv.insert(2, '--')

	p = argparse.ArgumentParser(description='ASCEND launcher')

	p.add_argument('--debug',action='store_true',help='Show launcher debug output')
	g = p.add_mutually_exclusive_group()
	g.add_argument('--gdb',action='store_true',help='Run action via GDB')
	g.add_argument('--gdb1',action='store_true',help='Run action via non-interactive GDB with backtrace on exit')
	g.add_argument('--valgrind',action='store_true',help='Run action via Valgrind')
	g.add_argument('--callgrind',action='store_true',help='Run action via Valgrind Callgrind profiler')

	s = p.add_subparsers(help='sub-command help')
	
	p_open = s.add_parser('open',help = 'Open file in ASCEND GUI')
	p_open.set_defaults(action='open')
	p_open.add_argument('file',type=pathlib.Path)
	p_open.add_argument('--model','-m', help="Name of MODEL to instantiate");
	
	p_gui = s.add_parser('gui',help = 'Simply open the ASCEND GUI')
	p_gui.set_defaults(action='gui')

	def add_integrate_args(parser):
		parser.add_argument('--engine','-e', help="Integrator engine to use (default when integrating: IDA)")
		parser.add_argument('--start','-s', type=float, help="Integration start value, in the selected units")
		parser.add_argument('--duration','-d', type=float, help="Integration duration in the selected units (default when integrating: 100)")
		parser.add_argument('--steps', type=int, help="Number of output/reporting steps (default when integrating: 30)")
		parser.add_argument('--units','-u', help="Units token for integration bounds, eg 's' or 'h'")
		parser.add_argument('--output','-o', type=pathlib.Path, help="Write integration results as TSV to this file")
		parser.add_argument('--plot', action='store_true', help="Plot observed real-valued variables against the independent variable after integration")
		parser.add_argument('--microstates', nargs='?', choices=('none','endpoints','all'), const='all', default='endpoints',
			help="Include extra same-time event output rows. Default: endpoints; bare --microstates means all.")

	p_run = s.add_parser('run',help = 'Run model without GUI (steady solve by default, integrate with --integrate or any integrate-only flag)')

	if sys.version_info.major == 3 and sys.version_info.minor < 8:
		class ExtendAction(argparse.Action):
			def __call__(self, parser, namespace, values, option_string=None):
				items = getattr(namespace, self.dest) or []
				items.extend(values)
				setattr(namespace, self.dest, items)
		p_run.register('action', 'extend', ExtendAction)

	p_run.set_defaults(action='run')
	p_run.add_argument('file',type=pathlib.Path,help='ASCEND model file to be opened')
	p_run.add_argument('--model','-m', help="Name of MODEL to instantiate (defaults to filename without extension)");
	p_run.add_argument('--integrate','--int','-i', action='store_true', help="Run via the integrator API instead of the steady-state solver.")
	add_integrate_args(p_run)
	p_run.add_argument('-r', '--run-method', dest='runmethod', help="Run METHOD after 'on_load' and before the final solve");
	p_run.add_argument('-p', '--print', dest='printvars', action='extend', nargs='+', help='Variables to print (can be used multiple times). Implies --no-test.')
	p_run.add_argument('--no-test','-n', action='store_true', help="Suppress running of 'self_test' method after solving");

	p_int = s.add_parser('int',help = 'Alias for `run --integrate`')
	p_int.set_defaults(action='run', integrate=True)
	p_int.add_argument('file',type=pathlib.Path,help='ASCEND model file to be opened')
	p_int.add_argument('--model','-m', help="Name of MODEL to instantiate (defaults to filename without extension)");
	add_integrate_args(p_int)

	p_scr = s.add_parser('script',help = 'Run a Python or other script within ASCEND development environment')
	p_scr.set_defaults(action='script')
	p_scr.add_argument('file',type=pathlib.Path,help='Script file to be run')
	p_scr.add_argument('rest',nargs=argparse.REMAINDER,help='Additional arguments to be passed to the script')

	p_cutest = s.add_parser('cutest',help = 'Run ASCEND CUnit test runner with ASCEND environment set')
	p_cutest.set_defaults(action='cutest')
	p_cutest.add_argument('rest',nargs=argparse.REMAINDER,help='Arguments to pass to test/test')

	p_complete = s.add_parser('complete', help=argparse.SUPPRESS)
	p_complete.set_defaults(action='complete')
	s_complete = p_complete.add_subparsers(dest='complete_action', help=argparse.SUPPRESS)

	p_complete_models = s_complete.add_parser('models', help=argparse.SUPPRESS)
	p_complete_models.set_defaults(complete_action='models')
	p_complete_models.add_argument('file', type=pathlib.Path, help=argparse.SUPPRESS)
	p_complete_models.add_argument('prefix', nargs='?', default='', help=argparse.SUPPRESS)

	p_complete_cutest = s_complete.add_parser('cutest', help=argparse.SUPPRESS)
	p_complete_cutest.set_defaults(complete_action='cutest')
	p_complete_cutest.add_argument('prefix', nargs='?', default='', help=argparse.SUPPRESS)

	p_completion = s.add_parser('completion', help='Install Bash completion hook into ~/.bashrc')
	p_completion.set_defaults(action='completion')

	p_units = s.add_parser('units',help = 'Manage display-units overrides')
	p_units.set_defaults(action='units')
	p_units.add_argument('rest',nargs=argparse.REMAINDER,help='Arguments to pass to rununits.py')
	
	p_sh = s.add_parser('env',help = 'Create a sub-shell in which ASCEND environment variables are set.')
	p_sh.set_defaults(action='env')
	p_sh.add_argument('--shell',default='bash',help='Shell to run')
	p_sh.add_argument('--label',action='store_false',default=True,help="Suppress adding 'a4>' text at start of prompt")
	p_sh.add_argument('rest',nargs=argparse.REMAINDER,help='Extra arguments to send to shell')

	p_sh = s.add_parser('q',help = 'Quick shortcut test -- test a4.in source for details.')
	p_sh.set_defaults(action='q')

	args, unknown = p.parse_known_args(argv[1:])
	if unknown:
		if hasattr(args, 'action') and args.action == 'cutest':
			# Pass unknown args through to the test runner.
			if not hasattr(args, 'rest') or args.rest is None:
				args.rest = []
			args.rest = unknown + list(args.rest)
		else:
			p.error("unrecognized arguments: " + " ".join(unknown))

	if args.debug:
		DEBUG=1
		MSG("Debugging output turned on!")
	else:
		sys.tracebacklimit=0

	sourceroot=pathlib.Path("@SOURCE_ROOT@")
	script=os.path.join(sys.argv[0])
	SEP = os.pathsep
	
	if platform.system()=="Windows":
		LD_LIBRARY_PATH="PATH"
	elif platform.system()=="Darwin":
		LD_LIBRARY_PATH="DYLD_LIBRARY_PATH"
	else:
		LD_LIBRARY_PATH="LD_LIBRARY_PATH"

	restart = []

	# for Mac, add our local PyGTK libraries at start of Python path:
	#if platform.system()=="Darwin":
	#	sys.path.insert(0,'dist/gtk.bundle/python')

	# ensure that we have our 'models' dir in the ASCENDLIBRARY path
	modeldirs = [sourceroot / 'models']
	if add_at_start('ASCENDLIBRARY',modeldirs):
		restart.append('ASCENDLIBRARY')

	solverdir = sourceroot / 'solvers'
	solverdirs = [solverdir / d.lower() for d in "@WITH_SOLVERS@".split(",")]
	if add_at_start('ASCENDSOLVERS',solverdirs):
		restart.append('ASCENDSOLVERS')

	# ensure that we have our shared libraries in the LD_LIBRARY_PATH
	if platform.system() == 'Windows':
		local_libdirs = [get_effective_home() / '.local/bin']
	else:
		local_libdirs = [
			get_effective_home() / '.local/lib64',
			get_effective_home() / '.local/lib',
		]
	configured_runtime_libdirs = [pathlib.Path(p) for p in @A4_RUNTIME_LIBDIRS@]
	libdirs = [sourceroot] + local_libdirs + configured_runtime_libdirs
	if add_at_start(LD_LIBRARY_PATH,libdirs):
		restart.append(LD_LIBRARY_PATH)

	# ensure our pygtk dir is in the PYTHONPATH
	pypath = [sourceroot / 'ascxx', sourceroot / 'pygtk']
	# also FPROPS
	pypath += [sourceroot / 'models' / 'johnpye' / 'fprops' / 'python']
	if add_at_start('PYTHONPATH',pypath):
		restart.append('PYTHONPATH')

	# bintoken compile/link helpers expect single root paths, not PATH lists.
	# In an in-tree dev run, default these to source root if user has not set them.
	if not os.environ.get('ASCENDBTINC'):
		os.environ['ASCENDBTINC'] = str(sourceroot)
		MSG("CREATED ASCENDBTINC=%s" % os.environ['ASCENDBTINC'])
	if not os.environ.get('ASCENDBTLIB'):
		os.environ['ASCENDBTLIB'] = str(sourceroot)
		MSG("CREATED ASCENDBTLIB=%s" % os.environ['ASCENDBTLIB'])

	if hasattr(args, 'action') and args.action == 'complete':
		if not getattr(args, 'complete_action', None):
			p.error("missing completion target")
		if args.complete_action == 'models':
			complete_models(sourceroot, args.file, args.prefix)
		elif args.complete_action == 'cutest':
			complete_cutest(sourceroot, args.prefix)
		else:
			p.error("unsupported completion target")
		sys.exit(0)

	if hasattr(args, 'action') and args.action == 'completion':
		setup_bash_completion(sourceroot)
		sys.exit(0)

	MSG("ARGS",args)
		
	precmd = []
	debugger_batch = False
	if args.gdb:
		precmd = ['gdb','--args']
	elif args.gdb1:
		debugger_batch = True
	elif args.valgrind:
		VALGRIND = shutil.which('valgrind')
		if VALGRIND == None:
			raise RuntimeError("Could not locate 'valgrind' in the PATH")
		precmd = [VALGRIND]+ '--suppressions=tools/valgrind/suppressions --tool=memcheck --leak-check=full --show-reachable=yes'.split(' ')
	elif args.callgrind:
		VALGRIND = shutil.which('valgrind')
		if VALGRIND == None:
			raise RuntimeError("Could not locate 'valgrind' in the PATH")
		callgrind_out = os.environ.get('ASC_CALLGRIND_OUT','callgrind.out.%p')
		precmd = [VALGRIND] + [
			'--tool=callgrind'
			, '--trace-children=yes'
			, '--callgrind-out-file=%s' % callgrind_out
		]
	
	cmd = precmd
	if not hasattr(args,'action') or args.action == 'gui':
		MSG("launching GUI...")
		cmd += [PYTHON,sourceroot/'pygtk'/'ascdev']
	elif args.action == 'open':
		cmd += [PYTHON,sourceroot/'pygtk'/'ascdev', args.file]
		if args.model:
			cmd += ['-m',args.model]
	elif args.action == 'run':
		# note that we cannot avoid invoking a subprocess here, because
		# we cannot update LD_LIBRARY_PATH for the running process, which means
		# that ascpy cannot successfully load libascend.so.
		cmd += [PYTHON,sourceroot/'ascxx'/'runmodel.py',args.file]
		if args.model:
			cmd += ["--model",args.model]
		if hasattr(args,'runmethod') and args.runmethod:
			cmd += ["--run-method",args.runmethod]
		integrate_requested = bool(
			getattr(args,'integrate',False)
			or getattr(args,'engine',None) is not None
			or getattr(args,'start',None) is not None
			or getattr(args,'duration',None) is not None
			or getattr(args,'steps',None) is not None
			or getattr(args,'units',None) is not None
			or getattr(args,'output',None) is not None
			or getattr(args,'plot',False)
			or getattr(args,'microstates','endpoints') != 'endpoints'
		)
		if integrate_requested:
			cmd += ["--integrate"]
			if args.engine:
				cmd += ["--engine",args.engine]
			if args.start is not None:
				cmd += ["--start",str(args.start)]
			if args.duration is not None:
				cmd += ["--duration",str(args.duration)]
			if args.steps is not None:
				cmd += ["--steps",str(args.steps)]
			if args.units:
				cmd += ["--units",args.units]
			if args.output:
				cmd += ["--output",str(args.output)]
			if args.plot:
				cmd += ["--plot"]
			if args.microstates != 'endpoints':
				cmd += ["--microstates",args.microstates]
		if hasattr(args,'printvars') and args.printvars:
			cmd += ["--print"] + args.printvars
		if hasattr(args,'no_test') and args.no_test:
			cmd += ["--no-test"]
	elif args.action == 'q':
		# for the convenience of the developer -- hack this for your temporary needs
		cmd += [PYTHON,sourceroot/'pygtk'/'ascdev', sourceroot/'models'/'johnpye'/'extpy'/'extpytest.a4c']
	elif args.action == 'script':
		cmd += shebang(args.file,args.rest)
	elif args.action == 'cutest':
		rest = list(args.rest)
		if rest and rest[0] == '--':
			rest = rest[1:]
		cmd += shebang(sourceroot / 'test' / 'test', rest)
	elif args.action == 'units':
		rest = list(args.rest)
		if rest and rest[0] == '--':
			rest = rest[1:]
		cmd += [PYTHON, sourceroot / 'ascxx' / 'rununits.py'] + rest
	elif args.action == 'env' :
		shargs = []
		if os.environ.get('ASCEND_SHELL'):
			raise RuntimeError("You are already inside an ASCEND shell")
		rest = list(args.rest)
		if rest and rest[0] == '--':
			rest = rest[1:]
		shell = args.shell
		if platform.system() == "Windows":
			shname = pathlib.Path(shell).name.lower()
			cygpath = shutil.which('cygpath')
			if shname in ('bash','bash.exe') and os.environ.get('MSYSTEM'):
				# In MSYS2, avoid Windows resolving bare 'bash' to WSL's System32\bash.exe.
				if cygpath:
					wp = subprocess.run([cygpath,'-w','/usr/bin/bash.exe'],capture_output=True,check=True,encoding='utf-8')
					shell = wp.stdout.strip()
				elif shname == 'bash':
					shell = 'bash.exe'
			elif shell.startswith('/') and cygpath:
				# Convert explicit MSYS-style shell paths for CreateProcess on Windows.
				wp = subprocess.run([cygpath,'-w',shell],capture_output=True,check=True,encoding='utf-8')
				shell = wp.stdout.strip()
		if args.label:
			if pathlib.Path(shell).name.lower() in ('bash','bash.exe'):
				os.environ['PS1'] = r'a4> \[\e]0;\u@\h: \w\a\]${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
				shargs += ['--norc']
		os.environ['ASCEND_SHELL'] = '1'
		cmd += [shell] + shargs + rest
	else:
		print("unrecognised command")
		sys.exit(1);

	if debugger_batch:
		cmd = [
			'gdb'
			, '-batch'
			, '-return-child-result'
			, '-ex', 'set debuginfod enabled off'
			, '-ex', 'set pagination off'
			, '-ex', 'run'
			, '-ex', 'thread apply all bt full'
			, '--args'
		] + resolve_cmd_for_debugger(cmd)
		
	MSG("CMD =",cmd)
	proc = subprocess.run(cmd)
	sys.exit(proc.returncode)

# vim:syntax=python:ts=4:sw=4:noet
