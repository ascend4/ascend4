Import('env')
import os
import re
import shlex
import SCons.Util
import subprocess

sundials_version_major_required = 5
sundials_version_minor_min = 0

sundials_version_text = """
#include <sundials/sundials_config.h>
#include <stdio.h>
int main(void){
	printf("%s", SUNDIALS_VERSION);
	return 0;
}
"""

ida_test_text = """
#if SUNDIALS_VERSION_MAJOR >= 6
# include <sundials/sundials_config.h>
# include <sundials/sundials_context.h>
# include <nvector/nvector_serial.h>
# include <ida/ida.h>
#else
# include <sundials/sundials_config.h>
# include <nvector/nvector_serial.h>
# include <ida/ida.h>
# include <ida/ida_ls.h>
# include <sunmatrix/sunmatrix_dense.h>
# include <sunlinsol/sunlinsol_dense.h>
#endif
int main(void){
	void *ida_mem;
#if SUNDIALS_VERSION_MAJOR >= 6
	SUNContext sunctx;
# if SUNDIALS_VERSION_MAJOR >= 7
	SUNContext_Create(SUN_COMM_NULL, &sunctx);
# else
	SUNContext_Create(NULL, &sunctx);
# endif
	ida_mem = IDACreate(sunctx);
#else
	ida_mem = IDACreate();
#endif
	return ida_mem == NULL;
}
"""

idas_test_text = ida_test_text.replace('<ida/ida.h>', '<idas/idas.h>').replace('<ida/ida_ls.h>', '<idas/idas_ls.h>')

def _as_list(value):
	if value is None:
		return []
	if SCons.Util.is_List(value):
		return list(value)
	return [value]

def _default_sundials_libs(major, backend='ida'):
	libs = ['sundials_%s' % backend, 'sundials_nvecserial']
	if major >= 5:
		core_lib = 'sundials_generic'
		if major >= 7:
			core_lib = 'sundials_core'
		libs.extend([
			'sundials_sunlinsoldense',
			'sundials_sunlinsolspgmr',
			'sundials_sunlinsolspbcgs',
			'sundials_sunlinsolsptfqmr',
			'sundials_sunmatrixdense',
			core_lib,
		])
	libs.append('m')
	return libs

def _read_sundials_config(include_dirs):
	for include_dir in _as_list(include_dirs):
		config = os.path.join(include_dir, 'sundials', 'sundials_config.h')
		if not os.path.exists(config):
			continue
		values = {}
		with open(config, 'r') as f:
			for line in f:
				m = re.match(r'#define\s+(SUNDIALS_MPI_ENABLED)\s+(\d+)', line)
				if m:
					values[m.group(1)] = int(m.group(2))
		return values
	return {}

def _parse_flag_words(words):
	cpppath = []
	libpath = []
	libs = []
	for word in words:
		if word.startswith('-I') and len(word) > 2:
			cpppath.append(word[2:])
		elif word.startswith('-L') and len(word) > 2:
			libpath.append(word[2:])
		elif word.startswith('-l') and len(word) > 2:
			libs.append(word[2:])
	return cpppath, libpath, libs

def _detect_mpi_flags():
	try:
		compile_out = subprocess.check_output(
			['mpicc', '--showme:compile'], universal_newlines=True
		).strip()
		link_out = subprocess.check_output(
			['mpicc', '--showme:link'], universal_newlines=True
		).strip()
	except Exception:
		return None

	cpppath, _, _ = _parse_flag_words(shlex.split(compile_out))
	_, libpath, libs = _parse_flag_words(shlex.split(link_out))
	return {
		'cpppath': cpppath,
		'libpath': libpath,
		'libs': libs,
	}

def CheckSUNDIALSVersion(context):
	context.Message('Checking for SUNDIALS... ')
	is_ok, output = context.TryRun(sundials_version_text, '.c')
	if not is_ok:
		context.Result('no')
		return False

	try:
		major, minor, patch = tuple(int(i) for i in output.split('.'))
	except Exception:
		context.Result('no (unparseable version)')
		return False

	context.env['SUNDIALS_VERSION_MAJOR'] = major
	context.env['SUNDIALS_VERSION_MINOR'] = minor
	context.env['SUNDIALS_CPPPATH_EXTRA'] = []
	context.env['SUNDIALS_MPI_CPPPATH'] = []
	context.env['SUNDIALS_MPI_LIBPATH'] = []
	context.env['SUNDIALS_MPI_LIBS'] = []
	if major == 2 and minor == 2 and context.env.get('SUNDIALS_CPPPATH'):
		extra_cpppath = ['%s/sundials' % p for p in _as_list(context.env.get('SUNDIALS_CPPPATH'))]
		context.env.AppendUnique(
			SUNDIALS_CPPPATH_EXTRA=extra_cpppath
		)

	config = _read_sundials_config(context.env.get('SUNDIALS_CPPPATH'))
	context.env['SUNDIALS_MPI_ENABLED'] = int(bool(config.get('SUNDIALS_MPI_ENABLED', 0)))
	if context.env['SUNDIALS_MPI_ENABLED']:
		mpi_flags = _detect_mpi_flags()
		if not mpi_flags:
			context.Result('%s (MPI-enabled build but mpicc flags unavailable)' % output.strip())
			return False
		context.env.AppendUnique(SUNDIALS_MPI_CPPPATH=mpi_flags['cpppath'])
		context.env.AppendUnique(SUNDIALS_MPI_LIBPATH=mpi_flags['libpath'])
		context.env.AppendUnique(SUNDIALS_MPI_LIBS=mpi_flags['libs'])

	if major < sundials_version_major_required or (
		major == sundials_version_major_required and minor < sundials_version_minor_min
	):
		context.Result('%s (bad version)' % output.strip())
		return False

	context.Result('%d.%d.%d, good' % (major, minor, patch))
	return True

def _check_sundials_dae_backend(context, name, test_text):
	context.Message('Checking for %s... ' % name)
	orig_cpppath = list(_as_list(context.env.get('CPPPATH')))
	orig_libpath = list(_as_list(context.env.get('LIBPATH')))
	orig_libs = list(_as_list(context.env.get('LIBS')))
	context.env.AppendUnique(CPPPATH=context.env.get('SUNDIALS_CPPPATH_EXTRA') or [])
	context.env.AppendUnique(CPPPATH=context.env.get('SUNDIALS_MPI_CPPPATH') or [])
	context.env.AppendUnique(LIBPATH=context.env.get('SUNDIALS_MPI_LIBPATH') or [])
	context.env.AppendUnique(LIBS=context.env.get('SUNDIALS_LIBS') or [])
	context.env.AppendUnique(LIBS=context.env.get('SUNDIALS_MPI_LIBS') or [])
	is_ok = context.TryLink(test_text, '.c')
	context.env['CPPPATH'] = orig_cpppath
	context.env['LIBPATH'] = orig_libpath
	context.env['LIBS'] = orig_libs
	context.Result(is_ok)
	return is_ok

def CheckIDA(context):
	return _check_sundials_dae_backend(context, 'IDA', ida_test_text)

def CheckIDAS(context):
	return _check_sundials_dae_backend(context, 'IDAS', idas_test_text)

if env.get('WITH_IDA'):
	solver_env = env.Clone()
	ida_reason = None

	if env.get('WITH_MMIO'):
		solver_env.AppendUnique(CPPPATH=['#/mmio'])

	if env.get('SUNDIALS_CPPPATH'):
		solver_env.AppendUnique(CPPPATH=_as_list(env.get('SUNDIALS_CPPPATH')))
	if env.get('SUNDIALS_LIBPATH'):
		solver_env.AppendUnique(LIBPATH=_as_list(env.get('SUNDIALS_LIBPATH')))
	if env.get('SUNDIALS_LIBS'):
		solver_env.AppendUnique(LIBS=_as_list(env.get('SUNDIALS_LIBS')))
	if env.get('SUNDIALS_MPI_CPPPATH'):
		solver_env.AppendUnique(CPPPATH=_as_list(env.get('SUNDIALS_MPI_CPPPATH')))
	if env.get('SUNDIALS_MPI_LIBPATH'):
		solver_env.AppendUnique(LIBPATH=_as_list(env.get('SUNDIALS_MPI_LIBPATH')))
	if env.get('SUNDIALS_MPI_LIBS'):
		solver_env.AppendUnique(LIBS=_as_list(env.get('SUNDIALS_MPI_LIBS')))

	conf = solver_env.Configure(custom_tests={
		'CheckSUNDIALSVersion': CheckSUNDIALSVersion,
		'CheckIDA': CheckIDA,
		'CheckIDAS': CheckIDAS,
	})
	if not conf.CheckSUNDIALSVersion():
		conf.env['WITH_IDA'] = False
		ida_reason = 'SUNDIALS not found, or bad version'
	else:
		major = conf.env['SUNDIALS_VERSION_MAJOR']
		conf.env['SUNDIALS_LIBS'] = _default_sundials_libs(major, 'idas')
		if conf.CheckIDAS():
			conf.env['SUNDIALS_DAE_BACKEND'] = 'idas'
			conf.env.AppendUnique(CPPDEFINES=['ASC_IDA_BACKEND_IDAS'])
		else:
			conf.env['SUNDIALS_LIBS'] = _default_sundials_libs(major, 'ida')
			if conf.CheckIDA():
				conf.env['SUNDIALS_DAE_BACKEND'] = 'ida'
			else:
				conf.env['WITH_IDA'] = False
				ida_reason = 'Unable to compile/link against SUNDIALS IDAS or IDA'
	solver_env = conf.Finish()

	env.set_optional('ida', active=solver_env['WITH_IDA'], reason=ida_reason)

	if solver_env['WITH_IDA']:
		solver_env.AppendUnique(CPPPATH=solver_env.get('SUNDIALS_CPPPATH_EXTRA') or [])
		solver_env.AppendUnique(LIBS=solver_env.get('SUNDIALS_LIBS') or [])
		solver_env.AppendUnique(LIBPATH=['#'])
		solver_env.AppendUnique(LIBS=['ascend'])

		srcs = ['ida.c', 'idacalc.c', 'idalinear.c', 'idaio.c', 'idaprec.c', 'idaanalyse.c', 'idaboundary.c']
		lib = solver_env.SharedLibrary('ida', srcs,
			SHLIBSUFFIX=env['EXTLIB_SUFFIX'],
			SHLIBPREFIX=env['EXTLIB_PREFIX']
		)

		env.Depends(lib, env['libascend'])
		env['extfns'] += lib

		if env.get('CAN_INSTALL'):
			dir = Dir(env.subst('$INSTALL_ROOT$INSTALL_SOLVERS'))
			env.InstallShared(dir, lib)
	else:
		print("Skipping... IDA solver won't be built.")

