FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HIGHS_VERSION=v1.13.1
ENV HOME=/root
ENV PATH=/root/.local/bin:${PATH}
ENV PKG_CONFIG_PATH=/root/.local/lib/pkgconfig:/root/.local/lib64/pkgconfig

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    automake \
    autoconf \
    libtool \
    build-essential \
    gfortran \
    flex \
    bison \
    scons \
    swig \
    graphviz \
    libgraphviz-dev \
    python3 \
    python3-dev \
    python3-gi \
    python3-numpy \
    python3-packaging \
    libgtk-3-dev \
    liblapack-dev \
    libblas-dev \
    libsundials-dev \
    coinor-libipopt-dev \
    libmumps-seq-dev \
    libpcre3-dev \
    subversion \
    cmake \
    git \
    pkg-config \
    ca-certificates \
    rsync

RUN rm -rf /var/lib/apt/lists/*

RUN svn co https://svn.code.sf.net/p/cunit/code/branches/mingw64 /tmp/cunit \
 && cd /tmp/cunit \
 && ./bootstrap \
 && ./configure --prefix=$HOME/.local --enable-examples --enable-debug \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/cunit

RUN git clone --branch "$HIGHS_VERSION" --depth 1 https://github.com/ERGO-Code/HiGHS.git /tmp/highs \
 && cd /tmp/highs \
 && cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=$HOME/.local \
      -DBUILD_SHARED_LIBS=ON \
 && cmake --build build -j"$(nproc)" \
 && cmake --install build \
 && rm -rf /tmp/highs

WORKDIR /work

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["bash"]
