REQUIRE "atoms.a4l";

(* Netlib AFIRO LP benchmark transcribed from AFIRO.SIF / MPS form.
   Row/column naming mirrors the published instance for traceability.
   Expected optimum objective: approximately -464.75314286.
*)
MODEL afiro;
	x01, x02, x03, x04, x06, x07, x08, x09,
	x10, x11, x12, x13, x14, x15, x16,
	x22, x23, x24, x25, x26,
	x28, x29, x30, x31,
	x32, x33, x34, x35, x36, x37, x38, x39 IS_A factor;

	r09:  -x01 + x02 + x03 = 0;
	r10:  -1.06*x01 + x04 = 0;
	x05:  x01 <= 80;
	x21:  -x02 + 1.4*x14 <= 0;
	r12:  -x06 - x07 - x08 - x09 + x14 + x15 = 0;
	r13:  -1.06*x06 - 1.06*x07 - 0.96*x08 - 0.86*x09 + x16 = 0;
	x17:  x06 - x10 <= 80;
	x18:  x07 - x11 <= 0;
	x19:  x08 - x12 <= 0;
	x20:  x09 - x13 <= 0;
	r19:  -x22 + x23 + x24 + x25 = 0;
	r20:  -0.43*x22 + x26 = 0;
	x27:  x22 <= 500;
	x44:  -x23 + 1.4*x36 <= 0;
	r22:  -0.43*x28 - 0.43*x29 - 0.39*x30 - 0.37*x31 + x38 = 0;
	r23:  x28 + x29 + x30 + x31 - x36 + x37 + x39 = 44;
	x40:  x28 - x32 <= 500;
	x41:  x29 - x33 <= 0;
	x42:  x30 - x34 <= 0;
	x43:  x31 - x35 <= 0;
	x45:
		2.364*x10 + 2.386*x11 + 2.408*x12 + 2.429*x13
	  - x25
	  + 2.191*x32 + 2.219*x33 + 2.249*x34 + 2.279*x35 <= 0;
	x46:  -x03 + 0.109*x22 <= 0;
	x47:  -x15 + 0.109*x28 + 0.108*x29 + 0.108*x30 + 0.107*x31 <= 0;
	x48:  0.301*x01 - x24 <= 0;
	x49:  0.301*x06 + 0.313*x07 + 0.313*x08 + 0.326*x09 - x37 <= 0;
	x50:  x04 + x26 <= 310;
	x51:  x16 + x38 <= 300;

	obj: MINIMIZE -0.40*x02 - 0.32*x14 - 0.60*x23 - 0.48*x36 + 10.0*x39;

METHODS

METHOD bound_self;
	x01.lower_bound := 0;  x02.lower_bound := 0;  x03.lower_bound := 0;  x04.lower_bound := 0;
	x06.lower_bound := 0;  x07.lower_bound := 0;  x08.lower_bound := 0;  x09.lower_bound := 0;
	x10.lower_bound := 0;  x11.lower_bound := 0;  x12.lower_bound := 0;  x13.lower_bound := 0;
	x14.lower_bound := 0;  x15.lower_bound := 0;  x16.lower_bound := 0;
	x22.lower_bound := 0;  x23.lower_bound := 0;  x24.lower_bound := 0;  x25.lower_bound := 0;
	x26.lower_bound := 0;
	x28.lower_bound := 0;  x29.lower_bound := 0;  x30.lower_bound := 0;  x31.lower_bound := 0;
	x32.lower_bound := 0;  x33.lower_bound := 0;  x34.lower_bound := 0;  x35.lower_bound := 0;
	x36.lower_bound := 0;  x37.lower_bound := 0;  x38.lower_bound := 0;  x39.lower_bound := 0;
END bound_self;

METHOD default_self;
	x01 := 0;  x02 := 0;  x03 := 0;  x04 := 0;
	x06 := 0;  x07 := 0;  x08 := 0;  x09 := 0;
	x10 := 0;  x11 := 0;  x12 := 0;  x13 := 0;
	x14 := 0;  x15 := 0;  x16 := 0;
	x22 := 0;  x23 := 0;  x24 := 0;  x25 := 0;
	x26 := 0;
	x28 := 0;  x29 := 0;  x30 := 0;  x31 := 0;
	x32 := 0;  x33 := 0;  x34 := 0;  x35 := 0;
	x36 := 0;  x37 := 0;  x38 := 0;  x39 := 0;
END default_self;

METHOD on_load;
	RUN bound_self;
	RUN default_self;
END on_load;

END afiro;
