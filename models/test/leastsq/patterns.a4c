REQUIRE "system.a4l";
REQUIRE "atoms.a4l";

MODEL lsq_basic;
	x[1..3] IS_A solver_var;
	y[1..3] IS_A real_constant;
	y[1] :== 1.0;
	y[2] :== 2.0;
	y[3] :== 3.0;
	obj: MINIMIZE SUM[(x[i] - y[i])^2 | i IN [1..3]];
METHODS
METHOD on_load;
	x[1] := 2.0;
	x[2] := 4.0;
	x[3] := 6.0;
END on_load;
END lsq_basic;

MODEL lsq_weighted;
	x[1..3] IS_A solver_var;
	y[1..3], w[1..3] IS_A real_constant;
	y[1] :== 1.0;
	y[2] :== 2.0;
	y[3] :== 3.0;
	w[1] :== 0.5;
	w[2] :== 2.0;
	w[3] :== 4.0;
	obj: MINIMIZE SUM[w[i]*(x[i] - y[i])^2 | i IN [1..3]];
METHODS
METHOD on_load;
	x[1] := 2.0;
	x[2] := 4.0;
	x[3] := 6.0;
END on_load;
END lsq_weighted;

MODEL lsq_divided_square;
	x[1..3] IS_A solver_var;
	y[1..3], s[1..3] IS_A real_constant;
	y[1] :== 1.0;
	y[2] :== 2.0;
	y[3] :== 3.0;
	s[1] :== 0.5;
	s[2] :== 2.0;
	s[3] :== 4.0;
	obj: MINIMIZE SUM[(x[i] - y[i])^2/s[i] | i IN [1..3]];
METHODS
METHOD on_load;
	x[1] := 2.0;
	x[2] := 4.0;
	x[3] := 6.0;
END on_load;
END lsq_divided_square;

MODEL lsq_nested_sum;
	x[1..2][1..2] IS_A solver_var;
	y[1..2][1..2], w[1..2][1..2] IS_A real_constant;
	y[1][1] :== 1.0;
	y[1][2] :== 2.0;
	y[2][1] :== 3.0;
	y[2][2] :== 4.0;
	w[1][1] :== 0.5;
	w[1][2] :== 1.0;
	w[2][1] :== 2.0;
	w[2][2] :== 4.0;
	obj: MINIMIZE SUM[
		SUM[w[i][j]*(x[i][j] - y[i][j])^2 | j IN [1..2]]
		| i IN [1..2]
	];
METHODS
METHOD on_load;
	x[1][1] := 2.0;
	x[1][2] := 4.0;
	x[2][1] := 6.0;
	x[2][2] := 8.0;
END on_load;
END lsq_nested_sum;

MODEL lsq_negative_weight;
	x[1..2] IS_A solver_var;
	w[1..2] IS_A real_constant;
	w[1] :== 1.0;
	w[2] :== -1.0;
	obj: MINIMIZE SUM[w[i]*(x[i] - 1.0)^2 | i IN [1..2]];
END lsq_negative_weight;

MODEL lsq_variable_weight;
	x[1..3] IS_A solver_var;
	obj: MINIMIZE x[1]*(x[2] - x[3])^2;
END lsq_variable_weight;

MODEL lsq_linear_extra_term;
	x[1..2] IS_A solver_var;
	obj: MINIMIZE (x[1] - 1.0)^2 + x[2];
END lsq_linear_extra_term;

MODEL lsq_cross_product;
	x[1..2] IS_A solver_var;
	obj: MINIMIZE x[1]*x[2];
END lsq_cross_product;

MODEL lsq_variable_projection;
	a, b, z IS_A solver_var;
	t[1..3], y[1..3] IS_A real_constant;
	t[1] :== 1.0;
	t[2] :== 2.0;
	t[3] :== 3.0;
	y[1] :== 2.0;
	y[2] :== 3.0;
	y[3] :== 4.0;
	obj: MINIMIZE SUM[(a*t[i]/(1.0 + z^2) + b - y[i])^2 | i IN [1..3]];
METHODS
METHOD on_load;
	a := 1.0;
	b := 0.0;
	z := 0.5;
END on_load;
END lsq_variable_projection;

MODEL lsq_not_objective;
	x IS_A solver_var;
	eq: x = 1.0;
END lsq_not_objective;
