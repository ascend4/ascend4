REQUIRE "ivpsystem.a4l";

MODEL der_decay;
	y IS_A solver_var;
	t IS_A solver_var;

	dyn: der(y) = -4 * y;
	INDEPENDENT t;

METHODS
	METHOD specify;
		FIX y;
		FREE der(y);
		FREE t;
	END specify;

	METHOD values;
		y := 1;
		t := 0;
	END values;

	METHOD on_load;
		RUN specify;
		RUN values;
	END on_load;
END der_decay;


MODEL der_shm;
	x IS_A solver_var;
	v IS_A solver_var;
	t IS_A solver_var;

	motion: der(x) - v = 0;
	force: der(v) = -x;
	INDEPENDENT t;

METHODS
	METHOD specify;
		FIX x, v;
		FREE der(x), der(v);
		FREE t;
	END specify;

	METHOD values;
		x := 10;
		v := 0;
		t := 0;
	END values;

	METHOD on_load;
		RUN specify;
		RUN values;
	END on_load;
END der_shm;


MODEL initial_decay;
	y IS_A solver_var;
	t IS_A solver_var;

	dyn: der(y) = -4 * y;
	INDEPENDENT t;
INITIAL
	y0: y = 1;

METHODS
	METHOD on_load;
		FIX t;
		t := 0;
		FREE der(y);
	END on_load;
END initial_decay;


MODEL initial_shm;
	x IS_A solver_var;
	v IS_A solver_var;
	t IS_A solver_var;

	motion: der(x) - v = 0;
	force: der(v) = -x;
	INDEPENDENT t;
INITIAL
	x0: x = 10;
	v0: v = 0;

METHODS
	METHOD on_load;
		FIX t;
		t := 0;
		FREE der(x), der(v);
	END on_load;
END initial_shm;


MODEL initial_child_decay;
	y IS_A solver_var;
	t IS_A solver_var;

	dyn: der(y) = -4 * y;
	INDEPENDENT t;
END initial_child_decay;


MODEL initial_hier_decay;
	c IS_A initial_child_decay;

INITIAL
	y0: c.y = 1;

METHODS
	METHOD on_load;
		FIX c.t;
		c.t := 0;
		FREE der(c.y);
	END on_load;
END initial_hier_decay;


MODEL initial_bad_overdetermined;
	y IS_A solver_var;
	t IS_A solver_var;

	dyn: der(y) = -4 * y;
	INDEPENDENT t;
INITIAL
	y0: y = 1;
	y1: y = 2;

METHODS
	METHOD on_load;
		FIX t;
		t := 0;
		FREE der(y);
	END on_load;
END initial_bad_overdetermined;
