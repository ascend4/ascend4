REQUIRE "system.a4l";
(* FOR instantiate tests *)

MODEL for_ok_int;
	FOR i IN [1..3] CREATE
		x[i] IS_A real;
	END FOR;
END for_ok_int;

MODEL for_ok_sym;
	s IS_A set OF symbol_constant;
	s :== ['a','b'];
	FOR i IN s CREATE
		y[i] IS_A real;
	END FOR;
END for_ok_sym;

MODEL for_fail_unindexed;
	(* FAIL: unindexed statement inside FOR *)
	FOR i IN [1..3] CREATE
		x IS_A real;
	END FOR;
END for_fail_unindexed;

MODEL for_fail_nonscalar_subscript;
	(* FAIL: non-scalar subscript inside FOR *)
	FOR i IN [1..2] CREATE
		x[1..2] IS_A real;
	END FOR;
END for_fail_nonscalar_subscript;

MODEL for_ok_empty_create;
	(* OK: empty ranges in declarative and FOR CREATE *)
	a[1..2] IS_A real;
	b[2..1] IS_A real;
	FOR i IN [1..2] CREATE
		c[i] IS_A real;
	END FOR;
	FOR i IN [2..1] CREATE
		d[i] IS_A real;
	END FOR;
END for_ok_empty_create;

MODEL for_ok_relation_empty;
	x IS_A generic_real;
	FOR i IN [1..2] CREATE
		ra3[i]: x = i;
	END FOR;
	FOR i IN [2..1] CREATE
		ra4[i]: x = i;
	END FOR;
END for_ok_relation_empty;

MODEL for_ok_indirect_sparse;
	n,m[1..n] IS_A integer_constant;
	m[2] :== 2;
	x IS_A generic_real;
	FOR i IN [1..3] CREATE
		p[m[i]] IS_A real;
		q[m[i]]: x = 1;
	END FOR;
	m[3] :== m[1] - 2;
	m[1] :== n;
	n :== 3;
END for_ok_indirect_sparse;
