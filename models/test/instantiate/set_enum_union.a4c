(* UNION/SET/ENUM-style instantiate tests *)

MODEL set_ok;
	(* OK: set type is integer_constant and values are integer *)
	s IS_A set OF integer_constant;
	s :== [1..3];
	i IS_A integer;
END set_ok;

MODEL set_fail_missing_type;
	(* FAIL: missing set element type *)
	s IS_A set;
END set_fail_missing_type;

MODEL set_fail_bad_type;
	(* FAIL: set element type must be integer_constant or symbol_constant *)
	s IS_A set OF real_constant;
END set_fail_bad_type;

MODEL enum_ok;
	(* OK: symbol_constant set with symbol values *)
	colors IS_A set OF symbol_constant;
	colors :== ['red','blue'];
	c IS_A symbol_constant;
	c :== 'red';
END enum_ok;

MODEL enum_fail_bad_value;
	(* FAIL: symbol_constant set given integer values *)
	colors IS_A set OF symbol_constant;
	colors :== [1..3];
END enum_fail_bad_value;

MODEL union_ok;
	(* OK: UNION of set-valued expression *)
	s[1..2] IS_A set OF integer_constant;
	s[1] :== [1,2];
	s[2] :== [2,3];
	u IS_A set OF integer_constant;
	u :== UNION[s[i] | i IN [1..2]];
END union_ok;

MODEL union_fail_nonset;
	(* FAIL: UNION producing mixed-type set *)
	u IS_A set OF integer_constant;
	u :== UNION[1,'a'];
END union_fail_nonset;
