(* Analytic tests for the electrical_power_1 example's generator helper:
   power/energy/cost units and initial state. The distinct basename avoids
   a collision with the example in ASCEND's REQUIRE module lookup. *)
REQUIRE "electrical_power_1.a4c";

MODEL uc_units_case;
    n0 IS_A integer_constant;
    dt[1..2] IS_A time_constant;
    dt[1] :== 30{min}; dt[2] :== 5400{s};
    g IS_A thermal_generator_group(2, dt, 2, n0,
        1000{kW}, 2000000{W}, 10{USD/h}, 5{USD/MWh}, 100{USD});
    first: g.P[1] = 3{MW};
    second: g.P[2] = 1000{kW};
    obj: MINIMIZE g.cost;
METHODS
METHOD self_test;
    RUN g.self_test;
    ASSERT abs(g.on[1] - 2) < 1e-7;
    ASSERT abs(g.on[2] - 1) < 1e-7;
    ASSERT abs(g.start[1] - (2 - n0)) < 1e-7;
    ASSERT abs(g.start[2]) < 1e-7;
    (* 3 MW * 0.5 h + 1 MW * 1.5 h = 3 MWh, including 0.5 MWh extra. *)
    ASSERT abs((g.E - 3{MWh})/1{J}) < 1;
    ASSERT abs((g.running - 27.5{USD})/1{USD}) < 1e-6;
    ASSERT abs((g.starting - (2 - n0)*100{USD})/1{USD}) < 1e-6;
    ASSERT abs((g.cost - (227.5{USD} - n0*100{USD}))/1{USD}) < 1e-6;
END self_test;
END uc_units_case;

MODEL uc_units REFINES uc_units_case;
    n0 :== 0;
END uc_units;
MODEL uc_initial REFINES uc_units_case;
    n0 :== 1;
END uc_initial;
