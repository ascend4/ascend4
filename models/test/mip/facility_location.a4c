REQUIRE "atoms.a4l";

(* Capacitated facility-location MIP benchmark.

   Narrative:
   We choose which candidate facilities to open (fixed-charge decision), then
   assign each customer to exactly one open facility, while respecting each
   facility's capacity. The objective combines fixed opening costs and
   demand-weighted shipping costs.

   Decision variables:
   - open[j] in {0,1}: facility-open decisions
   - assign[i][j] in {0,1}: single-sourcing assignment decisions

   Constraints:
   - each customer is assigned exactly once
   - assignment implies facility is open (assign <= open)
   - total assigned demand at each facility does not exceed capacity

   Source/model lineage:
   - Formulation style follows the standard capacitated facility location model
     described in the SCIP optimization book:
     https://scipbook.readthedocs.io/en/latest/flp.html
   - Widely used benchmark family for this model class (CAP instances):
     https://people.brunel.ac.uk/~mastjjb/jeb/orlib/capinfo.html

   Note:
   The specific numbers below are a compact, hand-sized test instance for
   deterministic regression in ASCEND/HiGHS tests (not a direct copy of one
   published CAP data file).

   Expected optimum for this instance:
   - objective = 470
   - open[1]=1, open[2]=0, open[3]=1
   - assignments: 1->1, 2->3, 3->3, 4->3
*)
MODEL mip_facility_location;
	demand[1..4] IS_A factor_constant;
	capacity[1..3] IS_A factor_constant;
	fixed_cost[1..3] IS_A factor_constant;
	ship_cost[1..4][1..3] IS_A factor_constant;

	open[1..3] IS_A solver_binary;
	assign[1..4][1..3] IS_A solver_binary;

	demand[1] :== 45;
	demand[2] :== 30;
	demand[3] :== 40;
	demand[4] :== 35;

	capacity[1] :== 80;
	capacity[2] :== 100;
	capacity[3] :== 120;

	fixed_cost[1] :== 120;
	fixed_cost[2] :== 100;
	fixed_cost[3] :== 90;

	ship_cost[1][1] :== 2;
	ship_cost[1][2] :== 4;
	ship_cost[1][3] :== 5;
	ship_cost[2][1] :== 3;
	ship_cost[2][2] :== 1;
	ship_cost[2][3] :== 2;
	ship_cost[3][1] :== 4;
	ship_cost[3][2] :== 2;
	ship_cost[3][3] :== 1;
	ship_cost[4][1] :== 5;
	ship_cost[4][2] :== 3;
	ship_cost[4][3] :== 2;

	FOR i IN [1..4] CREATE
		serve[i]: SUM[assign[i][j] | j IN [1..3]] = 1;
	END FOR;

	FOR i IN [1..4] CREATE
		FOR j IN [1..3] CREATE
			link[i][j]: assign[i][j] <= open[j];
		END FOR;
	END FOR;

	FOR j IN [1..3] CREATE
		cap[j]: SUM[demand[i]*assign[i][j] | i IN [1..4]] <= capacity[j];
	END FOR;

	obj: MINIMIZE
		SUM[fixed_cost[j]*open[j] | j IN [1..3]]
		+ SUM[ SUM[demand[i]*ship_cost[i][j]*assign[i][j] | j IN [1..3]] | i IN [1..4] ];

METHODS

METHOD self_test;
	ASSERT abs(open[1] - 1) < 1e-7;
	ASSERT abs(open[2]) < 1e-7;
	ASSERT abs(open[3] - 1) < 1e-7;

	ASSERT abs(assign[1][1] - 1) < 1e-7;
	ASSERT abs(assign[2][3] - 1) < 1e-7;
	ASSERT abs(assign[3][3] - 1) < 1e-7;
	ASSERT abs(assign[4][3] - 1) < 1e-7;

	FOR i IN [1..4] DO
		ASSERT abs(SUM[assign[i][j] | j IN [1..3]] - 1) < 1e-7;
	END FOR;

	ASSERT abs(
		SUM[fixed_cost[j]*open[j] | j IN [1..3]]
		+ SUM[ SUM[demand[i]*ship_cost[i][j]*assign[i][j] | j IN [1..3]] | i IN [1..4] ]
		- 470
	) < 1e-7;
END self_test;

METHOD default_self;
	open[1] := 1;
	open[2] := 1;
	open[3] := 0;

	assign[1][1] := 1; assign[1][2] := 0; assign[1][3] := 0;
	assign[2][1] := 0; assign[2][2] := 1; assign[2][3] := 0;
	assign[3][1] := 0; assign[3][2] := 1; assign[3][3] := 0;
	assign[4][1] := 1; assign[4][2] := 0; assign[4][3] := 0;
END default_self;

METHOD on_load;
	RUN default_self;
END on_load;

END mip_facility_location;
