REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL rosenmmx;
	x1, x2, x3, x4, u IS_A solver_var;

	NOTES
		'description' SELF {
			Rosen's nonlinear minmax problem in four variables, written
			in smooth epigraph form.
			SIF equivalent:
			    minimize u
			    subject to
			        x1^2 + x2^2 + 2*x3^2 + x4^2
			            - 5*x1 - 5*x2 - 21*x3 + 7*x4 <= u
			        11*x1^2 + 11*x2^2 + 12*x3^2 + 11*x4^2
			            + 5*x1 - 15*x2 - 11*x3 - 3*x4 - 80 <= u
			        11*x1^2 + 21*x2^2 + 12*x3^2 + 21*x4^2
			            - 15*x1 - 5*x2 - 21*x3 - 3*x4 - 100 <= u
			        11*x1^2 + 11*x2^2 + 12*x3^2 + x4^2
			            + 15*x1 - 15*x2 - 21*x3 - 3*x4 - 50 <= u
			Known optimum objective:
			    u = -44
		}
		'source' SELF {
			M.M. Makela, "Nonsmooth optimization", Ph.D. thesis,
			Jyvaskyla University, 1990.
			SIF input by Ph. Toint, November 1993.
		}
		'problem_origin' SELF {
			This is a synthetic convex minmax benchmark rather than a
			model of a physical system. The auxiliary variable u gives a
			smooth epigraph reformulation of the max of four quadratics.
		}
	END NOTES;

	f1: u >= x1^2 + x2^2 + 2.0*x3^2 + x4^2
		- 5.0*x1 - 5.0*x2 - 21.0*x3 + 7.0*x4;

	f2: u >= 11.0*x1^2 + 11.0*x2^2 + 12.0*x3^2 + 11.0*x4^2
		+ 5.0*x1 - 15.0*x2 - 11.0*x3 - 3.0*x4 - 80.0;

	f3: u >= 11.0*x1^2 + 21.0*x2^2 + 12.0*x3^2 + 21.0*x4^2
		- 15.0*x1 - 5.0*x2 - 21.0*x3 - 3.0*x4 - 100.0;

	f4: u >= 11.0*x1^2 + 11.0*x2^2 + 12.0*x3^2 + x4^2
		+ 15.0*x1 - 15.0*x2 - 21.0*x3 - 3.0*x4 - 50.0;

	obj: MINIMIZE u;

METHODS
METHOD self_test;
	ASSERT abs(u + 44.0) < 1e-5;
	ASSERT x1^2 + x2^2 + 2.0*x3^2 + x4^2
		- 5.0*x1 - 5.0*x2 - 21.0*x3 + 7.0*x4 <= u + 5e-7;
	ASSERT 11.0*x1^2 + 11.0*x2^2 + 12.0*x3^2 + 11.0*x4^2
		+ 5.0*x1 - 15.0*x2 - 11.0*x3 - 3.0*x4 - 80.0 <= u + 5e-7;
	ASSERT 11.0*x1^2 + 21.0*x2^2 + 12.0*x3^2 + 21.0*x4^2
		- 15.0*x1 - 5.0*x2 - 21.0*x3 - 3.0*x4 - 100.0 <= u + 5e-7;
	ASSERT 11.0*x1^2 + 11.0*x2^2 + 12.0*x3^2 + x4^2
		+ 15.0*x1 - 15.0*x2 - 21.0*x3 - 3.0*x4 - 50.0 <= u + 5e-7;
END self_test;

METHOD use_ipopt;
	SOLVER IPOPT;
END use_ipopt;

METHOD use_a4sqp;
	SOLVER A4SQP;
END use_a4sqp;

METHOD on_load;
	x1 := 0.0;
	x2 := 0.0;
	x3 := 0.0;
	x4 := 0.0;
	u := 0.0;
	SOLVER A4SQP;
	OPTION max_iter 200;
END on_load;

METHOD on_load_test;
	x1 := 0.0;
	x2 := 0.0;
	x3 := 0.0;
	x4 := 0.0;
	u := 0.0;
END on_load_test;
END rosenmmx;
