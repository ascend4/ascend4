REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL dgospec;
	x1, x2, x3 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst DGOSPEC.
			Known CUTEst/IPOPTC local solution from the current tracking run:
			    x1 = -0.94252895
			    x2 = 0.5
			    x3 = -1.0
			    f  = -996.959210992209
		}
		'source' SELF {
			Example from the specification document for GALAHAD's DGO.
			SIF input by Nick Gould, August 2021.
		}
		'problem_origin' SELF {
			This small bounded unconstrained benchmark was added because
			it exposed exact-Hessian PSD regularization dominating the
			step model; it is now a regression for exact-Hessian fallback.
		}
	END NOTES;

	obj: MINIMIZE
		(x1 + x3 + 4.0)^2
		+ (x2 + x3)^2
		+ 1000.0*cos(10.0*x1*1{rad})
		+ x1 + x2 + x3;

METHODS
METHOD self_test;
	ASSERT abs(x1 + 0.94252895) < 5e-5;
	ASSERT abs(x2 - 0.5) < 5e-7;
	ASSERT abs(x3 + 1.0) < 5e-7;
	ASSERT abs(
		(x1 + x3 + 4.0)^2
		+ (x2 + x3)^2
		+ 1000.0*cos(10.0*x1*1{rad})
		+ x1 + x2 + x3
		+ 996.959210992209
	) < 5e-6;
END self_test;

METHOD on_load;
	x1 := 0.0;
	x2 := 0.0;
	x3 := 0.0;
	x1.lower_bound := -1.0;
	x2.lower_bound := -1.0;
	x3.lower_bound := -1.0;
	x1.upper_bound := 0.5;
	x2.upper_bound := 0.5;
	x3.upper_bound := 0.5;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'EXACT_OBJ';
END on_load;

METHOD on_load_test;
	x1 := 0.0;
	x2 := 0.0;
	x3 := 0.0;
	x1.lower_bound := -1.0;
	x2.lower_bound := -1.0;
	x3.lower_bound := -1.0;
	x1.upper_bound := 0.5;
	x2.upper_bound := 0.5;
	x3.upper_bound := 0.5;
END on_load_test;
END dgospec;
