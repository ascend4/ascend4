REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL brownbs;
	x1, x2 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst BROWNBS / Brown badly-scaled
			problem.
			Known solution:
			    x1 = 1e6
			    x2 = 2e-6
			    f  = 0
		}
		'source' SELF {
			J. J. More, B. S. Garbow and K. E. Hillstrom, "Testing
			Unconstrained Optimization Software", ACM Transactions on
			Mathematical Software 7(1), 1981. SIF input by Ph. L. Toint,
			December 1989.
		}
		'problem_origin' SELF {
			This is a synthetic badly-scaled unconstrained least-squares
			benchmark. A4SQP currently fails the corresponding CUTEst
			problem at the first QP/step, so this model is intended as a
			focused regression for initial step scaling and unconstrained
			QP robustness.
		}
	END NOTES;

	obj: MINIMIZE (x1 - 1e6)^2 + (x2 - 2e-6)^2 + (x1*x2 - 2.0)^2;

METHODS
METHOD self_test;
	ASSERT abs((x1 - 1e6)/1e6) < 1e-7;
	ASSERT abs(x2 - 2e-6) < 1e-12;
	ASSERT abs((x1 - 1e6)^2 + (x2 - 2e-6)^2 + (x1*x2 - 2.0)^2) < 1e-8;
END self_test;

METHOD on_load;
	x1 := 1.0;
	x2 := 1.0;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION trust_unconstrained TRUE;
	OPTION trust_radius_max 1e8;
	OPTION hessian 'EXACT_OBJ';
END on_load;

METHOD on_load_test;
	x1 := 1.0;
	x2 := 1.0;
END on_load_test;
END brownbs;
