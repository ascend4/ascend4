REQUIRE "system.a4l";
IMPORT "a4sqp";

MODEL degenlpb;
	x[1..20] IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst DEGENLPB.
			Known CUTEst/IPOPTC objective:
			    f = -30.7312459693136
		}
		'source' SELF {
			T. C. T. Kotiah and D. I. Steinberg, "Occurences of cycling
			and other phenomena arising in a class of linear programming
			models", Communications of the ACM 20, pp. 107-112, 1977.
			SIF input by Ph. Toint, August 1990.
		}
		'problem_origin' SELF {
			This degenerate linear program currently reaches feasibility in
			A4SQP but stalls on KKT stationarity. It is a focused regression
			for active-bound multiplier recovery in linear programs.
		}
	END NOTES;

	(* Direct sparse rows preserve the CUTEst incidence pattern until ASCEND
	   can prune constant-zero SUM terms during relation analysis. *)
	con01: x[1] + 2*x[2] + 2*x[3] + 2*x[4] + x[5] + 2*x[6] + 2*x[7] + x[8] + 2*x[9] + x[10] = 0.70785;
	con02: -x[1] + 300*x[2] + 0.09*x[3] + 0.03*x[4] = 0;
	con03: 0.326*x[1] - 101*x[2] + 200*x[5] + 0.06*x[6] + 0.02*x[7] = 0;
	con04: 0.0066667*x[1] - 1.03*x[3] + 200*x[6] + 0.06*x[8] + 0.02*x[9] = 0;
	con05: 0.00066667*x[1] - 1.01*x[4] + 200*x[7] + 0.06*x[9] + 0.02*x[10] = 0;
	con06: 0.978*x[2] - 201*x[5] + 100*x[11] + 0.03*x[12] + 0.01*x[13] = 0;
	con07: 0.01*x[2] + 0.489*x[3] - 101.03*x[6] + 100*x[12] + 0.03*x[14] + 0.01*x[15] = 0;
	con08: 0.001*x[2] + 0.489*x[4] - 101.03*x[7] + 100*x[13] + 0.03*x[15] + 0.01*x[16] = 0;
	con09: 0.001*x[3] + 0.01*x[4] - 1.04*x[9] + 100*x[15] + 0.03*x[18] + 0.01*x[19] = 0;
	con10: 0.02*x[3] - 1.06*x[8] + 100*x[14] + 0.03*x[17] + 0.01*x[19] = 0;
	con11: 0.002*x[4] - 1.02*x[10] + 100*x[16] + 0.03*x[19] + 0.01*x[20] = 0;
	con12: -2.5742e-6*x[11] + 0.00252*x[13] - 0.61975*x[16] + 1.03*x[20] = 0;
	con13: -0.00257*x[11] + 0.25221*x[12] - 6.2*x[14] + 1.09*x[17] = 0;
	con14: 0.00629*x[11] - 0.20555*x[12] - 4.1106*x[13] + 101.04*x[15] + 505.1*x[16] - 256.72*x[19] = 0;
	con15: 0.00841*x[12] - 0.08406*x[13] - 0.20667*x[14] + 20.658*x[16] + 1.07*x[18] - 10.5*x[19] = 0;

	obj: MINIMIZE -0.01*x[2] - 33.333*x[3] - 100*x[4] - 0.01*x[5] - 33.343*x[6] - 100.01*x[7] - 33.333*x[8] - 133.33*x[9] - 100*x[10];

METHODS
METHOD self_test;
	ASSERT abs(-0.01*x[2] - 33.333*x[3] - 100*x[4] - 0.01*x[5] - 33.343*x[6] - 100.01*x[7] - 33.333*x[8] - 133.33*x[9] - 100*x[10] + 30.7312459693136) < 1e-6;
	ASSERT SATISFIED(con01,1e-8);
	ASSERT SATISFIED(con02,1e-8);
	ASSERT SATISFIED(con03,1e-8);
	ASSERT SATISFIED(con04,1e-8);
	ASSERT SATISFIED(con05,1e-8);
	ASSERT SATISFIED(con06,1e-8);
	ASSERT SATISFIED(con07,1e-8);
	ASSERT SATISFIED(con08,1e-8);
	ASSERT SATISFIED(con09,1e-8);
	ASSERT SATISFIED(con10,1e-8);
	ASSERT SATISFIED(con11,1e-8);
	ASSERT SATISFIED(con12,1e-8);
	ASSERT SATISFIED(con13,1e-8);
	ASSERT SATISFIED(con14,1e-8);
	ASSERT SATISFIED(con15,1e-8);
END self_test;

METHOD on_load;
	FOR i IN [1..20] DO
		x[i] := 1.0;
		x[i].lower_bound := 0.0;
		x[i].upper_bound := 1.0;
	END FOR;
	SOLVER A4SQP;
	OPTION max_iter 200;
	OPTION step_tol 1e-7;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION elastic_penalty_growth 10.0;
	OPTION hessian 'BFGS';
	OPTION scaleopt 'NONE';
END on_load;

METHOD on_load_test;
	FOR i IN [1..20] DO
		x[i] := 1.0;
		x[i].lower_bound := 0.0;
		x[i].upper_bound := 1.0;
	END FOR;
END on_load_test;
END degenlpb;
