REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL bt10;
	x1, x2 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst BT10 / Boggs-Tolle problem 10.
			Known solution:
			    x1 = 1
			    x2 = 1
			    f  = -1
		}
		'source' SELF {
			P. T. Boggs and J. W. Tolle, "A strategy for global convergence
			in a sequential quadratic programming algorithm", SIAM Journal on
			Numerical Analysis 26(3), 1989. SIF input by Ph. L. Toint,
			June 1993.
		}
		'problem_origin' SELF {
			This is a synthetic nonconvex equality-constrained NLP.
			A4SQP solved the corresponding CUTEst problem as a strict
			success in the broader NLP smoke run, so this model is intended
			as a compact regression for coupled nonlinear equality handling.
		}
	END NOTES;

	con1: x2 - x1^3 = 0;
	con2: -x2 + x1^2 = 0;
	obj: MINIMIZE -x1;

METHODS
METHOD self_test;
	ASSERT abs(x1 - 1.0) < 2e-5;
	ASSERT abs(x2 - 1.0) < 2e-5;
	ASSERT abs((-x1) - (-1.0)) < 2e-5;
	ASSERT abs(x2 - x1^3) < 1e-7;
	ASSERT abs(-x2 + x1^2) < 1e-7;
END self_test;

METHOD on_load;
	x1 := 2.0;
	x2 := 2.0;
	SOLVER A4SQP;
	OPTION max_iter 100;
END on_load;

METHOD on_load_test;
	x1 := 2.0;
	x2 := 2.0;
END on_load_test;
END bt10;
