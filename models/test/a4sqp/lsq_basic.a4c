REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL lsq_basic;
	x[1..3] IS_A solver_var;
	y[1..3] IS_A real_constant;

	NOTES
		'description' SELF {
			Small unconstrained least-squares regression for A4SQP try_lsq.
		}
	END NOTES;

	y[1] :== 1.0;
	y[2] :== 2.0;
	y[3] :== 3.0;

	obj: MINIMIZE SUM[(x[i] - y[i])^2 | i IN [1..3]];

METHODS
METHOD self_test;
	ASSERT abs(x[1] - y[1]) < 1e-7;
	ASSERT abs(x[2] - y[2]) < 1e-7;
	ASSERT abs(x[3] - y[3]) < 1e-7;
	ASSERT abs(SUM[(x[i] - y[i])^2 | i IN [1..3]]) < 1e-12;
END self_test;

METHOD on_load;
	x[1] := 2.0;
	x[2] := 4.0;
	x[3] := 6.0;
	SOLVER A4SQP;
	OPTION try_lsq 'GAUSS';
	OPTION max_iter 20;
END on_load;
END lsq_basic;
