REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL cantilvr;
	x1, x2, x3, x4, x5 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst CANTILVR.
			Known CUTEst/IPOPTC solution:
			    x1 = 6.016015894
			    x2 = 5.309173857
			    x3 = 4.494329573
			    x4 = 3.501474970
			    x5 = 2.152665330
			    f  = 1.3399563606
		}
		'source' SELF {
			Minimum weight cantilever example from a talk by W.K. Zhang
			and C. Fleury, LLN, 1994. SIF input by Ph. Toint, November
			1994; correction by S. Gratton and Ph. Toint, May 2024.
		}
			'problem_origin' SELF {
				This small bound-constrained engineering benchmark currently
				tracks A4SQP row-scaling/globalization sensitivity seen in the
				CUTEst driver.
			}
	END NOTES;

	stress:
		61.0/x1^3 + 37.0/x2^3 + 19.0/x3^3 + 7.0/x4^3 + 1.0/x5^3 <= 1.0;

	obj: MINIMIZE 0.0624*(x1 + x2 + x3 + x4 + x5);

METHODS
METHOD bound_self;
	x1.lower_bound := 1e-6;
	x2.lower_bound := 1e-6;
	x3.lower_bound := 1e-6;
	x4.lower_bound := 1e-6;
	x5.lower_bound := 1e-6;
END bound_self;

METHOD default_self;
	x1 := 1.0;
	x2 := 1.0;
	x3 := 1.0;
	x4 := 1.0;
	x5 := 1.0;
END default_self;

METHOD self_test;
	ASSERT abs(x1 - 6.016015894) < 5e-5;
	ASSERT abs(x2 - 5.309173857) < 5e-5;
	ASSERT abs(x3 - 4.494329573) < 5e-5;
	ASSERT abs(x4 - 3.501474970) < 5e-5;
	ASSERT abs(x5 - 2.152665330) < 5e-5;
	ASSERT abs(0.0624*(x1 + x2 + x3 + x4 + x5) - 1.3399563606) < 1e-6;
	ASSERT abs(61.0/x1^3 + 37.0/x2^3 + 19.0/x3^3 + 7.0/x4^3 + 1.0/x5^3 - 1.0) < 5e-5;
END self_test;

METHOD on_load;
	RUN bound_self;
	RUN default_self;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'EXACT_LAGRANGIAN';
	OPTION restoration TRUE;
	OPTION scaleopt 'ROW_2NORM';
END on_load;

METHOD on_load_test;
	RUN bound_self;
	RUN default_self;
END on_load_test;
END cantilvr;
