REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL brownden;
	x1, x2, x3, x4 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst BROWNDEN.
			Known CUTEst/IPOPTC local solution from the current tracking run:
			    x1 = -11.59444
			    x2 = 13.20363
			    x3 = -0.403439
			    x4 = 0.236778
			    f  = 85822.2016246898
		}
		'source' SELF {
			Problem 16 in J. J. More, B. S. Garbow and K. E. Hillstrom,
			"Testing Unconstrained Optimization Software", ACM Transactions
			on Mathematical Software 7(1), 1981. SIF input by Ph. L. Toint,
			December 1989.
		}
		'problem_origin' SELF {
			This Brown-Dennis least-squares benchmark was added because
			it exposed exact-Hessian line-search failure where restarting
			with the BFGS Hessian model reaches the known local minimum.
		}
	END NOTES;

	obj: MINIMIZE
		((x1 + 0.2*x2 - exp(0.2))^2 + (x3 + 0.198669330795061*x4 - 0.980066577841242)^2)^2
		+ ((x1 + 0.4*x2 - exp(0.4))^2 + (x3 + 0.389418342308651*x4 - 0.921060994002885)^2)^2
		+ ((x1 + 0.6*x2 - exp(0.6))^2 + (x3 + 0.564642473395035*x4 - 0.825335614909678)^2)^2
		+ ((x1 + 0.8*x2 - exp(0.8))^2 + (x3 + 0.717356090899523*x4 - 0.696706709347165)^2)^2
		+ ((x1 + 1.0*x2 - exp(1.0))^2 + (x3 + 0.841470984807897*x4 - 0.540302305868140)^2)^2
		+ ((x1 + 1.2*x2 - exp(1.2))^2 + (x3 + 0.932039085967226*x4 - 0.362357754476674)^2)^2
		+ ((x1 + 1.4*x2 - exp(1.4))^2 + (x3 + 0.985449729988460*x4 - 0.169967142900241)^2)^2
		+ ((x1 + 1.6*x2 - exp(1.6))^2 + (x3 + 0.999573603041505*x4 + 0.029199522301289)^2)^2
		+ ((x1 + 1.8*x2 - exp(1.8))^2 + (x3 + 0.973847630878195*x4 + 0.227202094693087)^2)^2
		+ ((x1 + 2.0*x2 - exp(2.0))^2 + (x3 + 0.909297426825682*x4 + 0.416146836547142)^2)^2
		+ ((x1 + 2.2*x2 - exp(2.2))^2 + (x3 + 0.808496403819590*x4 + 0.588501117255346)^2)^2
		+ ((x1 + 2.4*x2 - exp(2.4))^2 + (x3 + 0.675463180551151*x4 + 0.737393715541245)^2)^2
		+ ((x1 + 2.6*x2 - exp(2.6))^2 + (x3 + 0.515501371821464*x4 + 0.856888753368947)^2)^2
		+ ((x1 + 2.8*x2 - exp(2.8))^2 + (x3 + 0.334988150155905*x4 + 0.942222340668658)^2)^2
		+ ((x1 + 3.0*x2 - exp(3.0))^2 + (x3 + 0.141120008059867*x4 + 0.989992496600445)^2)^2
		+ ((x1 + 3.2*x2 - exp(3.2))^2 + (x3 - 0.058374143427580*x4 + 0.998294775794753)^2)^2
		+ ((x1 + 3.4*x2 - exp(3.4))^2 + (x3 - 0.255541102026831*x4 + 0.966798192579461)^2)^2
		+ ((x1 + 3.6*x2 - exp(3.6))^2 + (x3 - 0.442520443294852*x4 + 0.896758416334147)^2)^2
		+ ((x1 + 3.8*x2 - exp(3.8))^2 + (x3 - 0.611857890942719*x4 + 0.790967711914417)^2)^2
		+ ((x1 + 4.0*x2 - exp(4.0))^2 + (x3 - 0.756802495307928*x4 + 0.653643620863612)^2)^2;

METHODS
METHOD self_test;
	ASSERT abs(x1 + 11.59444) < 5e-4;
	ASSERT abs(x2 - 13.20363) < 5e-4;
	ASSERT abs(x3 + 0.403439) < 5e-5;
	ASSERT abs(x4 - 0.236778) < 5e-5;
	ASSERT abs(
		((x1 + 0.2*x2 - exp(0.2))^2 + (x3 + 0.198669330795061*x4 - 0.980066577841242)^2)^2
		+ ((x1 + 0.4*x2 - exp(0.4))^2 + (x3 + 0.389418342308651*x4 - 0.921060994002885)^2)^2
		+ ((x1 + 0.6*x2 - exp(0.6))^2 + (x3 + 0.564642473395035*x4 - 0.825335614909678)^2)^2
		+ ((x1 + 0.8*x2 - exp(0.8))^2 + (x3 + 0.717356090899523*x4 - 0.696706709347165)^2)^2
		+ ((x1 + 1.0*x2 - exp(1.0))^2 + (x3 + 0.841470984807897*x4 - 0.540302305868140)^2)^2
		+ ((x1 + 1.2*x2 - exp(1.2))^2 + (x3 + 0.932039085967226*x4 - 0.362357754476674)^2)^2
		+ ((x1 + 1.4*x2 - exp(1.4))^2 + (x3 + 0.985449729988460*x4 - 0.169967142900241)^2)^2
		+ ((x1 + 1.6*x2 - exp(1.6))^2 + (x3 + 0.999573603041505*x4 + 0.029199522301289)^2)^2
		+ ((x1 + 1.8*x2 - exp(1.8))^2 + (x3 + 0.973847630878195*x4 + 0.227202094693087)^2)^2
		+ ((x1 + 2.0*x2 - exp(2.0))^2 + (x3 + 0.909297426825682*x4 + 0.416146836547142)^2)^2
		+ ((x1 + 2.2*x2 - exp(2.2))^2 + (x3 + 0.808496403819590*x4 + 0.588501117255346)^2)^2
		+ ((x1 + 2.4*x2 - exp(2.4))^2 + (x3 + 0.675463180551151*x4 + 0.737393715541245)^2)^2
		+ ((x1 + 2.6*x2 - exp(2.6))^2 + (x3 + 0.515501371821464*x4 + 0.856888753368947)^2)^2
		+ ((x1 + 2.8*x2 - exp(2.8))^2 + (x3 + 0.334988150155905*x4 + 0.942222340668658)^2)^2
		+ ((x1 + 3.0*x2 - exp(3.0))^2 + (x3 + 0.141120008059867*x4 + 0.989992496600445)^2)^2
		+ ((x1 + 3.2*x2 - exp(3.2))^2 + (x3 - 0.058374143427580*x4 + 0.998294775794753)^2)^2
		+ ((x1 + 3.4*x2 - exp(3.4))^2 + (x3 - 0.255541102026831*x4 + 0.966798192579461)^2)^2
		+ ((x1 + 3.6*x2 - exp(3.6))^2 + (x3 - 0.442520443294852*x4 + 0.896758416334147)^2)^2
		+ ((x1 + 3.8*x2 - exp(3.8))^2 + (x3 - 0.611857890942719*x4 + 0.790967711914417)^2)^2
		+ ((x1 + 4.0*x2 - exp(4.0))^2 + (x3 - 0.756802495307928*x4 + 0.653643620863612)^2)^2
		- 85822.2016246898
	) < 5e-3;
END self_test;

METHOD on_load;
	x1 := 25.0;
	x2 := 5.0;
	x3 := -5.0;
	x4 := -1.0;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'EXACT_OBJ';
END on_load;

METHOD on_load_test;
	x1 := 25.0;
	x2 := 5.0;
	x3 := -5.0;
	x4 := -1.0;
END on_load_test;
END brownden;
