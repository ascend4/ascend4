REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL hs21;
	x1, x2 IS_A solver_var;

	NOTES
		'description' SELF {
			Hock-Schittkowski problem 21.
			SIF equivalent:
			    minimize 0.01*x1^2 + x2^2 - 100
			    subject to 10*x1 - x2 - 10 >= 0
			    with 2 <= x1 <= 50 and -50 <= x2 <= 50
			Known solution:
			    x1 = 2
			    x2 = 0
			    f  = -99.96
		}
	END NOTES;

	con1: 10*x1 - x2 - 10 >= 0;
	obj: MINIMIZE 0.01*x1^2 + x2^2 - 100;

METHODS
METHOD self_test;
	ASSERT abs(x1 - 2.0) < 1e-7;
	ASSERT abs(x2) < 1.5e-3;
	ASSERT abs((0.01*x1^2 + x2^2 - 100) - (-99.96)) < 2e-6;
	ASSERT 10*x1 - x2 - 10 > -1e-8;
END self_test;

METHOD on_load;
	x1.lower_bound := 2.0;
	x1.upper_bound := 50.0;
	x2.lower_bound := -50.0;
	x2.upper_bound := 50.0;
	x1 := -1.0;
	x2 := -1.0;
	SOLVER A4SQP;
END on_load;

METHOD on_load_test;
	x1.lower_bound := 2.0;
	x1.upper_bound := 50.0;
	x2.lower_bound := -50.0;
	x2.upper_bound := 50.0;
	x1 := -1.0;
	x2 := -1.0;
END on_load_test;
END hs21;
