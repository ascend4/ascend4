METHOD self_test;
	ASSERT SATISFIED(RP1,1e-5);
	ASSERT SATISFIED(IP1,1e-5);
END self_test;

METHOD on_load;
	RUN bound_self;
	RUN scale_self;
	RUN default_self;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'BFGS';
	OPTION restoration TRUE;
	OPTION scaleopt 'ROW_2NORM';
END on_load;

METHOD on_load_test;
	RUN bound_self;
	RUN scale_self;
	RUN default_self;
END on_load_test;
END acopp14;
