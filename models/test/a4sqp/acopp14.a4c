	IP9:
		-1.855499557*(M9/1{kV})*(M4/1{kV})*cos((A9 - A4))
		- 9.090082719*(M9/1{kV})*(M7/1{kV})*cos((A9 - A7))
		+ 24.092506375*(M9/1{kV})^2
		- 3.902049552*(M9/1{kV})*(M10/1{kV})*sin((A9 - A10))
