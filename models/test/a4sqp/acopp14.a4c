		- 3.029050456*(M9/1{kV})*(M14/1{kV})*cos((A9 - A14)) = -0.166;

	IP10:
		-3.902049552*(M10/1{kV})*(M9/1{kV})*sin((A10 - A9))
		- 10.36539412*(M10/1{kV})*(M9/1{kV})*cos((A10 - A9))
