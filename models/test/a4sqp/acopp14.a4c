METHOD on_load;
	RUN bound_self;
	RUN default_self;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'BFGS';
	OPTION restoration TRUE;
	OPTION scaleopt 'NONE';
END on_load;

METHOD on_load_test;
	RUN bound_self;
	RUN default_self;
END on_load_test;
