REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL acopp14;
	A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14 IS_A solver_var;
	M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14 IS_A solver_var;
	P1, P2, P3, P4, P5 IS_A solver_var;
	Q1, Q2, Q3, Q4, Q5 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst ACOPP14 from the SIF element/group form.
			This OPF case is included as a current A4SQP benchmark target.
		}
		'source' SELF {
			IEEE 14-bus AC optimal power-flow formulation from ACOPP14.SIF;
			polar formulation by Anya Castillo, SIF input by Nick Gould, August 2011.
		}
	END NOTES;

	obj: MINIMIZE
		2000*P1
		+ 2000*P2
		+ 4000*P3
		+ 4000*P4
		+ 4000*P5
		+ 860.586*P1^2
		+ 5000*P2^2
		+ 200*P3^2
		+ 200*P4^2
		+ 200*P5^2;

	RP1:
		-P1
		+ 6.0250290558*M1^2
		- 4.9991316*M1*M2*cos((A1 - A2)*1{rad})
		+ 15.263086523*M1*M2*sin((A1 - A2)*1{rad})
		- 1.025897455*M1*M5*cos((A1 - A5)*1{rad})
		+ 4.2349836823*M1*M5*sin((A1 - A5)*1{rad}) = 0.0;

	RP2:
		-P2
		- 4.9991316*M2*M1*cos((A2 - A1)*1{rad})
