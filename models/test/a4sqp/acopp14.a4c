REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

UNITS
	MVAr = {MW};
END UNITS;

MODEL acopp14;
	A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14 IS_A angle;
	M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14 IS_A voltage;
	P1, P2, P3, P4, P5 IS_A energy_rate;
	Q1, Q2, Q3, Q4, Q5 IS_A energy_rate;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst ACOPP14 from the SIF element/group form.
			This OPF case is included as a current A4SQP benchmark target.
		}
		'source' SELF {
			IEEE 14-bus AC optimal power-flow formulation from ACOPP14.SIF;
			polar formulation by Anya Castillo, SIF input by Nick Gould, August 2011.
		}
		'units' SELF {
			The SIF variables are per-unit/scaled. This model gives the optimisation
			variables physical ASCEND dimensions while preserving the original SIF
			algebra by normalising voltage magnitudes by 1 kV, active powers by
			1 MW, reactive powers by 1 MVAr, and using angles directly in radians.
		}
	END NOTES;

	obj: MINIMIZE
		2000*(P1/1{MW})
		+ 2000*(P2/1{MW})
		+ 4000*(P3/1{MW})
		+ 4000*(P4/1{MW})
		+ 4000*(P5/1{MW})
		+ 860.586*(P1/1{MW})^2
		+ 5000*(P2/1{MW})^2
		+ 200*(P3/1{MW})^2
		+ 200*(P4/1{MW})^2
		+ 200*(P5/1{MW})^2;

	RP1:
		-(P1/1{MW})
		+ 6.0250290558*(M1/1{kV})^2
		- 4.9991316*(M1/1{kV})*(M2/1{kV})*cos((A1 - A2))
		+ 15.263086523*(M1/1{kV})*(M2/1{kV})*sin((A1 - A2))
		- 1.025897455*(M1/1{kV})*(M5/1{kV})*cos((A1 - A5))
		+ 4.2349836823*(M1/1{kV})*(M5/1{kV})*sin((A1 - A5)) = 0.0;

	RP2:
		-(P2/1{MW})
		- 4.9991316*(M2/1{kV})*(M1/1{kV})*cos((A2 - A1))
		+ 15.263086523*(M2/1{kV})*(M1/1{kV})*sin((A2 - A1))
		+ 9.5213236108*(M2/1{kV})^2
		- 1.135019192*(M2/1{kV})*(M3/1{kV})*cos((A2 - A3))
		+ 4.7818631518*(M2/1{kV})*(M3/1{kV})*sin((A2 - A3))
		- 1.68603315*(M2/1{kV})*(M4/1{kV})*cos((A2 - A4))
		+ 5.1158383259*(M2/1{kV})*(M4/1{kV})*sin((A2 - A4))
		- 1.701139667*(M2/1{kV})*(M5/1{kV})*cos((A2 - A5))
		+ 5.193927398*(M2/1{kV})*(M5/1{kV})*sin((A2 - A5)) = -0.217;

	RP3:
		-(P3/1{MW})
		- 1.135019192*(M3/1{kV})*(M2/1{kV})*cos((A3 - A2))
		+ 4.7818631518*(M3/1{kV})*(M2/1{kV})*sin((A3 - A2))
		+ 3.1209949022*(M3/1{kV})^2
		- 1.985975709*(M3/1{kV})*(M4/1{kV})*cos((A3 - A4))
		+ 5.0688169776*(M3/1{kV})*(M4/1{kV})*sin((A3 - A4)) = -0.942;

	RP4:
		-1.68603315*(M4/1{kV})*(M2/1{kV})*cos((A4 - A2))
		+ 5.1158383259*(M4/1{kV})*(M2/1{kV})*sin((A4 - A2))
		- 1.985975709*(M4/1{kV})*(M3/1{kV})*cos((A4 - A3))
		+ 5.0688169776*(M4/1{kV})*(M3/1{kV})*sin((A4 - A3))
		+ 10.512989522*(M4/1{kV})^2
		- 6.840980661*(M4/1{kV})*(M5/1{kV})*cos((A4 - A5))
		+ 21.578553982*(M4/1{kV})*(M5/1{kV})*sin((A4 - A5))
		+ 4.8895126603*(M4/1{kV})*(M7/1{kV})*sin((A4 - A7))
		+ 1.8554995578*(M4/1{kV})*(M9/1{kV})*sin((A4 - A9)) = -0.478;

	RP5:
		-1.025897455*(M5/1{kV})*(M1/1{kV})*cos((A5 - A1))
		+ 4.2349836823*(M5/1{kV})*(M1/1{kV})*sin((A5 - A1))
		- 1.701139667*(M5/1{kV})*(M2/1{kV})*cos((A5 - A2))
		+ 5.193927398*(M5/1{kV})*(M2/1{kV})*sin((A5 - A2))
		- 6.840980661*(M5/1{kV})*(M4/1{kV})*cos((A5 - A4))
		+ 21.578553982*(M5/1{kV})*(M4/1{kV})*sin((A5 - A4))
		+ 9.5680177836*(M5/1{kV})^2
		+ 4.2574453353*(M5/1{kV})*(M6/1{kV})*sin((A5 - A6)) = -0.076;

	RP6:
		-(P4/1{MW})
		+ 4.2574453353*(M6/1{kV})*(M5/1{kV})*sin((A6 - A5))
		+ 6.5799234075*(M6/1{kV})^2
		- 1.955028563*(M6/1{kV})*(M11/1{kV})*cos((A6 - A11))
		+ 4.0940743442*(M6/1{kV})*(M11/1{kV})*sin((A6 - A11))
		- 1.52596744*(M6/1{kV})*(M12/1{kV})*cos((A6 - A12))
		+ 3.175963965*(M6/1{kV})*(M12/1{kV})*sin((A6 - A12))
		- 3.098927403*(M6/1{kV})*(M13/1{kV})*cos((A6 - A13))
		+ 6.1027554482*(M6/1{kV})*(M13/1{kV})*sin((A6 - A13)) = -0.112;

	RP7:
		4.8895126603*(M7/1{kV})*(M4/1{kV})*sin((A7 - A4))
		+ 5.6769798467*(M7/1{kV})*(M8/1{kV})*sin((A7 - A8))
		+ 9.0900827198*(M7/1{kV})*(M9/1{kV})*sin((A7 - A9)) = 0.0;

	RP8:
		-(P5/1{MW})
		+ 5.6769798467*(M8/1{kV})*(M7/1{kV})*sin((A8 - A7)) = 0.0;

	RP9:
		1.8554995578*(M9/1{kV})*(M4/1{kV})*sin((A9 - A4))
		+ 9.0900827198*(M9/1{kV})*(M7/1{kV})*sin((A9 - A7))
		+ 5.3260550395*(M9/1{kV})^2
		- 3.902049552*(M9/1{kV})*(M10/1{kV})*cos((A9 - A10))
		+ 10.365394127*(M9/1{kV})*(M10/1{kV})*sin((A9 - A10))
		- 1.424005487*(M9/1{kV})*(M14/1{kV})*cos((A9 - A14))
		+ 3.0290504569*(M9/1{kV})*(M14/1{kV})*sin((A9 - A14)) = -0.295;

	RP10:
		-3.902049552*(M10/1{kV})*(M9/1{kV})*cos((A10 - A9))
		+ 10.365394127*(M10/1{kV})*(M9/1{kV})*sin((A10 - A9))
		+ 5.7829343061*(M10/1{kV})^2
		- 1.880884753*(M10/1{kV})*(M11/1{kV})*cos((A10 - A11))
		+ 4.4029437495*(M10/1{kV})*(M11/1{kV})*sin((A10 - A11)) = -0.09;

	RP11:
		-1.955028563*(M11/1{kV})*(M6/1{kV})*cos((A11 - A6))
		+ 4.0940743442*(M11/1{kV})*(M6/1{kV})*sin((A11 - A6))
		- 1.880884753*(M11/1{kV})*(M10/1{kV})*cos((A11 - A10))
		+ 4.4029437495*(M11/1{kV})*(M10/1{kV})*sin((A11 - A10))
		+ 3.8359133169*(M11/1{kV})^2 = -0.035;

	RP12:
		-1.52596744*(M12/1{kV})*(M6/1{kV})*cos((A12 - A6))
		+ 3.175963965*(M12/1{kV})*(M6/1{kV})*sin((A12 - A6))
		+ 4.0149920273*(M12/1{kV})^2
		- 2.489024586*(M12/1{kV})*(M13/1{kV})*cos((A12 - A13))
		+ 2.2519746262*(M12/1{kV})*(M13/1{kV})*sin((A12 - A13)) = -0.061;

	RP13:
		-3.098927403*(M13/1{kV})*(M6/1{kV})*cos((A13 - A6))
		+ 6.1027554482*(M13/1{kV})*(M6/1{kV})*sin((A13 - A6))
		- 2.489024586*(M13/1{kV})*(M12/1{kV})*cos((A13 - A12))
		+ 2.2519746262*(M13/1{kV})*(M12/1{kV})*sin((A13 - A12))
		+ 6.7249461485*(M13/1{kV})^2
		- 1.136994157*(M13/1{kV})*(M14/1{kV})*cos((A13 - A14))
		+ 2.3149634751*(M13/1{kV})*(M14/1{kV})*sin((A13 - A14)) = -0.135;

	RP14:
		-1.424005487*(M14/1{kV})*(M9/1{kV})*cos((A14 - A9))
		+ 3.0290504569*(M14/1{kV})*(M9/1{kV})*sin((A14 - A9))
		- 1.136994157*(M14/1{kV})*(M13/1{kV})*cos((A14 - A13))
		+ 2.3149634751*(M14/1{kV})*(M13/1{kV})*sin((A14 - A13))
		+ 2.5609996448*(M14/1{kV})^2 = -0.149;

	IP1:
		-(Q1/1{MVAr})
		+ 19.447070206*(M1/1{kV})^2
		- 4.9991316*(M1/1{kV})*(M2/1{kV})*sin((A1 - A2))
		- 15.26308652*(M1/1{kV})*(M2/1{kV})*cos((A1 - A2))
		- 1.025897455*(M1/1{kV})*(M5/1{kV})*sin((A1 - A5))
		- 4.234983682*(M1/1{kV})*(M5/1{kV})*cos((A1 - A5)) = 0.0;

	IP2:
		-(Q2/1{MVAr})
		- 4.9991316*(M2/1{kV})*(M1/1{kV})*sin((A2 - A1))
		- 15.26308652*(M2/1{kV})*(M1/1{kV})*cos((A2 - A1))
		+ 30.272115399*(M2/1{kV})^2
		- 1.135019192*(M2/1{kV})*(M3/1{kV})*sin((A2 - A3))
		- 4.781863151*(M2/1{kV})*(M3/1{kV})*cos((A2 - A3))
		- 1.68603315*(M2/1{kV})*(M4/1{kV})*sin((A2 - A4))
		- 5.115838325*(M2/1{kV})*(M4/1{kV})*cos((A2 - A4))
		- 1.701139667*(M2/1{kV})*(M5/1{kV})*sin((A2 - A5))
		- 5.193927398*(M2/1{kV})*(M5/1{kV})*cos((A2 - A5)) = -0.127;

	IP3:
		-(Q3/1{MVAr})
		- 1.135019192*(M3/1{kV})*(M2/1{kV})*sin((A3 - A2))
		- 4.781863151*(M3/1{kV})*(M2/1{kV})*cos((A3 - A2))
		+ 9.8223801294*(M3/1{kV})^2
		- 1.985975709*(M3/1{kV})*(M4/1{kV})*sin((A3 - A4))
		- 5.068816977*(M3/1{kV})*(M4/1{kV})*cos((A3 - A4)) = -0.19;

	IP4:
		-1.68603315*(M4/1{kV})*(M2/1{kV})*sin((A4 - A2))
		- 5.115838325*(M4/1{kV})*(M2/1{kV})*cos((A4 - A2))
		- 1.985975709*(M4/1{kV})*(M3/1{kV})*sin((A4 - A3))
		- 5.068816977*(M4/1{kV})*(M3/1{kV})*cos((A4 - A3))
		+ 38.654171208*(M4/1{kV})^2
		- 6.840980661*(M4/1{kV})*(M5/1{kV})*sin((A4 - A5))
		- 21.57855398*(M4/1{kV})*(M5/1{kV})*cos((A4 - A5))
		- 4.88951266*(M4/1{kV})*(M7/1{kV})*cos((A4 - A7))
		- 1.855499557*(M4/1{kV})*(M9/1{kV})*cos((A4 - A9)) = 0.039;

	IP5:
		-1.025897455*(M5/1{kV})*(M1/1{kV})*sin((A5 - A1))
		- 4.234983682*(M5/1{kV})*(M1/1{kV})*cos((A5 - A1))
		- 1.701139667*(M5/1{kV})*(M2/1{kV})*sin((A5 - A2))
		- 5.193927398*(M5/1{kV})*(M2/1{kV})*cos((A5 - A2))
		- 6.840980661*(M5/1{kV})*(M4/1{kV})*sin((A5 - A4))
		- 21.57855398*(M5/1{kV})*(M4/1{kV})*cos((A5 - A4))
		+ 35.533639456*(M5/1{kV})^2
		- 4.257445335*(M5/1{kV})*(M6/1{kV})*cos((A5 - A6)) = -0.016;

	IP6:
		-(Q4/1{MVAr})
		- 4.257445335*(M6/1{kV})*(M5/1{kV})*cos((A6 - A5))
		+ 17.34073281*(M6/1{kV})^2
		- 1.955028563*(M6/1{kV})*(M11/1{kV})*sin((A6 - A11))
		- 4.094074344*(M6/1{kV})*(M11/1{kV})*cos((A6 - A11))
		- 1.52596744*(M6/1{kV})*(M12/1{kV})*sin((A6 - A12))
		- 3.175963965*(M6/1{kV})*(M12/1{kV})*cos((A6 - A12))
		- 3.098927403*(M6/1{kV})*(M13/1{kV})*sin((A6 - A13))
		- 6.102755448*(M6/1{kV})*(M13/1{kV})*cos((A6 - A13)) = -0.075;

	IP7:
		-4.88951266*(M7/1{kV})*(M4/1{kV})*cos((A7 - A4))
		+ 19.549005948*(M7/1{kV})^2
		- 5.676979846*(M7/1{kV})*(M8/1{kV})*cos((A7 - A8))
		- 9.090082719*(M7/1{kV})*(M9/1{kV})*cos((A7 - A9)) = 0.0;

	IP8:
		-(Q5/1{MVAr})
		- 5.676979846*(M8/1{kV})*(M7/1{kV})*cos((A8 - A7))
