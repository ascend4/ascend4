		+ 4.7818631518*M3*M2*sin((A3 - A2)*1{rad})
		+ 3.1209949022*M3^2
		- 1.985975709*M3*M4*cos((A3 - A4)*1{rad})
		+ 5.0688169776*M3*M4*sin((A3 - A4)*1{rad}) = -0.942;

	RP4:
		-1.68603315*M4*M2*cos((A4 - A2)*1{rad})
		+ 5.1158383259*M4*M2*sin((A4 - A2)*1{rad})
