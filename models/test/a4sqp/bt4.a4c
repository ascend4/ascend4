REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL bt4;
	x1, x2, x3 IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst BT4 / Boggs-Tolle problem 4.
			Known CUTEst/IPOPTC local solution from the current tracking run:
			    x1 = 2.28449660
			    x2 = -3.72089326
			    x3 = 2.43639665
			    f  = -45.5105507401699
		}
		'source' SELF {
			P. T. Boggs and J. W. Tolle, "A strategy for global convergence
			in a sequential quadratic programming algorithm", SIAM Journal on
			Numerical Analysis 26(3), 1989. SIF input by Ph. L. Toint,
			June 1993.
		}
		'problem_origin' SELF {
			This is a small nonconvex equality-constrained NLP with
			multiple stationary points. It uses the active SIF start
			point rather than the commented alternate starts, so it tracks
			the CUTEst benchmark case.
		}
	END NOTES;

	con1: x1^2 + x2^2 + x3^2 = 25.0;
	con2: x1 + x2 + x3 = 1.0;
	obj: MINIMIZE x1 - x2 + x2^3;

METHODS
METHOD self_test;
	ASSERT abs(x1 - 2.28449660) < 5e-5;
	ASSERT abs(x2 + 3.72089326) < 5e-5;
	ASSERT abs(x3 - 2.43639665) < 5e-5;
	ASSERT abs((x1 - x2 + x2^3) + 45.5105507401699) < 5e-6;
	ASSERT SATISFIED(con1,1e-6);
	ASSERT SATISFIED(con2,1e-7);
END self_test;

METHOD on_load;
	x1 := 4.0382;
	x2 := -2.9470;
	x3 := -0.09115;
	SOLVER A4SQP;
	OPTION max_iter 300;
	OPTION kkt_convergence TRUE;
	OPTION acceptable_iter 5;
	OPTION hessian 'EXACT_LAGRANGIAN';
END on_load;

METHOD on_load_test;
	x1 := 4.0382;
	x2 := -2.9470;
	x3 := -0.09115;
END on_load_test;
END bt4;
