REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL lubrifc;
	nn IS_A integer_constant;
	n IS_A integer_constant;
	two_nn IS_A integer_constant;
	four_nn IS_A integer_constant;

	alpha IS_A factor_constant;
	lambda IS_A factor_constant;
	xa IS_A factor_constant;
	xf IS_A factor_constant;
	pi IS_A factor_constant;
	len IS_A factor_constant;
	rn IS_A factor_constant;
	dx IS_A factor_constant;
	inv_pi IS_A factor_constant;
	half_inv_pi IS_A factor_constant;
	dx_over_pi IS_A factor_constant;
	two_dx_over_pi IS_A factor_constant;
	inv_dx IS_A factor_constant;
	inv_dx2 IS_A factor_constant;
	lambda_over_dx IS_A factor_constant;

	k IS_A solver_var;
	p[0..n] IS_A solver_var;
	h[1..n] IS_A solver_var;
	r[1..n-1] IS_A solver_var;

	nn :== 10;
	n :== 5*nn;
	two_nn :== 2*nn;
	four_nn :== 4*nn;

	alpha :== 1.838;
	lambda :== 1.642;
	xa :== -3.0;
	xf :== 2.0;
	pi :== 3.1415926535;
	len :== xf - xa;
	rn :== n;
	dx :== len/rn;
	inv_pi :== 1.0/pi;
	half_inv_pi :== 0.5*inv_pi;
	dx_over_pi :== dx*inv_pi;
	two_dx_over_pi :== 2.0*dx_over_pi;
	inv_dx :== 1.0/dx;
	inv_dx2 :== inv_dx*inv_dx;
	lambda_over_dx :== lambda*inv_dx;

	NOTES
		'description' SELF {
			Reduced ASCEND translation of the corrected LUBRIFC
			benchmark. This model uses NN = 10, giving n = 50 pressure
			intervals rather than the much larger CUTEr default.

			The original SIF is a nonlinear complementarity problem for a
			discretized Reynolds lubrication equation coupled to an
			elastic film-thickness relation. The present ASCEND benchmark
			uses the smoother relaxation
			    minimize sum(p[i] * r[i])
			together with p[i] >= 0 and r[i] >= 0.
		}
		'source' SELF {
			M.M. Kostreva, "Elasto-hydrodynamic lubrification:
			a non-linear complementarity problem",
			International Journal for Numerical Methods in Fluids,
			4:377-397, 1984.
			Corrected CUTEr/SIF variant by Sven Leyffer, September 2000.
			SIF input by Ph. Toint, June 1990.
		}
		'problem_origin' SELF {
			This is a physical lubrication-contact problem. The unknown
			pressure field in a thin lubricating film interacts with film
			thickness and cavitation through a Reynolds-type equation and
			complementarity conditions.
		}
	END NOTES;

	obj: MINIMIZE SUM[p[i]*r[i] | i IN [1..n-1]];

	load_balance:
		dx_over_pi*(2.0*SUM[p[i] | i IN [1..n-1]] + p[n]) = 1.0;

	FOR i IN [1..n-1] CREATE
		reynolds[i]:
			inv_dx2 * (
				(p[i-1] - p[i]) * h[i]^3 * exp(-0.5*alpha*(p[i-1] + p[i]))
				- (p[i] - p[i+1]) * h[i+1]^3 * exp(-0.5*alpha*(p[i] + p[i+1]))
			) + lambda_over_dx*(h[i+1] - h[i]) - r[i] = 0;
	END FOR;

	FOR j IN [1..n] CREATE
		film[j]:
			k - h[j]
			+ inv_pi * (
				(0.5 * ((0.5 - j) * dx) * ln(abs((0.5 - j) * dx))
					- ((2.5 - j) * dx) * ln(abs((2.5 - j) * dx))) * p[1]
				+ (((1.5 - j) * dx) * ln(abs((1.5 - j) * dx))
					- ((3.5 - j) * dx) * ln(abs((3.5 - j) * dx))) * p[2]
				+ SUM[
					((((i - 0.5) - j) * dx) * ln(abs(((i - 0.5) - j) * dx))
					- (((i + 1.5) - j) * dx) * ln(abs(((i + 1.5) - j) * dx))) * p[i]
					| i IN [3..n-2]
				]
				+ ((((n - 1.5) - j) * dx) * ln(abs(((n - 1.5) - j) * dx))
					- 0.5 * ((n + 0.5 - j) * dx) * ln(abs((n + 0.5 - j) * dx))) * p[n-1]
			) = -(1.0 + (xa + (j - 0.5)*dx)^2);
	END FOR;

METHODS
METHOD self_test;
	ASSERT abs(k - 0.060742765520110716) < 1e-4;
	ASSERT SUM[p[i]*r[i] | i IN [1..n-1]] < 1e-8;
	ASSERT SATISFIED(load_balance,1e-8);
	FOR i IN [1..n-1] DO
		ASSERT p[i] >= -1e-10;
		ASSERT r[i] >= -1e-10;
	END FOR;
END self_test;

METHOD init_constants;
END init_constants;

METHOD bound_self;
	FIX p[0], p[n];
	p[0] := 0.0;
	p[n] := 0.0;
	FOR i IN [1..n-1] DO
		p[i].lower_bound := 0.0;
		p[i].upper_bound := 3.0;
		r[i].lower_bound := 0.0;
	END FOR;
END bound_self;

METHOD default_self;
	k := 0.0;
	FOR i IN [1..two_nn] DO
		p[i] := 0.06 + 0.02*(xa + i*dx);
	END FOR;
	FOR i IN [two_nn+1..four_nn] DO
		p[i] := sqrt(1.0 - (xa + i*dx)^2);
	END FOR;
	FOR i IN [four_nn+1..n-1] DO
		p[i] := 0.0;
	END FOR;
	FOR j IN [1..n] DO
		h[j] := (xa + (j - 0.5)*dx)^2;
	END FOR;
	FOR i IN [1..n-1] DO
		r[i] := 0.0;
	END FOR;
END default_self;

METHOD on_load;
	RUN init_constants;
	RUN bound_self;
	RUN default_self;
	SOLVER A4SQP;
	OPTION max_iter 200;
END on_load;

METHOD on_load_test;
	RUN init_constants;
	RUN bound_self;
	RUN default_self;
END on_load_test;
END lubrifc;
