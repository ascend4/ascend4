REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL cb3;
	x1, x2, u IS_A solver_var;

	NOTES
		'description' SELF {
			ASCEND translation of CUTEst CB3.
			Known solution:
			    x1 = 1
			    x2 = 1
			    u  = 2
			    f  = 2
		}
		'source' SELF {
			R. Womersley and R. Fletcher, "An algorithm for composite
			nonsmooth optimization problems", Journal of Optimization Theory
			and Applications 48, 1986. SIF input by Ph. L. Toint, April 1992.
		}
		'problem_origin' SELF {
			This is a synthetic smooth epigraph reformulation of a nonsmooth
			minimax benchmark.
			A4SQP solved the corresponding CUTEst problem as a strict
			success in the broader NLP smoke run, so this model is intended
			as a compact regression for active nonlinear inequality
			selection in an epigraph formulation.
		}
	END NOTES;

	con1: u >= x1^4 + x2^2;
	con2: u >= (2.0 - x1)^2 + (2.0 - x2)^2;
	con3: u >= 2.0*exp(x2 - x1);
	obj: MINIMIZE u;

METHODS
METHOD self_test;
	ASSERT abs(x1 - 1.0) < 2e-5;
	ASSERT abs(x2 - 1.0) < 2e-5;
	ASSERT abs(u - 2.0) < 2e-5;
	ASSERT u - (x1^4 + x2^2) > -1e-7;
	ASSERT u - ((2.0 - x1)^2 + (2.0 - x2)^2) > -1e-7;
	ASSERT u - 2.0*exp(x2 - x1) > -1e-7;
END self_test;

METHOD on_load;
	x1 := 2.0;
	x2 := 2.0;
	u := 1.0;
	SOLVER A4SQP;
	OPTION max_iter 100;
END on_load;

METHOD on_load_test;
	x1 := 2.0;
	x2 := 2.0;
	u := 1.0;
END on_load_test;
END cb3;
