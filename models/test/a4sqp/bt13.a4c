REQUIRE "system.a4l";
REQUIRE "atoms.a4l";
IMPORT "a4sqp";

MODEL bt13;
	x1, x2, x3, x4, x5 IS_A solver_var;

	NOTES
		'description' SELF {
			CUTEst BT13 / Boggs-Tolle problem 13.
			SIF equivalent:
			    minimize x5
			    subject to x1^2 + (x1 - 2*x2)^2 + (x2 - 3*x3)^2
			        + (x3 - 4*x4)^2 - x5^2 = 0
			    and x5 >= 0
			Known global solution:
			    x1 = x2 = x3 = x4 = x5 = 0
			    f = 0
		}
		'source' SELF {
			P.T. Boggs and J.W. Tolle, "A strategy for global convergence
			in a sequential quadratic programming algorithm", SIAM Journal
			on Numerical Analysis 26(3), pp. 600-623, 1989.
			SIF input by Ph. L. Toint, June 1993.
		}
		'problem_origin' SELF {
			This is a nonconvex synthetic nonlinear programming benchmark.
			It is currently a focused A4SQP restoration/stationarity
			regression case, not a passing solver regression.
		}
	END NOTES;

	con1:
		x1^2 + (x1 - 2*x2)^2 + (x2 - 3*x3)^2
		+ (x3 - 4*x4)^2 - x5^2 = 0;

	obj: MINIMIZE x5;

METHODS
METHOD bound_self;
	x5.lower_bound := 0.0;
END bound_self;

METHOD default_self;
	x1 := 1.0;
	x2 := 2.0;
	x3 := 3.0;
	x4 := 3.0;
	x5 := 228.0;
END default_self;

METHOD self_test;
	ASSERT abs(x1) < 1e-5;
	ASSERT abs(x2) < 1e-5;
	ASSERT abs(x3) < 1e-5;
	ASSERT abs(x4) < 1e-5;
	ASSERT abs(x5) < 1e-5;
	ASSERT x5 >= -1e-8;
	ASSERT SATISFIED(con1,1e-7);
END self_test;

METHOD on_load;
	RUN bound_self;
	RUN default_self;
	SOLVER A4SQP;
		OPTION max_iter 200;
		OPTION restoration TRUE;
		OPTION restoration_trigger_iter 0;
		OPTION restoration_handoff_reduction 0.5;
		OPTION restoration_reentry_factor 1.0;
	END on_load;

METHOD on_load_test;
	RUN bound_self;
	RUN default_self;
END on_load_test;
END bt13;
