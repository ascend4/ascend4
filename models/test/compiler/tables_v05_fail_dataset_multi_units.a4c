REQUIRE "atoms.a4l";

MODEL tables_v05_fail_dataset_multi_units;
	t IS_A set OF integer_constant;
	load[t] IS_A factor_constant;

	DATASET ops FROM "ops.csv";
		INDEX t FROM COLUMN timestamp IS_A integer_constant;
		load[t] FROM COLUMN load_MW {MW} {kW} IS_A factor_constant;
	END DATASET;
END tables_v05_fail_dataset_multi_units;
