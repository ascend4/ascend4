REQUIRE "atoms.a4l";

MODEL tables_v05_parse;
	customer IS_A set OF integer_constant;
	facility IS_A set OF integer_constant;
	city IS_A set OF integer_constant;

	customer :== [1..4];
	facility :== [1..3];
	city :== [1..4];

	demand[customer] IS_A factor_constant;
	ship_cost[customer][facility] IS_A factor_constant;
	c[city][city] IS_A factor_constant;
	load[customer] IS_A factor_constant;

	TABLE ship_cost[customer,facility];
		1 2 3
		1 2 4 5
		2 3;
		1 2
		3 4 2 1
		4 5 3 2
	END TABLE;

	TABLE c[city,city] DEFAULT 0;
		1: 1=0 2=89 3=22;
		   4=11
		2: 1=21 2=0 3=94 4=77
		3 1=11 2=19 3=0 4=35
		4 1=79 2=33 3=99 4=0
	END TABLE;

	TABLE c[city,city] POSITIONAL;
		0 89 22 11
		21 0 94 77
		11 19 0 35
		79 33 99 0
	END TABLE;

	VALUES demand[customer] DEFAULT 0;
		1=45;
		2=30;
		3=40;
		4=35;
	END VALUES;

	DATASET ops FROM "ops.csv";
		INDEX customer FROM COLUMN customer_id IS_A integer_constant;
		load[customer] FROM COLUMN load_MW {MW};
		demand[customer] FROM COLUMN demand_factor IS_A factor_constant;
	END DATASET;
END tables_v05_parse;
