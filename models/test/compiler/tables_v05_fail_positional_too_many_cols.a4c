REQUIRE "atoms.a4l";

MODEL tables_v05_fail_positional_too_many_cols;
	r IS_A set OF integer_constant;
	c IS_A set OF integer_constant;
	cost[r][c] IS_A integer_constant;
	r :== [1..2];
	c :== [1..3];

	TABLE cost[r][c] POSITIONAL;
		11 12 13 14
		21 22 23
	END TABLE;
END tables_v05_fail_positional_too_many_cols;
