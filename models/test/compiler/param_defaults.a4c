REQUIRE "atoms.a4l";

MODEL param_default_literal(
	a WILL_BE integer_constant;
	b WILL_BE symbol_constant DEFAULT 'x';
);
METHODS
	METHOD self_test;
		ASSERT b = 'x';
	END self_test;
END param_default_literal;

MODEL param_default_prior(
	a WILL_BE symbol_constant;
	b WILL_BE symbol_constant DEFAULT a;
);
METHODS
	METHOD self_test;
		ASSERT b = a;
	END self_test;
END param_default_prior;

MODEL param_defaults_case;
	a_int IS_A integer_constant;
	a_sym IS_A symbol_constant;
	p_lit IS_A param_default_literal(a_int);
	p_prior IS_A param_default_prior(a_sym);
	x IS_A factor;
	x_eqn: x = 1;
	a_int :== 3;
	a_sym :== 'nitrogen';

METHODS
	METHOD on_load;
		RUN p_lit.self_test;
		RUN p_prior.self_test;
	END on_load;
END param_defaults_case;
