REQUIRE "atoms.a4l";

MODEL tables_v05_fail_dense_bad_row_label_string;
	r IS_A set OF symbol_constant;
	c IS_A set OF integer_constant;
	cost[r][c] IS_A integer_constant;
	r :== ['north','south'];
	c :== [1..2];

	TABLE cost[r,c];
		: 1 2
		north: 11 12
		east: 31 32
	END TABLE;
END tables_v05_fail_dense_bad_row_label_string;
