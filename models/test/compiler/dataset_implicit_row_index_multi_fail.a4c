REQUIRE "atoms.a4l";

MODEL dataset_implicit_row_index_multi_fail;
	r, c IS_A set OF integer_constant;
	cost[r][c] IS_A integer_constant;

	DATASET costdata FROM "test/compiler/dataset_basic.csv";
		cost[r][c] FROM COLUMN cost IS_A integer_constant;
	END DATASET;
END dataset_implicit_row_index_multi_fail;
