(* Opposite target truth values at exactly the same event time, including
   both overridden terms in a single logical relation. *)
MODEL ida_event_mixed;
    t IS_A time;
    INDEPENDENT t;
    x[1..3] IS_A distance;
    on[1..3] IS_A boolean_var;
CONDITIONAL
    up: t > 0.1 {s};
    down: t <= 0.1 {s};
END CONDITIONAL;
    on[1] == SATISFIED(up, 1e-12);
    on[2] == SATISFIED(down, 1e-12);
    on[3] == (SATISFIED(up, 1e-12) AND NOT SATISFIED(down, 1e-12));
    FOR i IN [1..3] CREATE
        slow[i]: der(x[i]) = 1 {m/s};
        fast[i]: der(x[i]) = 2 {m/s};
        WHEN(on[i])
        CASE TRUE: USE fast[i];
        CASE FALSE: USE slow[i];
        END WHEN;
    END FOR;
METHODS
    METHOD on_load;
        t := 0 {s};
        x[1..3] := 0 {m};
        x[1..3].ode_atol := 1e-10;
        on[1] := FALSE; on[2] := TRUE; on[3] := FALSE;
        INTEGRATOR IDA;
        OPTION rtol 1e-9;
        OPTION atolvect TRUE;
        OBSERVE x[1..3];
    END on_load;
END ida_event_mixed;

(* The same boundary crosses in both directions, at 0.2 and 0.4 s. *)
MODEL ida_event_repeated_gt;
    t IS_A time;
    INDEPENDENT t;
    x IS_A distance;
    on IS_A boolean_var;
CONDITIONAL
    crossing: (t - 0.2 {s})*(0.4 {s} - t) > 0 {s^2};
END CONDITIONAL;
    on == SATISFIED(crossing, 1e-12);
    slow: der(x) = 1 {m/s};
    fast: der(x) = 2 {m/s};
    WHEN(on)
    CASE TRUE: USE fast;
    CASE FALSE: USE slow;
    END WHEN;
METHODS
    METHOD on_load;
        t := 0 {s};
        x := 0 {m};
        x.ode_atol := 1e-10;
        on := FALSE;
        INTEGRATOR IDA;
        OPTION rtol 1e-9;
        OPTION atolvect TRUE;
        OBSERVE x;
    END on_load;
END ida_event_repeated_gt;

