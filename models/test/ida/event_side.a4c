        z := 0.0 {m};
        y.ode_atol := 1e-20;
        z.ode_atol := 1e-20;
        der(y) := 1e-10 {m/s};
        count := 0;
        on := FALSE;
        INTEGRATOR IDA;
        OPTION rtol 1e-9;
        OPTION atolvect TRUE;
        OBSERVE y;
    END on_load;
END ida_event_reset_small;


