(* A reset moves the continuous state back across the triggering boundary.
   The boundary depends on z, which must be recomputed for consistency. *)
MODEL ida_event_reset_gt;
    t IS_A time;
    INDEPENDENT t;
    y, z IS_A distance;
    count IS_A generic_real;
    on IS_A boolean_var;
    motion: der(y) = 1 {m/s};
    observe: z = 2*y;
CONDITIONAL
    crossing: z > 0.4 {m};
END CONDITIONAL;
    on == SATISFIED(crossing, 1e-12);
    WHEN(on)
    CASE TRUE:
        REINIT(y, 0 {m});
        REINIT(count, pre(count) + 1);
    CASE FALSE:
    END WHEN;
METHODS
    METHOD on_load;
        t := 0 {s};
        y := 0 {m};
        z := 0.0 {m};
        y.ode_atol := 1e-10;
        z.ode_atol := 1e-10;
        der(y) := 1 {m/s};
        count := 0;
        on := FALSE;
        INTEGRATOR IDA;
        OPTION rtol 1e-9;
        OPTION atolvect TRUE;
        OBSERVE y;
    END on_load;
END ida_event_reset_gt;

(* A reset moves the continuous state back across the triggering boundary.
   The boundary depends on z, which must be recomputed for consistency. *)
MODEL ida_event_reset_ge;
