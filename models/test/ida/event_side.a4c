CONDITIONAL
    crossing: z > 4e-11 {m};
END CONDITIONAL;
    on == SATISFIED(crossing, 1e-8);
    WHEN(on)
    CASE TRUE:
        REINIT(y, 0 {m});
        REINIT(count, pre(count) + 1);
