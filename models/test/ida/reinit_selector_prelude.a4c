REQUIRE "ivpsystem.a4l";
REQUIRE "atoms.a4l";

MODEL ida_reinit_integer_mode_switch;
	t               IS_A time;
	y, ydot         IS_A generic_real;
	sample          IS_A generic_real;
	stage           IS_A integer;
	trigger         IS_A boolean_var;
	trip_time       IS_A time;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

CONDITIONAL
	trip: y >= trip_time;
END CONDITIONAL;

	trigger == SATISFIED(trip, 1e-8);

	WHEN(trigger)
		CASE TRUE:
			REINIT(stage, 1);
		CASE FALSE:
	END WHEN;

	WHEN(stage)
		CASE 0:
			USE before_trip;
		CASE 1:
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		FIX trip_time;
		trip_time := 1 {s};
		y := 0;
		ydot := 1;
		sample := 0;
		stage := 0;
		trigger := FALSE;
		t := 0 {s};
	END values;
END ida_reinit_integer_mode_switch;

MODEL ida_reinit_symbol_mode_switch;
	t               IS_A time;
	y, ydot         IS_A generic_real;
	sample          IS_A generic_real;
	mode            IS_A symbol;
	trigger         IS_A boolean_var;
	trip_time       IS_A time;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

CONDITIONAL
	trip: y >= trip_time;
END CONDITIONAL;

	trigger == SATISFIED(trip, 1e-8);

	WHEN(trigger)
		CASE TRUE:
			REINIT(mode, 'high');
		CASE FALSE:
	END WHEN;

	WHEN(mode)
		CASE 'low':
			USE before_trip;
		CASE 'high':
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		FIX trip_time;
		trip_time := 1 {s};
		y := 0;
		ydot := 1;
		sample := 0;
		mode := 'low';
		trigger := FALSE;
		t := 0 {s};
	END values;
END ida_reinit_symbol_mode_switch;
