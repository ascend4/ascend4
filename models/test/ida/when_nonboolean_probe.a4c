REQUIRE "ivpsystem.a4l";
REQUIRE "atoms.a4l";

MODEL ida_when_integer_initial_case;
	t, trip_time      IS_A time;
	y, ydot           IS_A generic_real;
	sample            IS_A generic_real;
	stage             IS_A integer;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

	WHEN(stage)
		CASE 0:
			USE before_trip;
		CASE 1:
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		y := 0;
		ydot := 1;
		sample := 0;
		stage := 1;
		t := 0 {s};
	END values;
END ida_when_integer_initial_case;

MODEL ida_when_symbol_initial_case;
	t, trip_time      IS_A time;
	y, ydot           IS_A generic_real;
	sample            IS_A generic_real;
	mode              IS_A symbol;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

	WHEN(mode)
		CASE 'low':
			USE before_trip;
		CASE 'high':
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		y := 0;
		ydot := 1;
		sample := 0;
		mode := 'high';
		t := 0 {s};
	END values;
END ida_when_symbol_initial_case;

MODEL ida_when_case_if_rejected;
	t, trip_time      IS_A time;
	y, ydot           IS_A generic_real;
	sample            IS_A generic_real;
	stage             IS_A integer;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

	WHEN(stage)
		CASE 0 IF TRUE:
			USE before_trip;
		CASE 1:
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		y := 0;
		ydot := 1;
		sample := 0;
		stage := 0;
		t := 0 {s};
	END values;
END ida_when_case_if_rejected;

MODEL ida_when_applies_if_rejected;
	t, trip_time      IS_A time;
	y, ydot           IS_A generic_real;
	sample            IS_A generic_real;
	stage             IS_A integer;

	drive:       ydot = 1;
	before_trip: sample = y;
	after_trip:  sample = y + 10;

	WHEN(stage)
		CASE 0 APPLIES IF TRUE:
			USE before_trip;
		CASE 1:
			USE after_trip;
	END WHEN;

METHODS
	METHOD on_load;
		y.ode_type := 1; ydot.ode_type := 2;
		y.ode_id := 1;   ydot.ode_id := 1;
		t.ode_type := -1;
		RUN values;
	END on_load;

	METHOD values;
		y := 0;
		ydot := 1;
		sample := 0;
		stage := 0;
		t := 0 {s};
	END values;
END ida_when_applies_if_rejected;
