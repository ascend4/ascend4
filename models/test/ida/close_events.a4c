END CONDITIONAL;
FOR i IN [1..3] CREATE
  on[i] == SATISFIED(reached[i],0.0);
  slow[i]: der(x[i]) = 1 {m/s};
  fast[i]: der(x[i]) = 2 {m/s};
  WHEN(on[i])
  CASE TRUE: USE fast[i];
  CASE FALSE: USE slow[i];
  END WHEN;
END FOR;
METHODS
METHOD on_load;
t := 0 {s};
on[1..3] := FALSE;
x[1..3] := 0 {m};
x[1..3].ode_atol := 1e-10;
INTEGRATOR IDA;
OPTION rtol 1e-9;
OPTION atolvect TRUE;
OPTION zeno_ncycles 200;
OBSERVE x[1..3];
END on_load;
END ida_close_rising_strict_zero_tol;

MODEL ida_close_falling_inclusive;
t IS_A time;
INDEPENDENT t;
x[1..3] IS_A distance;
on[1..3] IS_A boolean_var;
CONDITIONAL
FOR i IN [1..3] CREATE
  reached[i]: t <= (0.1 + i*1e-8)*1 {s};
END FOR;
END CONDITIONAL;
FOR i IN [1..3] CREATE
  on[i] == SATISFIED(reached[i],1e-6);
  slow[i]: der(x[i]) = 1 {m/s};
  fast[i]: der(x[i]) = 2 {m/s};
  WHEN(on[i])
  CASE TRUE: USE fast[i];
  CASE FALSE: USE slow[i];
  END WHEN;
END FOR;
METHODS
METHOD on_load;
t := 0 {s};
on[1..3] := TRUE;
x[1..3] := 0 {m};
x[1..3].ode_atol := 1e-10;
INTEGRATOR IDA;
OPTION rtol 1e-9;
OPTION atolvect TRUE;
OPTION zeno_ncycles 200;
OBSERVE x[1..3];
END on_load;
END ida_close_falling_inclusive;

