OBSERVE x[1..3];
END on_load;
END ida_close_recross_falling;

MODEL ida_guard_truth_modes;
t IS_A time;
INDEPENDENT t;
g IS_A factor;
x[1..6] IS_A distance;
on[1..6] IS_A boolean_var;
CONDITIONAL
  gt: g > 0;
  ge: g >= 0;
  lt: g < 0;
  le: g <= 0;
  eq: g = 0;
END CONDITIONAL;
on[1] == SATISFIED(gt,1e-6);
on[2] == SATISFIED(ge,1e-6);
on[3] == SATISFIED(lt,1e-6);
on[4] == SATISFIED(le,1e-6);
on[5] == (SATISFIED(gt,1e-6) OR SATISFIED(lt,1e-6));
on[6] == SATISFIED(eq,1e-6);
FOR i IN [1..6] CREATE
  slow[i]: der(x[i]) = 1 {m/s};
  fast[i]: der(x[i]) = 2 {m/s};
  WHEN(on[i])
  CASE TRUE: USE fast[i];
  CASE FALSE: USE slow[i];
  END WHEN;
END FOR;
METHODS
METHOD on_load;
t := 0 {s};
FIX g;
g := 5e-7;
on[1..6] := FALSE;
x[1..6] := 0 {m};
x[1..6].ode_atol := 1e-10;
INTEGRATOR IDA;
OBSERVE x[1..6];
END on_load;
END ida_guard_truth_modes;
