MODEL ida_close_falling_strict;
t IS_A time;
INDEPENDENT t;
x[1..3] IS_A distance;
on[1..3] IS_A boolean_var;
CONDITIONAL
FOR i IN [1..3] CREATE
  reached[i]: t < (0.1 + i*1e-8)*1 {s};
END FOR;
