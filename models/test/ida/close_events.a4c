MODEL ida_close_recross_rising;
t IS_A time;
INDEPENDENT t;
x[1..3] IS_A distance;
on[1..3] IS_A boolean_var;
z IS_A distance;
tick IS_A boolean_var;
CONDITIONAL
  clock: t > 0.5 {s};
FOR i IN [1..3] CREATE
  reached[i]: (t - (0.1 + i*1e-8)*1 {s})*(0.8 {s} - t) > 0 {s^2};
END FOR;
END CONDITIONAL;
FOR i IN [1..3] CREATE
  on[i] == SATISFIED(reached[i],1e-6);
  slow[i]: der(x[i]) = 1 {m/s};
  fast[i]: der(x[i]) = 2 {m/s};
  WHEN(on[i])
  CASE TRUE: USE fast[i];
  CASE FALSE: USE slow[i];
  END WHEN;
END FOR;
tick == SATISFIED(clock,1e-6);
zslow: der(z) = 1 {m/s};
zfast: der(z) = 2 {m/s};
WHEN(tick)
CASE TRUE: USE zfast;
CASE FALSE: USE zslow;
END WHEN;
METHODS
METHOD on_load;
t := 0 {s};
z := 0 {m};
z.ode_atol := 1e-10;
tick := FALSE;
on[1..3] := FALSE;
x[1..3] := 0 {m};
x[1..3].ode_atol := 1e-10;
INTEGRATOR IDA;
OPTION rtol 1e-9;
OPTION atolvect TRUE;
OPTION zeno_ncycles 200;
OBSERVE x[1..3];
END on_load;
END ida_close_recross_rising;

MODEL ida_close_recross_falling;
t IS_A time;
INDEPENDENT t;
x[1..3] IS_A distance;
on[1..3] IS_A boolean_var;
z IS_A distance;
tick IS_A boolean_var;
CONDITIONAL
  clock: t > 0.5 {s};
FOR i IN [1..3] CREATE
  reached[i]: (t - (0.1 + i*1e-8)*1 {s})*(0.8 {s} - t) <= 0 {s^2};
END FOR;
END CONDITIONAL;
FOR i IN [1..3] CREATE
  on[i] == SATISFIED(reached[i],1e-6);
  slow[i]: der(x[i]) = 1 {m/s};
  fast[i]: der(x[i]) = 2 {m/s};
  WHEN(on[i])
  CASE TRUE: USE fast[i];
  CASE FALSE: USE slow[i];
  END WHEN;
END FOR;
tick == SATISFIED(clock,1e-6);
zslow: der(z) = 1 {m/s};
zfast: der(z) = 2 {m/s};
WHEN(tick)
CASE TRUE: USE zfast;
CASE FALSE: USE zslow;
END WHEN;
METHODS
METHOD on_load;
t := 0 {s};
z := 0 {m};
z.ode_atol := 1e-10;
tick := FALSE;
on[1..3] := TRUE;
x[1..3] := 0 {m};
x[1..3].ode_atol := 1e-10;
INTEGRATOR IDA;
OPTION rtol 1e-9;
OPTION atolvect TRUE;
