REQUIRE "system.a4l";

MODEL cmslv2_case_if_steady;
	x IS_A solver_var;
	mode IS_A symbol_constant;
	mode :== 'selected';

	r_overruled: x = 1;
	r_selected: x = 2;
	r_otherwise: x = 3;

	WHEN (mode)
	CASE 'selected' IF FALSE:
		USE r_overruled;
	CASE 'selected' IF TRUE:
		USE r_selected;
	OTHERWISE:
		USE r_otherwise;
	END WHEN;
METHODS
	METHOD on_load;
		x := 0;
	END on_load;

	METHOD self_test;
		ASSERT abs(x - 2) < 1e-8;
	END self_test;
END cmslv2_case_if_steady;
