REQUIRE "atoms.a4l";

MODEL reinitignore;

	x IS_A factor;
	memory IS_A factor;
	bol IS_A boolean_var;

CONDITIONAL
	cond: x >= 0;
END CONDITIONAL;

	bol == SATISFIED(cond, 1e-8);

	pos: x = 1;
	neg: x = -1;

WHEN (bol)
	CASE TRUE:
		USE pos;
		REINIT(memory, pre(memory));
	CASE FALSE:
		USE neg;
END WHEN;

METHODS
	METHOD on_load;
		RUN values;
	END on_load;

	METHOD values;
		x := 1;
		memory := 0;
		bol := SATISFIED(cond, 1e-8);
	END values;

	METHOD self_test;
		ASSERT abs(x - 1) < 1e-12;
		ASSERT abs(memory) < 1e-12;
		ASSERT bol == TRUE;
	END self_test;
END reinitignore;
