REQUIRE "atoms.a4l";

MODEL reinitignore_case_if;
	x IS_A factor;
	memory IS_A factor;
	mode IS_A symbol_constant;
	mode :== 'selected';

	pos: x = 1;
	neg: x = -1;

	WHEN (mode)
	CASE 'selected' IF SATISFIED(x >= 0, 1e-8):
		USE pos;
		REINIT(memory, pre(memory));
	OTHERWISE:
		USE neg;
	END WHEN;

METHODS
	METHOD on_load;
		x := 1;
		memory := 0;
	END on_load;

	METHOD self_test;
		ASSERT abs(x - 1) < 1e-12;
		ASSERT abs(memory) < 1e-12;
	END self_test;
END reinitignore_case_if;
