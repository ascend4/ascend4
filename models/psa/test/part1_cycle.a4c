REQUIRE "psa/psa_part1_cycle.a4c";

MODEL psa_part1_cycle_ipopt_check REFINES psa_part1_cycle;
    obj: MINIMIZE product;
END psa_part1_cycle_ipopt_check;

MODEL psa_part1_pressure_fixture;
    bed IS_A psa_caloric_bed;
    start, finish IS_A psa_caloric_state(bed, 1);
    y IS_A fraction;
    Tfeed IS_A temperature;
    Psource IS_A pressure;
METHODS
METHOD setup;
    FIX bed.V, bed.eps, bed.rho, bed.Cv, bed.cpA, bed.cpB, bed.H, bed.Tref;
    bed.V := 0.35{m^3}; bed.eps := 0.44; bed.rho := 800{kg/m^3};
    bed.Cv := 804000{J/m^3/K}; bed.cpA := 36.8{J/mol/K}; bed.cpB := 29.3{J/mol/K};
    bed.H := 20920{J/mol}; bed.Tref := 298{K};
    FIX start.P, start.T, start.sA, y, Tfeed, Psource;
    start.P := 225*6894.757293168{Pa}; start.T := 310{K}; start.sA := 60{mol};
    y := 0.05; Tfeed := 298{K}; Psource := 300*6894.757293168{Pa};
    SOLVER QRSlv;
END setup;
END psa_part1_pressure_fixture;

MODEL psa_part1_blowdown_check REFINES psa_part1_pressure_fixture;
    bd IS_A psa_part1_blowdown(start, finish, y);
    initial_composition: start.gA = y*start.n;
METHODS
METHOD on_load;
    RUN setup;
    FIX bd.Pvalve;
    bd.Pvalve := 15*6894.757293168{Pa}; bd.Tgas := 150{K};
END on_load;
END psa_part1_blowdown_check;

MODEL psa_part1_repressurisation_check REFINES psa_part1_pressure_fixture;
    fr IS_A psa_part1_repressurisation(start, finish, y, Tfeed, Psource);
    initial_composition: start.gA = 0{mol};
METHODS
METHOD on_load;
    RUN setup;
    start.P := 15*6894.757293168{Pa}; start.T := 290{K}; start.sA := 0{mol};
    FIX fr.Pvalve;
    fr.Pvalve := 225*6894.757293168{Pa}; fr.TB := 600{K}; fr.TF := 280{K};
END on_load;
END psa_part1_repressurisation_check;
