(* Electrical Power Generation 1: Williams, Model Building in Mathematical
   Programming, 5th ed., example 15, pp. 270-271, 325-326. Data and optimum:
   https://github.com/Gurobi/modeling-examples/blob/master/electrical_power_generation/electrical_power_1.ipynb
   Follow the notebook's executable formulation; its displayed objective
   omits duration factors and the online-unit multiplier in minimum output.
   See electrical_power_1.md for assumptions, units and the reference plan. *)
REQUIRE "atoms.a4l";

CONSTANT uc_power_constant REFINES real_constant DIMENSION M*L^2/T^3;
CONSTANT uc_running_cost_constant REFINES real_constant DIMENSION C/T;
CONSTANT uc_energy_cost_constant REFINES real_constant DIMENSION C*T^2/M/L^2;
CONSTANT uc_start_cost_constant REFINES real_constant DIMENSION C;

(* Helper type for this example, not a standalone component library.
   This operating envelope represents identical thermal generators with an
   affine electrical-output cost; it is not a thermodynamic cycle model. *)
MODEL thermal_generator_group(
    T IS_A integer_constant;                 (* number of consecutive periods *)
    dt[1..T] WILL_BE time_constant;           (* shared period durations *)
    n IS_A integer_constant;                 (* identical units installed *)
    n0 IS_A integer_constant;                (* units on just before period 1 *)
    pmin IS_A uc_power_constant;             (* minimum stable output per unit *)
    pmax IS_A uc_power_constant;             (* rated output per unit *)
    base IS_A uc_running_cost_constant;      (* cost rate per unit at pmin *)
    marginal IS_A uc_energy_cost_constant;   (* cost of energy above pmin *)
    startup IS_A uc_start_cost_constant;     (* cost per off-to-on event *)
) WHERE (
    T >= 1; n >= 1; n0 >= 0; n0 <= n;
    CARD[p IN [1..T] | dt[p] <= 0{s}] = 0;
    pmin >= 0{MW}; pmax > 0{MW}; pmax >= pmin;
    base >= 0{USD/h}; marginal >= 0{USD/MWh}; startup > 0{USD};
);
    period IS_A set OF integer_constant;
    period :== [1..T];
    on[period] "Number of units committed throughout each period" IS_A solver_int;
    start[period] "Number of units started at each period boundary" IS_A solver_int;
    P[period] "Combined electrical output of the online units" IS_A energy_rate;
    capacity[period] "Combined rated power of the online units" IS_A energy_rate;
    E "Electrical energy generated over the horizon" IS_A energy;
    running, starting, cost "Operating, startup and total costs over the horizon" IS_A monetary_unit;

    FOR p IN period CREATE
        installed[p]: on[p] <= n;
        minimum[p]: P[p] >= pmin*on[p];
        rating[p]: capacity[p] = pmax*on[p];
        maximum[p]: P[p] <= capacity[p];
    END FOR;
    (* No minimum up/down times, ramp limits, startup delay or shutdown charge.
       A positive startup cost makes start equal the positive increase in on
       at an optimum. Initially-online units may shut down without a charge. *)
    initial: start[1] >= on[1] - n0;
    FOR p IN [2..T] CREATE
        transition[p]: start[p] >= on[p] - on[p-1];
    END FOR;
    (* Power is constant within a period. MW*h is energy, not power; the
       base rate already includes generation at pmin for EACH online unit. *)
    energy_total: E = SUM[dt[p]*P[p] | p IN period];
    running_cost: running = SUM[dt[p]*(base*on[p]
        + marginal*(P[p] - pmin*on[p])) | p IN period];
    (* Startups are events, so their cost is NOT multiplied by duration. *)
    starting_cost: starting = startup*SUM[start[p] | p IN period];
    accounting: cost = running + starting;

METHODS
METHOD self_test;
    FOR p IN period DO
        ASSERT dt[p] > 0{s};
        ASSERT on[p] >= -1e-7 AND on[p] <= n + 1e-7;
        ASSERT start[p] >= -1e-7;
        ASSERT CARD[k IN [0..n] | abs(on[p] - k) < 1e-7] = 1;
        ASSERT CARD[k IN [0..n] | abs(start[p] - k) < 1e-7] = 1;
        ASSERT P[p] >= pmin*on[p] - 1e-6{MW};
        ASSERT abs((capacity[p] - pmax*on[p])/1{MW}) < 1e-6;
        ASSERT P[p] <= capacity[p] + 1e-6{MW};
    END FOR;
    ASSERT start[1] >= on[1] - n0 - 1e-7;
    ASSERT abs(start[1]) < 1e-7 OR abs(start[1] - on[1] + n0) < 1e-7;
    FOR p IN [2..T] DO
        ASSERT start[p] >= on[p] - on[p-1] - 1e-7;
        ASSERT abs(start[p]) < 1e-7 OR abs(start[p] - on[p] + on[p-1]) < 1e-7;
    END FOR;
    ASSERT abs((E - SUM[dt[p]*P[p] | p IN period])/1{MWh}) < 1e-6;
    ASSERT abs((running - SUM[dt[p]*(base*on[p]
        + marginal*(P[p] - pmin*on[p])) | p IN period])/1{USD}) < 1e-4;
    ASSERT abs((starting - startup*SUM[start[p] | p IN period])/1{USD}) < 1e-4;
    ASSERT abs((cost - running - starting)/1{USD}) < 1e-4;
END self_test;
END thermal_generator_group;

MODEL electrical_power_1;
    T "Number of unequal-duration periods in the day" IS_A integer_constant;
    T :== 5;
    period "Consecutive operating periods" IS_A set OF integer_constant;
    period :== [1..T];
    dt[period] "Duration of each constant-load period" IS_A time_constant;
    demand[period] "Forecast electrical power, NOT energy per period" IS_A uc_power_constant;
    reserve "Fractional reserve margin above forecast power" IS_A factor_constant;
    reserve :== 0.15;
    supply[period] "Total dispatched electrical power" IS_A energy_rate;
    E "Total electrical energy generated in the day" IS_A energy;
    cost "Total daily operating and startup cost" IS_A monetary_unit;

    (* 00:00-06:00, 06:00-09:00, 09:00-15:00, 15:00-18:00, 18:00-24:00.
       The source table's '12 pm' endpoints mean midnight, not noon. *)
    TABLE dt[period] UNITS {h};
        1, 2, 3, 4, 5;
        6, 3, 6, 3, 6;
    END TABLE;
    TABLE demand[period] UNITS {MW};
            1,     2,     3,     4,     5;
        15000, 30000, 25000, 40000, 27000;
    END TABLE;

    (* Each instance is a fleet of identical machines, not a single machine.
       Parameters: periods, durations, installed, initially on,
                   minimum MW, maximum MW, base USD/h, extra USD/MWh, startup USD.
       The notebook grants FIVE initially-online units of EACH type. *)
    type0 IS_A thermal_generator_group(T, dt, 12, 5,
        850{MW}, 2000{MW}, 1000{USD/h}, 2{USD/MWh}, 2000{USD});
    type1 IS_A thermal_generator_group(T, dt, 10, 5,
        1250{MW}, 1750{MW}, 2600{USD/h}, 1.3{USD/MWh}, 1000{USD});
    type2 IS_A thermal_generator_group(T, dt, 5, 5,
        1500{MW}, 4000{MW}, 3000{USD/h}, 3{USD/MWh}, 500{USD});
    g[kind] ALIASES (type0, type1, type2)
        WHERE kind IS_A set OF integer_constant WITH_VALUE([0..2]);

    FOR p IN period CREATE
        dispatch[p]: supply[p] = SUM[g[k].P[p] | k IN kind];
        (* Source uses >=, allowing surplus generation (implicit disposal).
           Demand is met exactly at this data set's optimum. *)
        meet_demand[p]: supply[p] >= demand[p];
        (* Only ONLINE capacity counts: reserve is headroom, not generated
           energy. This idealisation ignores ramp/deliverability limits. *)
        reserve_capacity[p]: SUM[g[k].capacity[p] | k IN kind] >= (1 + reserve)*demand[p];
    END FOR;
    energy_total: E = SUM[g[k].E | k IN kind];
    accounting: cost = SUM[g[k].cost | k IN kind];
    obj: MINIMIZE cost;

METHODS
METHOD on_load;
    SOLVER Gurobi;
    OPTION mip_rel_gap 0.0;
END on_load;
METHOD self_test;
    (* Published optimum, plus an independent power-to-energy check. *)
    ASSERT abs((cost - 1002540{USD})/1{USD}) < 1e-4;
    ASSERT abs((E - 612000{MWh})/1{MWh}) < 1e-5;
    ASSERT abs((SUM[dt[p] | p IN period] - 24{h})/1{s}) < 1e-7;
    FOR k IN kind DO RUN g[k].self_test; END FOR;
    FOR p IN period DO
        ASSERT abs((supply[p] - demand[p])/1{MW}) < 1e-6;
        ASSERT abs((supply[p] - SUM[g[k].P[p] | k IN kind])/1{MW}) < 1e-6;
        ASSERT SUM[g[k].capacity[p] | k IN kind] >= (1 + reserve)*demand[p] - 1e-6{MW};
    END FOR;
    ASSERT abs((E - SUM[dt[p]*supply[p] | p IN period])/1{MWh}) < 1e-5;
    ASSERT abs((cost - SUM[g[k].cost | k IN kind])/1{USD}) < 1e-4;
END self_test;
END electrical_power_1;

MODEL electrical_power_1_highs REFINES electrical_power_1;
METHODS
METHOD on_load;
    SOLVER HiGHS;
    OPTION mip_rel_gap 0.0;
END on_load;
END electrical_power_1_highs;
