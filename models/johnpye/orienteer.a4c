REQUIRE "atoms.a4l";

	(* Orienteering Problem (single-path variant) on instance set_61_1_45.

   Instance format:
   - first point is start node
   - second point is end node
   - Euclidean travel distance with Tmax = 45

	   Implementation detail:
	   - Distances are computed from the coordinate TABLE at instantiation time.
	     Values are stored as real millidistance (distance * 1000) so the model
	     remains linear while avoiding a large precomputed TABLE.
	*)
MODEL orienteer;
	n_nodes IS_A integer_constant;
	start IS_A integer_constant;
	finish IS_A integer_constant;
	tmax_milli IS_A integer_constant;
	mtz_M IS_A integer_constant;

	nodes IS_A set OF integer_constant;
	middle IS_A set OF integer_constant;
	fields IS_A set OF symbol_constant;

	point[nodes][fields] IS_A integer_constant;
	dist_milli[nodes][nodes] IS_A real_constant;

	use_arc[nodes][nodes] IS_A solver_binary;
	visit[nodes] IS_A solver_binary;
	order[middle] IS_A solver_var;

	n_nodes :== 64;
	start :== 1;
	finish :== 2;
	tmax_milli :== 45000;
	mtz_M :== 64;

	nodes :== [1..64];
	middle :== [3..64];
	fields :== ['x','y','score'];

	TABLE point[nodes,fields];
		x,y,score;
		1,0,-7,0;
		2,0,7,0;
		3,-1,-6,6;
		4,1,-6,6;
		5,-2,-5,12;
		6,0,-5,6;
		7,2,-5,12;
		8,-3,-4,18;
		9,-1,-4,12;
		10,1,-4,12;
		11,3,-4,18;
		12,-4,-3,24;
		13,-2,-3,18;
		14,0,-3,12;
		15,2,-3,18;
		16,4,-3,24;
		17,-5,-2,30;
		18,-3,-2,24;
		19,-1,-2,18;
		20,1,-2,18;
		21,3,-2,24;
		22,5,-2,30;
		23,-6,-1,36;
		24,-4,-1,30;
		25,-2,-1,24;
		26,0,-1,18;
		27,2,-1,24;
		28,4,-1,30;
		29,6,-1,36;
		30,-7,0,42;
		31,-5,0,36;
		32,-3,0,30;
		33,-1,0,24;
		34,1,0,24;
		35,3,0,30;
		36,5,0,36;
		37,7,0,42;
		38,-6,1,36;
		39,-4,1,30;
		40,-2,1,24;
		41,0,1,18;
		42,2,1,24;
		43,4,1,30;
		44,6,1,36;
		45,-5,2,30;
		46,-3,2,24;
		47,-1,2,18;
		48,1,2,18;
		49,3,2,24;
		50,5,2,30;
		51,-4,3,24;
		52,-2,3,18;
		53,0,3,12;
		54,2,3,18;
		55,4,3,24;
		56,-3,4,18;
		57,-1,4,12;
		58,1,4,12;
		59,3,4,18;
		60,-2,5,12;
		61,0,5,6;
		62,2,5,12;
		63,-1,6,6;
		64,1,6,6;
	END TABLE;

	FOR i IN nodes CREATE
		FOR j IN nodes CREATE
			dist_milli[i][j] :== 1000*sqrt(
				sqr(point[i]['x'] - point[j]['x']) +
				sqr(point[i]['y'] - point[j]['y'])
			);
		END FOR;
	END FOR;

	start_out: SUM[use_arc[start][j] | j IN nodes] = 1;
	start_in: SUM[use_arc[i][start] | i IN nodes] = 0;
	finish_in: SUM[use_arc[i][finish] | i IN nodes] = 1;
	finish_out: SUM[use_arc[finish][j] | j IN nodes] = 0;

	FOR k IN middle CREATE
		in_deg[k]: SUM[use_arc[i][k] | i IN nodes] = visit[k];
		out_deg[k]: SUM[use_arc[k][j] | j IN nodes] = visit[k];

		order_lb[k]: order[k] >= visit[k];
		order_ub[k]: order[k] <= (mtz_M - 1)*visit[k];
	END FOR;

	FOR i IN middle CREATE
		FOR j IN middle CREATE
			mtz[i][j]: order[i] - order[j] + 1 <= mtz_M*(1 - use_arc[i][j]);
		END FOR;
	END FOR;

	budget:
		SUM[ SUM[dist_milli[i][j]*use_arc[i][j] | j IN nodes] | i IN nodes ] <= tmax_milli;

	fix_start_visit: visit[start] = 1;
	fix_finish_visit: visit[finish] = 1;

	obj: MINIMIZE -SUM[point[i]['score']*visit[i] | i IN nodes];

METHODS

METHOD bound_self;
	FOR i IN nodes DO
		use_arc[i][i].lower_bound := 0;
		use_arc[i][i].upper_bound := 0;

		use_arc[i][start].lower_bound := 0;
		use_arc[i][start].upper_bound := 0;

		use_arc[finish][i].lower_bound := 0;
		use_arc[finish][i].upper_bound := 0;
	END FOR;

	visit[start].lower_bound := 1;
	visit[start].upper_bound := 1;
	visit[finish].lower_bound := 1;
	visit[finish].upper_bound := 1;
END bound_self;

METHOD default_self;
	FOR i IN nodes DO
		visit[i] := 0;
		FOR j IN nodes DO
			use_arc[i][j] := 0;
		END FOR;
	END FOR;

	visit[start] := 1;
	visit[finish] := 1;
	use_arc[start][finish] := 1;

	FOR i IN middle DO
		order[i] := 0;
	END FOR;
END default_self;

METHOD on_load;
	RUN bound_self;
	RUN default_self;
	SOLVER HiGHS;
END on_load;

END orienteer;
