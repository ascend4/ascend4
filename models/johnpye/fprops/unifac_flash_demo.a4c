REQUIRE "johnpye/fprops/unifac_flash.a4l";
REQUIRE "thermodynamics.a4l";
REQUIRE "flash.a4l";

MODEL test_fprops_unifac_gamma_ddbst_ethanol_water REFINES cmumodel;
	cd IS_A components_data(['water','ethanol'], 'water');
	ug IS_A fprops_unifac_gamma_state(cd);

METHODS
	METHOD default_self;
		RUN ug.default_self;
	END default_self;

	METHOD values;
		ug.T := 298 {K};
		ug.x['water'] := 0.5;
		ug.x['ethanol'] := 0.5;
	END values;

	METHOD specify;
		FIX ug.T;
		FIX ug.x[cd.other_components];
	END specify;

	METHOD on_load;
		RUN default_self;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;

	METHOD self_test;
		ASSERT abs(ug.gamma['ethanol'] - 1.2036) < 5e-4;
		ASSERT abs(ug.gamma['water'] - 1.4968) < 5e-4;
	END self_test;
END test_fprops_unifac_gamma_ddbst_ethanol_water;

MODEL test_fprops_unifac_blackbox_ethanol_water REFINES cmumodel;
	cd IS_A components_data(['water','ethanol'], 'water');
	fp IS_A fprops_unifac_flash_state(cd);

METHODS
	METHOD default_self;
		RUN fp.default_self;
	END default_self;

	METHOD values;
		fp.T := 360 {K};
		fp.P := 1 {atm};
		fp.z['water'] := 0.6;
		fp.z['ethanol'] := 0.4;
	END values;

	METHOD specify;
		FIX fp.T;
		FIX fp.P;
		FIX fp.z[cd.other_components];
	END specify;

	METHOD on_load;
		RUN default_self;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;

	METHOD self_test;
		ASSERT fp.beta > 0;
		ASSERT fp.beta < 1;
		ASSERT abs(fp.x['water'] + fp.x['ethanol'] - 1) < 1e-9;
		ASSERT abs(fp.y['water'] + fp.y['ethanol'] - 1) < 1e-9;
	END self_test;
END test_fprops_unifac_blackbox_ethanol_water;

MODEL test_fprops_flash_blackbox_ethanol_water REFINES cmumodel;
	cd IS_A components_data(['water','ethanol'], 'water');
	fp IS_A fprops_flash_state(cd);
	ref IS_A fprops_unifac_flash_state(cd);

METHODS
	METHOD default_self;
		RUN fp.default_self;
		RUN ref.default_self;
	END default_self;

	METHOD values;
		fp.T := 360 {K};
		fp.P := 1 {atm};
		fp.z['water'] := 0.6;
		fp.z['ethanol'] := 0.4;
		ref.T := fp.T;
		ref.P := fp.P;
		ref.z['water'] := fp.z['water'];
		ref.z['ethanol'] := fp.z['ethanol'];
	END values;

	METHOD specify;
		FIX fp.T;
		FIX fp.P;
		FIX fp.z[cd.other_components];
		FIX ref.T;
		FIX ref.P;
		FIX ref.z[cd.other_components];
	END specify;

	METHOD on_load;
		RUN default_self;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;

	METHOD self_test;
		ASSERT abs(fp.beta - ref.beta) < 1e-10;
		ASSERT abs(fp.x['water'] - ref.x['water']) < 1e-10;
		ASSERT abs(fp.x['ethanol'] - ref.x['ethanol']) < 1e-10;
		ASSERT abs(fp.y['water'] - ref.y['water']) < 1e-10;
		ASSERT abs(fp.y['ethanol'] - ref.y['ethanol']) < 1e-10;
	END self_test;
END test_fprops_flash_blackbox_ethanol_water;

MODEL test_fprops_unifac_phase_eq_ethanol_water REFINES cmumodel;
	cd IS_A components_data(['water','ethanol'], 'water');
	fp IS_A fprops_unifac_flash_state(cd);
	vm IS_A ideal_vapor_mixture(cd);
	lm IS_A UNIFAC_liquid_mixture(cd);

	Tv ALIASES vm.T;
	Pv ALIASES vm.P;
	Tl ALIASES lm.T;
	Pl ALIASES lm.P;

	Tv = fp.T;
	Pv = fp.P;
	Tl = fp.T;
	Pl = fp.P;

	FOR i IN cd.components CREATE
		yv[i]: vm.y[i] = fp.y[i];
		xl[i]: lm.y[i] = fp.x[i];
	END FOR;

METHODS
	METHOD default_self;
		RUN fp.default_self;
		RUN vm.default_self;
		RUN lm.default_self;
	END default_self;

	METHOD values;
		fp.T := 360 {K};
		fp.P := 1 {atm};
		fp.z['water'] := 0.6;
		fp.z['ethanol'] := 0.4;
	END values;

	METHOD specify;
		FIX fp.T;
		FIX fp.P;
		FIX fp.z[cd.other_components];
	END specify;

	METHOD on_load;
		RUN default_self;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;

	METHOD self_test;
		ASSERT abs(vm.partial['water'].g - lm.partial['water'].g) < 2e-2 {J/mol};
		ASSERT abs(vm.partial['ethanol'].g - lm.partial['ethanol'].g) < 2e-2 {J/mol};
	END self_test;
END test_fprops_unifac_phase_eq_ethanol_water;

(* Probe only: the legacy vapor_liquid_flash wrapper is currently
 * row-rank-deficient for this fixed-T fixed-P specification under QRSlv,
 * so this model is kept for manual investigation rather than gating tests.
 *)
MODEL probe_fprops_unifac_against_flash_ethanol_water REFINES cmumodel;
	cd IS_A components_data(['water','ethanol'], 'water');
	pdV IS_A phases_data('V', 'ideal_vapor_mixture', 'none', 'none');
	pdL IS_A phases_data('L', 'none', 'UNIFAC_liquid_mixture', 'none');
	feed_equilibrated IS_A boolean;
	flash_equilibrated IS_A boolean;
	Qin IS_A energy_rate;

	feed IS_A stream(cd, pdV, feed_equilibrated);
	liq IS_A stream(cd, pdL, flash_equilibrated);
	vap IS_A stream(cd, pdV, flash_equilibrated);
	fl1 IS_A vapor_liquid_flash(Qin, flash_equilibrated, feed, vap, liq);
	fp IS_A fprops_unifac_flash_state(cd);

	Tlink: fp.T = fl1.T;
	Plink: fp.P = fl1.P;
	FOR i IN cd.other_components CREATE
		zlink[i]: fp.z[i] = feed.y[i];
	END FOR;

METHODS
	METHOD default_self;
		RUN feed.default_self;
		RUN liq.default_self;
		RUN vap.default_self;
		RUN fl1.default_self;
		RUN fp.default_self;
	END default_self;

	METHOD values;
		feed.P := 1 {atm};
		feed.T := 360 {K};
		feed.f['ethanol'] := 0.4 {mol/s};
		feed.f['water'] := 0.6 {mol/s};
		fl1.alpha['ethanol'] := 2;
		fl1.alpha['water'] := 1;
		fl1.P := 1 {atm};
		fl1.T := 360 {K};
		feed_equilibrated := FALSE;
		flash_equilibrated := TRUE;
		Qin := 0 {W};
	END values;

	METHOD specify_mass_balance;
		flash_equilibrated := FALSE;
		RUN fl1.specify;
		fl1.state.phase_fraction['vapor'] := 0.5;
		FIX fl1.P;
		FIX fl1.T;
	END specify_mass_balance;

	METHOD specify_full_thermo;
		flash_equilibrated := TRUE;
		RUN fl1.reset_to_fullthermo;
		FIX fl1.P;
		FIX fl1.T;
	END specify_full_thermo;

	METHOD compare;
		ASSERT abs(fp.beta - fl1.state.phase_fraction['vapor']) < 1e-7;
		ASSERT abs(fp.x['water'] - liq.y['water']) < 1e-7;
		ASSERT abs(fp.x['ethanol'] - liq.y['ethanol']) < 1e-7;
		ASSERT abs(fp.y['water'] - vap.y['water']) < 1e-7;
		ASSERT abs(fp.y['ethanol'] - vap.y['ethanol']) < 1e-7;
	END compare;

END probe_fprops_unifac_against_flash_ethanol_water;
