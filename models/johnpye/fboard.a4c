REQUIRE "johnpye/thermo_types.a4c";
(*
	Working on a model of gas diffusion through a TGA freeboard
*)

ATOM energy_per_temperature REFINES solver_var 
	DIMENSION L^2/T^2*M/TMP
	DEFAULT 1e-23 {J/K};
	lower_bound := -1 {J/K};
	upper_bound := +1 {J/K};
	nominal := 1e-23 {J/K};
END energy_per_temperature;


MODEL chapman_enskog_diffusion;
	T IS_A temperature;
	p IS_A pressure;

	M_i, M_j IS_A molar_mass;

	sigma_i, sigma_j IS_A distance;
	eps_i, eps_j IS_A energy_per_temperature;

	(* Mixing rules *)
	sigma_ij IS_A distance;
	sigma_ij = (sigma_i + sigma_j)/2;

	eps_ij IS_A energy_per_temperature;
	eps_ij = sqrt(eps_i * eps_j);

	(* Reduced temperature *)
	T_star IS_A factor;
	T_star = T / (eps_ij / 1{BOLTZMANN_C});

	(* Collision integral (Neufeld correlation) *)
	Omega_D IS_A factor;
	Omega_eq: Omega_D = 1.06036 / (T_star 	^ 0.15610) + 0.19300 / exp(0.47635 * T_star) + 1.03587 / exp(1.52996 * T_star) + 1.76474 / exp(3.89411 * T_star);	

	(* Output *)
	D_ij IS_A diffusivity;

	(* Chapman–Enskog diffusivity *)
	Dij_eq: D_ij = (3.0 / (16.0 * p * sigma_ij^2))  * sqrt( (2{PI} * 1{BOLTZMANN_C}^3 * T^3) * (1.0/M_i + 1.0/M_j) ) / Omega_D;
	
	(* Fuller–Schettler–Giddings *)
	D_ij_FSG IS_A diffusivity;

	V_i, V_j IS_A factor;  (* Fuller diffusion volumes, used as correlation numbers *)

	Dij_FSG_eq:
	  D_ij_FSG
	  = 0.00143{cm^2/s}
	  * (T / 1{K})^1.75
	  * sqrt(1{g/g_mole}/M_i + 1{g/g_mole}/M_j)
	  / (
		  (p / 1{atm})
		  * (V_i^(1/3) + V_j^(1/3))^2
		);

METHODS
	METHOD on_load;
		FIX T, p, M_i, M_j;
		FIX T := 300 {K};
		FIX p := 1 {bar};
		FIX M_i := 18.015 {kg/kmol};
		FIX M_j := 1.008 {kg/kmol};
		FIX V_i := 13.1; (* H2O *)
		FIX V_j := 6.12; (* H2 *)
			
		FIX sigma_i := 2.641{angstrom}; (* H2O *)
		FIX sigma_j := 2.92{angstrom}; (* H2 *)
		FIX eps_i := 809.1{BOLTZMANN_C};
		FIX eps_j := 59.7{BOLTZMANN_C};
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
	END on_load;
END chapman_enskog_diffusion;


