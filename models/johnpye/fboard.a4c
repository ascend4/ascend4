REQUIRE "johnpye/thermo_types.a4c";
IMPORT "johnpye/extpy/extpy";
IMPORT "johnpye/fboard_plot";
(*
	Working on a model of gas diffusion through a TGA freeboard
*)

ATOM molar_flux REFINES solver_var
	DIMENSION Q/T/L^2
	DEFAULT 0.01 {mol/m^2/s};
	lower_bound := -1e6 {mol/m^2/s};
	upper_bound := 1e6 {mol/m^2/s};
	nominal := 0.01 {mol/m^2/s};
END molar_flux;

ATOM molar_flux_per_pressure REFINES solver_var
	DIMENSION Q*T/M/L
	DEFAULT 1e-6 {mol/m^2/s/Pa};
	lower_bound := 0 {mol/m^2/s/Pa};
	upper_bound := 1e6 {mol/m^2/s/Pa};
	nominal := 1e-6 {mol/m^2/s/Pa};
END molar_flux_per_pressure;

MODEL diffusion_binary_species_data;
	species IS_A set OF symbol_constant;
	fields IS_A set OF symbol_constant;

	species :== ['H2O','H2','Ar'];
	fields :== ['MW_kg_per_kmol','sigma_angstrom','eps_over_k_K','fuller_volume'];

	data[species][fields] IS_A factor_constant;
	(*
		Column units:
		- MW_kg_per_kmol in kg/kmol
		- sigma_angstrom in angstrom
		- eps_over_k_K in K
		- fuller_volume dimensionless

		Data sources:
		- Molecular weights: NIST Chemistry WebBook entries for water,
		  hydrogen, and argon.
		- Lennard-Jones sigma and epsilon/k: Reid, Prausnitz and Poling,
		  The Properties of Gases and Liquids, Appendix B transport-property
		  table (online PSU-hosted scan).
		- Fuller diffusion volumes: COMSOL Liquid and Gas Properties Module
		  User's Guide, Fuller-Schettler-Giddings diffusion-volume table.
	*)
	TABLE data[species,fields];
		    MW_kg_per_kmol sigma_angstrom eps_over_k_K fuller_volume
		H2O    18.01528       2.641       809.1           13.1
		H2      2.01588       2.827        59.7           6.12
		Ar     39.948         3.542        93.3           16.2
	END TABLE;
END diffusion_binary_species_data;


MODEL diffusion_binary(
	species_i WILL_BE symbol_constant;
	species_j WILL_BE symbol_constant;
);
	T IS_A temperature;
	p IS_A pressure;

	db IS_A diffusion_binary_species_data;

	M_i, M_j IS_A molar_mass;
	sigma_i, sigma_j IS_A distance;
	eps_over_k_i, eps_over_k_j IS_A temperature;

	(* Fuller diffusion volumes, used as correlation numbers *)
	V_i, V_j IS_A factor;

	Mi_eq: M_i = db.data[species_i]['MW_kg_per_kmol'] * 1{kg/kmol};
	Mj_eq: M_j = db.data[species_j]['MW_kg_per_kmol'] * 1{kg/kmol};
	sigma_i_eq: sigma_i = db.data[species_i]['sigma_angstrom'] * 1{angstrom};
	sigma_j_eq: sigma_j = db.data[species_j]['sigma_angstrom'] * 1{angstrom};
	eps_over_k_i_eq: eps_over_k_i = db.data[species_i]['eps_over_k_K'] * 1{K};
	eps_over_k_j_eq: eps_over_k_j = db.data[species_j]['eps_over_k_K'] * 1{K};
	V_i_eq: V_i = db.data[species_i]['fuller_volume'];
	V_j_eq: V_j = db.data[species_j]['fuller_volume'];

	(* Mixing rules *)
	sigma_ij IS_A distance;
	sigma_mix: sigma_ij = (sigma_i + sigma_j)/2;

	eps_over_k_ij IS_A temperature;
	eps_mix: eps_over_k_ij = sqrt(eps_over_k_i * eps_over_k_j);

	(* Reduced temperature *)
	T_star IS_A factor;
	Tstar_eq: T_star = T / eps_over_k_ij;

	(* Collision integral (Neufeld correlation) *)
	Omega_D IS_A factor;
	Omega_eq: Omega_D = 1.06036 / (T_star ^ 0.15610) + 0.19300 / exp(0.47635 * T_star) + 1.03587 / exp(1.52996 * T_star) + 1.76474 / exp(3.89411 * T_star);

	(* Outputs *)
	D_ij IS_A diffusivity;
	D_ij_FSG IS_A diffusivity;

	(* Chapman-Enskog diffusivity.
	   Use molar masses here, so one Boltzmann factor is replaced by R = N_A k_B. *)
	Dij_eq: D_ij = (3.0 / (16.0 * p * sigma_ij^2)) * sqrt((2{PI} * 1{GAS_C} * 1{BOLTZMANN_C}^2 * T^3) * (1.0/M_i + 1.0/M_j)) / Omega_D;

	(* Fuller-Schettler-Giddings *)
	Dij_FSG_eq:
	  D_ij_FSG
	  = 0.00143{cm^2/s}
	  * (T / 1{K})^1.75
	  * sqrt(1{g/g_mole}/M_i + 1{g/g_mole}/M_j)
	  / (
		  (p / 1{atm})
		  * (V_i^(1/3) + V_j^(1/3))^2
		);

METHODS
	METHOD on_load;
		FIX T, p;
		T := 300 {K};
		p := 1 {bar};
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;
END diffusion_binary;


MODEL diffusion_h2o_h2_ar;
	components IS_A set OF symbol_constant;
	components :== ['H2O','H2','Ar'];

	H2O_name, H2_name, Ar_name IS_A symbol_constant;
	H2O_name :== 'H2O';
	H2_name :== 'H2';
	Ar_name :== 'Ar';

	T IS_A temperature;
	p IS_A pressure;

	h2o_h2 IS_A diffusion_binary(H2O_name, H2_name);
	h2o_ar IS_A diffusion_binary(H2O_name, Ar_name);
	h2_ar IS_A diffusion_binary(H2_name, Ar_name);

	D_H2O_H2 IS_A diffusivity;
	D_H2O_Ar IS_A diffusivity;
	D_H2_Ar IS_A diffusivity;

	D[components][components] IS_A diffusivity;

	h2o_h2_T: h2o_h2.T = T;
	h2o_h2_p: h2o_h2.p = p;
	h2o_ar_T: h2o_ar.T = T;
	h2o_ar_p: h2o_ar.p = p;
	h2_ar_T: h2_ar.T = T;
	h2_ar_p: h2_ar.p = p;

	D_H2O_H2_eq: D_H2O_H2 = h2o_h2.D_ij;
	D_H2O_Ar_eq: D_H2O_Ar = h2o_ar.D_ij;
	D_H2_Ar_eq: D_H2_Ar = h2_ar.D_ij;

	D_h2o_h2_eq: D['H2O']['H2'] = D_H2O_H2;
	D_h2_h2o_eq: D['H2']['H2O'] = D_H2O_H2;
	D_h2o_ar_eq: D['H2O']['Ar'] = D_H2O_Ar;
	D_ar_h2o_eq: D['Ar']['H2O'] = D_H2O_Ar;
	D_h2_ar_eq: D['H2']['Ar'] = D_H2_Ar;
	D_ar_h2_eq: D['Ar']['H2'] = D_H2_Ar;

	D_h2o_h2o_eq: D['H2O']['H2O'] = 0 {m^2/s};
	D_h2_h2_eq: D['H2']['H2'] = 0 {m^2/s};
	D_ar_ar_eq: D['Ar']['Ar'] = 0 {m^2/s};

METHODS
	METHOD on_load;
		FIX T, p;
		T := 300 {K};
		p := 1 {bar};
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;
END diffusion_h2o_h2_ar;


MODEL freeboard_1d_stagnant_transport(
	n_segs WILL_BE integer_constant;
);
	nodes IS_A set OF integer_constant;
	nodes :== [0..n_segs];
	faces IS_A set OF integer_constant;
	faces :== [1..n_segs];

	T IS_A temperature;
	p IS_A pressure;
	L IS_A distance;
	dz IS_A distance;

	z[nodes] IS_A distance;

	c_tot IS_A molar_density;

	y_H2_top, y_H2O_top, y_Ar_top IS_A mole_fraction;

	y_H2[nodes] IS_A mole_fraction;
	y_H2O[nodes] IS_A mole_fraction;
	y_Ar[nodes] IS_A mole_fraction;

	y_H2_face[faces] IS_A mole_fraction;
	y_H2O_face[faces] IS_A mole_fraction;
	y_Ar_face[faces] IS_A mole_fraction;

	tr IS_A diffusion_h2o_h2_ar;
	D_H2O_H2[faces] IS_A diffusivity;
	D_H2O_Ar[faces] IS_A diffusivity;
	D_H2_Ar[faces] IS_A diffusivity;

	N_H2 IS_A molar_flux;
	N_H2O IS_A molar_flux;
	N_Ar IS_A molar_flux;

	ctot_eq: c_tot = p / (1{GAS_C} * T);

	tr_T: tr.T = T;
	tr_p: tr.p = p;

	top_sum_eq: y_Ar_top = 1 - y_H2_top - y_H2O_top;

	SELECT (n_segs)
	CASE 0:
		dz_eq_zero: dz = 0 {mm};
	OTHERWISE:
		dz_eq: dz = L / n_segs;
	END SELECT;

	FOR i IN nodes CREATE
		z_eqn[i]: z[i] = i * dz;
		sum_y[i]: y_Ar[i] = 1 - y_H2[i] - y_H2O[i];
	END FOR;

	top_h2: y_H2[0] = y_H2_top;
	top_h2o: y_H2O[0] = y_H2O_top;

	FOR f IN faces CREATE
		face_h2_eq[f]:
			y_H2_face[f] = 0.5 * (y_H2[f - 1] + y_H2[f]);
		face_h2o_eq[f]:
			y_H2O_face[f] = 0.5 * (y_H2O[f - 1] + y_H2O[f]);
		face_ar_eq[f]:
			y_Ar_face[f] = 1 - y_H2_face[f] - y_H2O_face[f];

		D_h2o_h2_eq[f]:
			D_H2O_H2[f] = tr.D_H2O_H2;
		D_h2o_ar_eq[f]:
			D_H2O_Ar[f] = tr.D_H2O_Ar;
		D_h2_ar_eq[f]:
			D_H2_Ar[f] = tr.D_H2_Ar;

		ms_h2[f]:
			-c_tot * (y_H2[f] - y_H2[f - 1]) / dz
			=
			(y_H2O_face[f] * N_H2 - y_H2_face[f] * N_H2O) / D_H2O_H2[f]
			+ (y_Ar_face[f] * N_H2 - y_H2_face[f] * N_Ar) / D_H2_Ar[f];
		ms_h2o[f]:
			-c_tot * (y_H2O[f] - y_H2O[f - 1]) / dz
			=
			(y_H2_face[f] * N_H2O - y_H2O_face[f] * N_H2) / D_H2O_H2[f]
			+ (y_Ar_face[f] * N_H2O - y_H2O_face[f] * N_Ar) / D_H2O_Ar[f];
	END FOR;

	Nar_eq: N_Ar = -N_H2 - N_H2O;

METHODS
	METHOD values;
		T := 900 {K};
		p := 1 {bar};
		L := 5 {mm};
		y_H2_top := 0.8;
		y_H2O_top := 0.0;

		SWITCH (n_segs)
		CASE 0:
			y_H2[0] := y_H2_top;
			y_H2O[0] := y_H2O_top;
			y_Ar[0] := 1 - y_H2[0] - y_H2O[0];
			z[0] := 0 {mm};
		OTHERWISE:
			FOR i IN nodes DO
				y_H2[i] := y_H2_top - 0.03 * i / n_segs;
				y_H2O[i] := y_H2O_top + 0.03 * i / n_segs;
				y_Ar[i] := 1 - y_H2[i] - y_H2O[i];
				z[i] := i * 1.0 * L / n_segs;
			END FOR;
			FOR f IN faces DO
				y_H2_face[f] := 0.5 * (y_H2[f - 1] + y_H2[f]);
				y_H2O_face[f] := 0.5 * (y_H2O[f - 1] + y_H2O[f]);
				y_Ar_face[f] := 1 - y_H2_face[f] - y_H2O_face[f];
				D_H2O_H2[f] := 7 {cm^2/s};
				D_H2O_Ar[f] := 2 {cm^2/s};
				D_H2_Ar[f] := 7 {cm^2/s};
			END FOR;
		END SWITCH;
		tr.D_H2O_H2 := 7 {cm^2/s};
		tr.D_H2O_Ar := 2 {cm^2/s};
		tr.D_H2_Ar := 7 {cm^2/s};
		N_H2 := 0.08 {mol/m^2/s};
		N_H2O := -0.08 {mol/m^2/s};
		N_Ar := 0 {mol/m^2/s};
	END values;

	METHOD specify;
		FIX T, p, L, y_H2_top, y_H2O_top, N_H2, N_H2O;
		FREE N_Ar;
	END specify;

	METHOD on_load;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;
END freeboard_1d_stagnant_transport;


MODEL freeboard_1d_stagnant_kineq(
	n_segs WILL_BE integer_constant;
);
	nodes IS_A set OF integer_constant;
	nodes :== [0..n_segs];
	faces IS_A set OF integer_constant;
	faces :== [1..n_segs];

	T IS_A temperature;
	p IS_A pressure;
	L IS_A distance;
	dz IS_A distance;

	z[nodes] IS_A distance;

	c_tot IS_A molar_density;

	y_H2[nodes] IS_A mole_fraction;
	y_H2O[nodes] IS_A mole_fraction;
	y_Ar[nodes] IS_A mole_fraction;

	(*
		Face-centred mole fractions are used in the Maxwell-Stefan
		friction terms. For this first implementation, simple arithmetic
		averaging is used between adjacent node values.
	*)
	y_H2_face[faces] IS_A mole_fraction;
	y_H2O_face[faces] IS_A mole_fraction;
	y_Ar_face[faces] IS_A mole_fraction;

	(*
		Binary Chapman-Enskog diffusivities for the H2O/H2/Ar system.
		With isothermal and isobaric assumptions they are uniform here,
		but are exposed as arrays so the face equations read directly.
	*)
	tr IS_A diffusion_h2o_h2_ar;
	D_H2O_H2[faces] IS_A diffusivity;
	D_H2O_Ar[faces] IS_A diffusivity;
	D_H2_Ar[faces] IS_A diffusivity;

	N_H2 IS_A molar_flux;
	N_H2O IS_A molar_flux;
	N_Ar IS_A molar_flux;

	(*
		Literature-based FeO -> Fe hydrogen-reduction coefficient used to
		parameterise the reversible bed-boundary kinetics.

		Liu et al. (Chem. Eng. Sci. 120 (2014) 149-166) propose, for the
		wüstite-to-iron stage in H2 and for 0.05 < X < 0.2, the linear-rate
		expression reported in their Eq. (42). Their Table 5 gives the
		corresponding Arrhenius parameters, after unit conversion, as an
		area-based coefficient with A = 1.8 m/s and E = 62 kJ/mol for H2.
		That fit was reported from experiments at 1073-1223 K, so using it at
		the present 900 K default is an extrapolation.

		The present freeboard model does not yet track solid conversion X at
		the bed. To obtain a single effective boundary coefficient, the
		(X + 0.13) term in Liu et al.'s Eq. (42) is collapsed using a
		representative early FeO -> Fe conversion X_rep = 0.1. This gives
		an effective area-based coefficient:

			k_A_eff = 1.8 * (X_rep + 0.13) * exp(-62 kJ/mol / RT)   [m/s]

		which is then mapped into the present pressure-form boundary law via:

			k_p_lit = k_A_eff / (R T)

		Fradet et al.'s review emphasises that hydrogen reduction kinetics in
		the FeO -> Fe stage are quite dispersed across the literature and are
		strongly affected by H2O inhibition, so this should be treated as a
		first-cut estimate rather than a universal constant.
	*)
	X_rep_FeO_to_Fe IS_A factor_constant;
	X_rep_FeO_to_Fe :== 0.1;
	k_A_FeO_to_Fe_eff IS_A speed;
	k_p_lit IS_A molar_flux_per_pressure;
	k_p_multiplier IS_A positive_factor;

	k_p IS_A molar_flux_per_pressure;
	K_ratio_eq IS_A positive_factor;

	J_forward IS_A molar_flux;
	J_reverse IS_A molar_flux;
	J_net IS_A molar_flux;

	dz_eq: dz = L / n_segs;
	ctot_eq: c_tot = p / (1{GAS_C} * T);

	tr_T: tr.T = T;
	tr_p: tr.p = p;

	kA_lit_eq:
		k_A_FeO_to_Fe_eff
		=
		1.8 {m/s}
		* (X_rep_FeO_to_Fe + 0.13)
		* exp(-62 {kJ/mol} / (1 {GAS_C} * T));
	kp_lit_eq:
		k_p_lit = k_A_FeO_to_Fe_eff / (1 {GAS_C} * T);
	kp_scale_eq:
		k_p = k_p_multiplier * k_p_lit;

	FOR i IN nodes CREATE
		z_eqn[i]: z[i] = i * dz;
		sum_y[i]: y_Ar[i] = 1 - y_H2[i] - y_H2O[i];
	END FOR;

	(* Top-of-freeboard boundary: specified bulk gas composition *)
	top_h2: y_H2[0] = 0.8;
	top_h2o: y_H2O[0] = 0.0;

	FOR f IN faces CREATE
		face_h2_eq[f]:
			y_H2_face[f] = 0.5 * (y_H2[f - 1] + y_H2[f]);
		face_h2o_eq[f]:
			y_H2O_face[f] = 0.5 * (y_H2O[f - 1] + y_H2O[f]);
		face_ar_eq[f]:
			y_Ar_face[f] = 1 - y_H2_face[f] - y_H2O_face[f];

		D_h2o_h2_eq[f]:
			D_H2O_H2[f] = tr.D_H2O_H2;
		D_h2o_ar_eq[f]:
			D_H2O_Ar[f] = tr.D_H2O_Ar;
		D_h2_ar_eq[f]:
			D_H2_Ar[f] = tr.D_H2_Ar;

		(*
			Maxwell-Stefan diffusion at face f.

			The coordinate l increases downward from the top of the freeboard
			toward the reactive bed. Positive molar flux is therefore also
			defined downward. For an ideal gas at constant T and p:

				-c * d(x_i)/dl
					= sum_j!=i (x_j N_i - x_i N_j) / D_ij

			Two independent species equations are sufficient for this ternary
			system because x_H2 + x_H2O + x_Ar = 1 and N_H2 + N_H2O + N_Ar = 0.
		*)
		ms_h2[f]:
			-c_tot * (y_H2[f] - y_H2[f - 1]) / dz
			=
			(y_H2O_face[f] * N_H2 - y_H2_face[f] * N_H2O) / D_H2O_H2[f]
			+ (y_Ar_face[f] * N_H2 - y_H2_face[f] * N_Ar) / D_H2_Ar[f];
		ms_h2o[f]:
			-c_tot * (y_H2O[f] - y_H2O[f - 1]) / dz
			=
			(y_H2_face[f] * N_H2O - y_H2O_face[f] * N_H2) / D_H2O_H2[f]
			+ (y_Ar_face[f] * N_H2O - y_H2O_face[f] * N_Ar) / D_H2O_Ar[f];
	END FOR;

	(* Stagnant-gas assumption: zero total molar flux through the freeboard. *)
	Nar_eq: N_Ar = -N_H2 - N_H2O;

	(* Bed boundary: kineq-style reversible surface flux using partial pressures.
	   Equilibrium is represented by K_ratio_eq = (p_H2O / p_H2)_eq. *)
	Jf_eq: J_forward = k_p * p * y_H2[n_segs];
	Jr_eq: J_reverse = (k_p / K_ratio_eq) * p * y_H2O[n_segs];
	Jnet_eq: J_net = J_forward - J_reverse;

	bed_h2: N_H2 = J_net;
	bed_h2o: N_H2O = -J_net;

METHODS
	METHOD values;
		T := 900 {K};
		p := 1 {bar};
		L := 5 {mm};
		k_p_multiplier := 1;
		k_A_FeO_to_Fe_eff := 1e-4 {m/s};
		k_p_lit := 1e-8 {mol/m^2/s/Pa};
		k_p := 1e-8 {mol/m^2/s/Pa};
		(* Placeholder equilibrium ratio for exploratory runs. *)
		K_ratio_eq := 0.3;

		FOR i IN nodes DO
			y_H2[i] := 0.8 - 0.03 * i / n_segs;
			y_H2O[i] := 0.03 * i / n_segs;
			y_Ar[i] := 1 - y_H2[i] - y_H2O[i];
			z[i] := i * 1.0 * L / n_segs;
		END FOR;
		FOR f IN faces DO
			y_H2_face[f] := 0.5 * (y_H2[f - 1] + y_H2[f]);
			y_H2O_face[f] := 0.5 * (y_H2O[f - 1] + y_H2O[f]);
			y_Ar_face[f] := 1 - y_H2_face[f] - y_H2O_face[f];
			D_H2O_H2[f] := 7 {cm^2/s};
			D_H2O_Ar[f] := 2 {cm^2/s};
			D_H2_Ar[f] := 7 {cm^2/s};
		END FOR;
		tr.D_H2O_H2 := 7 {cm^2/s};
		tr.D_H2O_Ar := 2 {cm^2/s};
		tr.D_H2_Ar := 7 {cm^2/s};
		N_H2 := 0.08 {mol/m^2/s};
		N_H2O := -0.08 {mol/m^2/s};
		N_Ar := 0 {mol/m^2/s};
		J_forward := 0.08 {mol/m^2/s};
		J_reverse := 0.005 {mol/m^2/s};
		J_net := 0.075 {mol/m^2/s};
	END values;

	METHOD specify;
		FIX T, p, L, k_p_multiplier, K_ratio_eq;
	END specify;

	METHOD on_load;
		RUN values;
		RUN specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		SOLVE;
	END on_load;
	METHOD profile_plot;
		EXTERNAL freeboard_plot_profile(SELF);
	END profile_plot;
END freeboard_1d_stagnant_kineq;

MODEL freeboard_1d_stagnant_kineq_demo;
	n_demo IS_A integer_constant;
	n_demo :== 5;
	fb IS_A freeboard_1d_stagnant_kineq(n_demo);
METHODS
	METHOD on_load;
		RUN fb.values;
		RUN fb.specify;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		OPTION iterationlimit 1000;
		(*
			Default post-solve output for './a4 run'. No VARY clause is used, so
			runmodel.py will print this list after the final solve.
		*)
		STUDY
			fb.k_A_FeO_to_Fe_eff, fb.k_p_lit, fb.k_p,
			fb.J_forward, fb.J_reverse, fb.J_net,
			fb.N_H2, fb.N_H2O, fb.N_Ar,
			fb.tr.D_H2O_H2, fb.tr.D_H2O_Ar, fb.tr.D_H2_Ar,
			fb.z[0], fb.z[1], fb.z[2], fb.z[3], fb.z[4], fb.z[5],
			fb.y_H2[0], fb.y_H2[1], fb.y_H2[2], fb.y_H2[3], fb.y_H2[4], fb.y_H2[5],
			fb.y_H2O[0], fb.y_H2O[1], fb.y_H2O[2], fb.y_H2O[3], fb.y_H2O[4], fb.y_H2O[5],
			fb.y_Ar[0], fb.y_Ar[1], fb.y_Ar[2], fb.y_Ar[3], fb.y_Ar[4], fb.y_Ar[5];
	END on_load;
	METHOD profile_plot;
		EXTERNAL freeboard_plot_profile(SELF);
	END profile_plot;
END freeboard_1d_stagnant_kineq_demo;


