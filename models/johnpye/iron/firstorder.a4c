REQUIRE "ivpsystem.a4l";
REQUIRE "atoms.a4l";

(*
	Simple first-order shrinking-core check model.

	Assumptions:
	- spherical particle;
	- surface-reaction-controlled shrinking core;
	- first order in gaseous reductant, with constant bulk gas state folded into
	  k_scm;
	- no product-layer diffusion, film resistance, equilibrium, or heat effects.

	The analytical solution before complete conversion is

		r_core = 1 - k_scm * t
		X = 1 - r_core^3

	where r_core is the unreacted-core radius divided by the initial particle
	radius.  The dynamic model integrates the core-radius ODE and compares the
	result against that analytical expression.
*)

MODEL firstorder_shrinking_core;
	t "time" IS_A time;
	INDEPENDENT t;

	k_scm "shrinking-core front speed divided by initial radius" IS_A frequency;
	tau "complete-conversion time for the analytical solution" IS_A time;

	r_core "dimensionless unreacted-core radius" IS_A fraction;
	X "solid conversion" IS_A fraction;
	r_core_exact "analytical dimensionless unreacted-core radius" IS_A factor;
	X_exact "analytical solid conversion" IS_A factor;
	X_error "dynamic conversion minus analytical conversion" IS_A factor;

	core_ode:
		der(r_core) = -k_scm;
	conversion_eq:
		X = 1 - r_core^3;
	tau_eq:
		tau = 1 / k_scm;
	exact_core_eq:
		r_core_exact = 1 - k_scm * t;
	exact_conversion_eq:
		X_exact = 1 - r_core_exact^3;
	error_eq:
		X_error = X - X_exact;

INITIAL
	r_core_initial:
		r_core = 1;

METHODS
	METHOD values;
		FIX k_scm := 1.0e-3 {1/s};
		t := 0 {s};
		r_core := 1;
		X := 0;
		r_core_exact := 1;
		X_exact := 0;
		X_error := 0;
	END values;

	METHOD bound_self;
		r_core.lower_bound := -1e-8;
		r_core_exact.lower_bound := -1e-8;
		X.lower_bound := -1e-8;
		X.upper_bound := 1 + 1e-8;
		X_exact.lower_bound := -1e-8;
		X_exact.upper_bound := 1 + 1e-8;
	END bound_self;

	METHOD dynamic_reset;
		t := 0 {s};
		r_core := 1;
		X := 0;
		r_core_exact := 1;
		X_exact := 0;
		X_error := 0;
	END dynamic_reset;

	METHOD prepare_dynamic;
		RUN values;
		RUN bound_self;
		RUN dynamic_reset;
		FIX t;
		FREE der(r_core);
		RUN observe_default;
	END prepare_dynamic;

	METHOD observe_default;
		OBSERVE r_core, X, r_core_exact, X_exact, X_error, tau;
	END observe_default;

	METHOD integrate_default;
		RUN prepare_dynamic;
		INTEGRATOR IDA;
		OPTION rtol 1.0e-8;
		INTEGRATE FROM 0 {s} TO 600 {s} STEPS 60;
	END integrate_default;

	METHOD on_load;
		RUN prepare_dynamic;
	END on_load;

	METHOD self_test;
		ASSERT abs(X_error) < 1.0e-7;
	END self_test;
END firstorder_shrinking_core;

(* Short alias so `a4 run johnpye/iron/firstorder.a4c` works directly. *)
MODEL firstorder REFINES firstorder_shrinking_core;
END firstorder;

(*
	Diffusion-controlled spherical shrinking-core check model.

	For product-layer diffusion control, the usual implicit analytical solution
	before complete conversion is

		1 - 3*r_core^2 + 2*r_core^3 = theta
		theta = theta_initial + k_diff * t
		X = 1 - r_core^3

	with r_core = (1 - X)^(1/3).  The derivative dX/dt is singular at zero
	conversion, so this model starts from a tiny positive theta_initial.
*)

MODEL firstorder_shrinking_core_diffusion;
	t "time" IS_A time;
	INDEPENDENT t;

	k_diff "diffusion-controlled shrinking-core rate constant" IS_A frequency;
	tau "complete-conversion time from theta=0" IS_A time;

	theta_initial "small nonzero initial analytical diffusion progress" IS_A factor;
	theta "integrated dimensionless diffusion progress" IS_A factor;
	theta_exact "analytical dimensionless diffusion progress" IS_A factor;
	theta_error "dynamic theta minus analytical theta" IS_A factor;

	r_core "dimensionless unreacted-core radius" IS_A fraction;
	X "solid conversion" IS_A fraction;
	diffusion_function "1 - 3*r_core^2 + 2*r_core^3" IS_A factor;

	core_ode:
		der(r_core) = -k_diff / (6*r_core*(1 - r_core));
	diffusion_function_eq:
		diffusion_function = 1 - 3*r_core^2 + 2*r_core^3;
	progress_eq:
		theta = diffusion_function;
	conversion_eq:
		X = 1 - r_core^3;
	tau_eq:
		tau = 1 / k_diff;
	exact_progress_eq:
		theta_exact = theta_initial + k_diff * t;
	error_eq:
		theta_error = theta - theta_exact;

INITIAL
	theta_initial_eq:
		theta = theta_initial;

METHODS
	METHOD values;
		FIX k_diff := 1.0e-3 {1/s};
		FIX theta_initial := 1.0e-6;
		t := 0 {s};
		theta := 1.0e-6;
		theta_exact := 1.0e-6;
		theta_error := 0;
		r_core := 0.999422537521206;
		X := 0.00173138724020039;
		diffusion_function := 1.0e-6;
	END values;

	METHOD bound_self;
		theta.lower_bound := 0;
		theta.upper_bound := 1 + 1e-8;
		theta_exact.lower_bound := 0;
		theta_exact.upper_bound := 1 + 1e-8;
		r_core.lower_bound := 1e-8;
		r_core.upper_bound := 1;
		X.lower_bound := -1e-8;
		X.upper_bound := 1 + 1e-8;
		diffusion_function.lower_bound := 0;
		diffusion_function.upper_bound := 1 + 1e-8;
	END bound_self;

	METHOD dynamic_reset;
		t := 0 {s};
		theta := 1.0e-6;
		theta_exact := 1.0e-6;
		theta_error := 0;
		r_core := 0.999422537521206;
		X := 0.00173138724020039;
		diffusion_function := 1.0e-6;
	END dynamic_reset;

	METHOD prepare_dynamic;
		RUN values;
		RUN bound_self;
		RUN dynamic_reset;
		FIX t;
		FREE der(r_core);
		r_core.ode_atol := 1.0e-10;
		RUN observe_default;
	END prepare_dynamic;

	METHOD observe_default;
		OBSERVE theta, theta_exact, theta_error, r_core, X, diffusion_function, tau;
	END observe_default;

	METHOD integrate_default;
		RUN prepare_dynamic;
		INTEGRATOR IDA;
		OPTION rtol 1.0e-8;
		INTEGRATE FROM 0 {s} TO 600 {s} STEPS 60;
	END integrate_default;

	METHOD on_load;
		RUN prepare_dynamic;
	END on_load;

	METHOD self_test;
		ASSERT abs(theta_error) < 1.0e-7;
	END self_test;
END firstorder_shrinking_core_diffusion;

MODEL firstorder_diffusion REFINES firstorder_shrinking_core_diffusion;
END firstorder_diffusion;

(* vim: sw=4:noet:ts=4
*)
