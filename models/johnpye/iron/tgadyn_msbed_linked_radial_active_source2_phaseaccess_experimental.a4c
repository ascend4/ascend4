MODEL tgadyn_msbed_linked_radial;
	m IS_A tgadyn_msbed_linked_radial_configurable(10, 5);
	NOTES 'purpose' SELF {
		Experimental linked-radial prototype with configurable shell-local morphology-
		controlled internal diffusion. The default wrapper uses five radial shells.
		}
		'fitting parameters' SELF {
		Active chemistry slots: etak0_1, etak0_2, etak0_3, E_a_1, E_a_2, E_a_3.
		Transport and shell morphology: k_fb_multiplier, k_bed_multiplier,
		k_part_multiplier, eps_bed, tau_bed, Sh_particle, d_int_multiplier, a_open,
		a_close, beta_T, n_close.
		`d_p` remains the measured external particle size, while `d_int_eff =
		d_int_multiplier * d_p` sets the internal radial diffusion length.
		} END NOTES;
	METHODS
	METHOD on_load;
		RUN m.on_load;
	END on_load;
END tgadyn_msbed_linked_radial;

MODEL tgadyn_msbed_linked_radial_porosity;
	m IS_A tgadyn_msbed_linked_radial_porosity_configurable(10, 5);
	NOTES 'purpose' SELF {
		Experimental linked-radial prototype with dynamic shell porosity and blocking
		states (`eps_o`, `phi_b`) controlling internal diffusion.
		}
		'fitting parameters' SELF {
		Active chemistry slots: etak0_1, etak0_2, etak0_3, E_a_1, E_a_2, E_a_3.
		Transport and porosity/blocking morphology: k_fb_multiplier, k_bed_multiplier,
		k_part_multiplier, eps_bed, tau_bed, Sh_particle, d_int_multiplier,
		eps_o_init, k_block, E_dens, eps_crit, perm_exp, D_floor_frac, lam_open_1,
		lam_open_2, lam_open_3, lam_open_4.
		`eps_o` opens with local net reduction rates and `phi_b` grows irreversibly with
		temperature-activated metallic-iron buildup.
		} END NOTES;
	METHODS
	METHOD on_load;
		RUN m.on_load;
	END on_load;
END tgadyn_msbed_linked_radial_porosity;

MODEL tgadyn_msbed_linked_radial_nomorph;
	m IS_A tgadyn_msbed_linked_radial_nomorph_configurable(10, 5);
	METHODS
	METHOD on_load;
		RUN m.on_load;
	END on_load;
