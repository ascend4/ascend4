REQUIRE "ivpsystem.a4l";
REQUIRE "atoms.a4l";
REQUIRE "basemodel.a4l";
REQUIRE "johnpye/thermo_types.a4c";
REQUIRE "johnpye/fboard.a4c";
REQUIRE "johnpye/iron/tga.a4c";

(*
	First dynamic TGA screening model using declarative INDEPENDENT t,
	der(...) equations, and INITIAL startup constraints
	and intended for integration with IDA.

	This is a dynamic counterpart to johnpye/iron/tga.a4c:
	- a discretised quasi-steady Maxwell-Stefan freeboard is retained;
	- the bed transport closure remains lumped in this phase;
	- the same three kineq-style reduction steps are retained;
	- the gas side remains quasi-steady and algebraic;
	- the solid extents xi1, xi2, xi3 are now true dynamic states.

	The first target is not a full distributed bed model. It upgrades only
	the freeboard transport closure so that the measured freeboard effect can
	be compared against a physically structured diffusion model while the bed
	and particle ensemble remain lumped.
*)

MODEL tga_reduction_screen_dyn_msfb(
	n_fb_segs IS_A integer_constant;
);
	steps "reduction reaction steps" IS_A set OF integer_constant;
	steps :== [1..3]; 

	(* Independent variable *)
	t IS_A time;
	INDEPENDENT t;

	(* Gas-side conditions and simple TGA geometry *)
	A_crucible IS_A area;
	L_freeboard, H_bed IS_A distance;

	m_sample_init, m_sample IS_A mass;
	rho_bulk_bed IS_A mass_density;
	m_sample.lower_bound := -1 {kg};

	eps_bed, tau_bed IS_A positive_factor;
	L_mult, k_bed_multiplier IS_A positive_factor;
	L_bl IS_A distance;

	(* Gas compositions *)
	y_H2_bulk, y_H2O_bulk, y_Ar_bulk IS_A mole_fraction;
	y_H2_fb_top, y_H2O_fb_top, y_Ar_fb_top IS_A mole_fraction;
	y_H2_react, y_H2O_react, y_Ar_react IS_A mole_fraction;

	c_tot IS_A molar_density;

	(* Gas transport properties *)
	tr IS_A diffusion_h2o_h2_ar;
	T ALIASES tr.T;
	p ALIASES tr.p;
	D_screen, D_eff_bed IS_A diffusivity;
	L_freeboard_eff IS_A distance;
	fb IS_A freeboard_1d_stagnant_transport(n_fb_segs);

	R_bl, R_fb, R_bed, R_overall IS_A transport_resistance;
	J_transport IS_A molar_flux;

	(* transport screening factor ~1 if becoming limiting *)
	TS_bl, TS_freeboard, TS_bed, TS_overall IS_A factor;

	(* Solid inventory and dynamic extents *)
	MW_Fe2O3, MW_Fe3O4, MW_FeO, MW_Fe IS_A molar_mass;
	n0_Fe2O3 IS_A mole;
	n0_per_area IS_A mole_per_area;
	xi[steps] IS_A reduction_extent;

	n_Fe2O3, n_Fe3O4, n_FeO, n_Fe IS_A mole;
	oxygen_remaining IS_A mole;
	reduction_degree IS_A factor;

	(* Stepwise kineq-style local kinetics *)
	eta[steps] IS_A positive_factor;
	k0[steps] IS_A rate_per_pressure;
	E_a[steps] IS_A molar_energy;
	k_step[steps] IS_A rate_per_pressure;
	k_step[steps].lower_bound := -1e6 {1/s/Pa};

	K_eq_lnA[steps] IS_A factor;
	K_eq_lnB[steps] IS_A factor;
	K_ratio_eq[steps] IS_A positive_factor;

	drive[steps] IS_A delta_pressure;
	rate_forward[steps] IS_A extent_rate;
	rate_reverse[steps] IS_A extent_rate;
	rate_net[steps] IS_A extent_rate;

	J_reaction IS_A molar_flux;
	ctot_eq: c_tot = p / (1 {GAS_C} * T);

	bulk_sum: y_Ar_bulk = 1 - y_H2_bulk - y_H2O_bulk;

	Lfb_eff_eq: L_freeboard_eff = L_mult * L_freeboard;
	fb_T_eq: fb.T = T;
	fb_p_eq: fb.p = p;
	fb_L_eq: fb.L = L_freeboard_eff;
	bl_ar_eq: y_Ar_fb_top = y_Ar_bulk;
	bl_sum_eq: y_H2O_fb_top = 1 - y_Ar_fb_top - y_H2_fb_top;
	Rbl_eq: R_bl = L_bl / D_screen;
	Jbl_eq: R_bl * J_transport = c_tot * (y_H2_bulk - y_H2_fb_top);
	fb_top_h2_eq: fb.y_H2_top = y_H2_fb_top;
	fb_top_h2o_eq: fb.y_H2O_top = y_H2O_fb_top;
	fb_flux_h2_eq: fb.N_H2 = J_transport;
	fb_flux_h2o_eq: fb.N_H2O = -J_transport;

	react_ar_eq: y_Ar_react = fb.y_Ar[n_fb_segs];
	react_sum: y_H2O_react = 1 - y_Ar_react - y_H2_react;

	n0_eq: n0_Fe2O3 = m_sample_init / MW_Fe2O3;
	n0area_eq: n0_per_area = n0_Fe2O3 / A_crucible;
	xi1_eq: xi[1] = (1 - n_Fe2O3 / n0_Fe2O3) / 3;
	xi2_eq: xi[2] = 2 * xi[1] - n_Fe3O4 / n0_Fe2O3;
	xi3_eq: xi[3] = n_Fe / n0_Fe2O3;

	msample_eq:
		m_sample
		=
		n_Fe2O3 * MW_Fe2O3
		+ n_Fe3O4 * MW_Fe3O4
		+ n_FeO * MW_FeO
		+ n_Fe * MW_Fe;
	Hbed_eq: H_bed = m_sample / (rho_bulk_bed * A_crucible);

	oxygen_eq: oxygen_remaining = 3 * n_Fe2O3 + 4 * n_Fe3O4 + n_FeO;
	reduction_degree_eq:
		reduction_degree = (3 * n0_Fe2O3 - oxygen_remaining) / (3 * n0_Fe2O3);

	Dscreen_eq:
		D_screen = 2 / (1 / tr.D_H2_Ar + 1 / tr.D_H2O_Ar);
	Deffbed_eq: D_eff_bed = (eps_bed / tau_bed) * D_screen;

	Rbed_eq: R_bed = H_bed / (k_bed_multiplier * D_eff_bed);
	Roverall_eq: R_overall * J_transport = c_tot * (y_H2_bulk - y_H2_react);
	screen_bl_eq: TS_bl = J_reaction * R_bl / (c_tot * y_H2_bulk);

	SELECT (n_fb_segs)
	CASE 0:
		Rfb_eq_zero: R_fb = 0 {s/m};
		Jtrans_eq_zero: R_bed * J_transport = c_tot * (fb.y_H2[n_fb_segs] - y_H2_react);
		screen_fb_eq_zero: TS_freeboard = 0;
		screen_bed_eq_zero: TS_bed = J_reaction * R_bed / (c_tot * fb.y_H2[n_fb_segs]);
		screen_overall_eq_zero: TS_overall = J_reaction * R_overall / (c_tot * y_H2_bulk);
	OTHERWISE:
		Rfb_eq: R_fb * J_transport = c_tot * (y_H2_fb_top - fb.y_H2[n_fb_segs]);
		Jtrans_eq: R_bed * J_transport = c_tot * (fb.y_H2[n_fb_segs] - y_H2_react);
		screen_fb_eq: TS_freeboard = J_reaction * R_fb / (c_tot * y_H2_bulk);
		screen_bed_eq: TS_bed = J_reaction * R_bed / (c_tot * fb.y_H2[n_fb_segs]);
		screen_overall_eq: TS_overall = J_reaction * R_overall / (c_tot * y_H2_bulk);
	END SELECT;

	FOR r IN steps CREATE
		kstep_eq[r]:
			k_step[r] = eta[r] * k0[r] * exp(-E_a[r] / (1 {GAS_C} * T));
		Keq_eq[r]:
			K_ratio_eq[r] = exp(K_eq_lnA[r]
									- K_eq_lnB[r] / (T / 1 {K}));
		drive_eq[r]:
			drive[r] = p * (y_H2_react - y_H2O_react / K_ratio_eq[r]);
		rnet_eq[r]:
			rate_net[r] = rate_forward[r] - rate_reverse[r];

	END FOR;

	nhe_ode: der(n_Fe2O3) = -3 * n0_Fe2O3 * rate_net[1];
	nmag_ode: der(n_Fe3O4) = n0_Fe2O3 * (2 * rate_net[1] - rate_net[2]);
	nwu_ode: der(n_FeO) = n0_Fe2O3 * (3 * rate_net[2] - rate_net[3]);
	nfe_ode: der(n_Fe) = n0_Fe2O3 * rate_net[3];

	rf1_eq:
		rate_forward[1] = (n_Fe2O3 / n0_Fe2O3) * k_step[1] * p * y_H2_react;
	rr1_eq:
		rate_reverse[1] = (n_Fe3O4 / n0_Fe2O3) * k_step[1] * p * y_H2O_react / K_ratio_eq[1];

	rf2_eq:
		rate_forward[2] = (n_Fe3O4 / n0_Fe2O3) * k_step[2] * p * y_H2_react;
	rr2_eq:
		rate_reverse[2] = (n_FeO / n0_Fe2O3) * k_step[2] * p * y_H2O_react / K_ratio_eq[2];

	rf3_eq:
		rate_forward[3] = (n_FeO / n0_Fe2O3) * k_step[3] * p * y_H2_react;
	rr3_eq:
		rate_reverse[3] = (n_Fe / n0_Fe2O3) * k_step[3] * p * y_H2O_react / K_ratio_eq[3];

	Jrxn_eq:
	J_reaction = n0_per_area * (rate_net[1] + rate_net[2] + rate_net[3]);

	transport_match: J_transport = J_reaction;

INITIAL
	nhe_initial: n_Fe2O3 = m_sample_init / MW_Fe2O3;
	nmag_initial: n_Fe3O4 = 0 {mol};
	nwu_initial: n_FeO = 0 {mol};
	nfe_initial: n_Fe = 0 {mol};

METHODS
	METHOD values;
		RUN fb.values;
		FIX T := 1073.15 {K};
		FIX p := 1 {bar};
		FIX A_crucible := 20 {mm^2};
		FIX L_freeboard := 8.3 {mm};

		FIX m_sample_init := 100 {mg};
		rho_bulk_bed := 1500 {kg/m^3};
		H_bed := 2 {mm};

		FIX eps_bed := 0.45;
		FIX tau_bed := 3.0;
		FIX L_mult := 1.0;
		FIX L_bl := 0 {mm};
		FIX k_bed_multiplier := 2.0;

		FIX y_H2_bulk := 0.8;
		FIX y_H2O_bulk := 0.0;
		y_Ar_bulk := 0.2;
		y_H2_react := 0.75;
		y_H2O_react := 0.05;
		y_Ar_react := 0.2;

		FIX MW_Fe2O3 := 159.687 {g/g_mole};
		FIX MW_Fe3O4 := 231.531 {g/g_mole};
		FIX MW_FeO := 71.844 {g/g_mole};
		FIX MW_Fe := 55.845 {g/g_mole};

		FIX k0[1] := 3e-4 {1/s/Pa};
		FIX k0[2] := 1.5e-4 {1/s/Pa};
		FIX k0[3] := 7.5e-4 {1/s/Pa};

		FIX eta[1] := 1.0;
		FIX eta[2] := 1.0;
		FIX eta[3] := 1.0;

		FIX E_a[1] := 55 {kJ/mol};
		FIX E_a[2] := 60 {kJ/mol};
		FIX E_a[3] := 62 {kJ/mol};

		FIX K_eq_lnA[1] := 8.54050167864375;
		FIX K_eq_lnA[2] := 8.447122204684765;
		FIX K_eq_lnA[3] := 1.0604569618298618;
		FIX K_eq_lnB[1] := 2552.121942697152;
		FIX K_eq_lnB[2] := 8067.2733483476295;
		FIX K_eq_lnB[3] := 1856.1489018164739;

		xi[1] := 0;
		xi[2] := 0;
		xi[3] := 0;

		FIX t := 0 {s};
	END values;

	METHOD bound_self;
		(*
			The first depletion event is still a known weak spot for this model.
			Allow a small amount of negative trial-state chatter during IDA root
			localisation so the default CLI integration path does not fail just
			from transient below-bound probes before we add a proper depletion
			boundary/state transition.
		*)
		n_Fe2O3.lower_bound := -1e-9 {mol};
		n_Fe3O4.lower_bound := -1e-12 {mol};
		n_FeO.lower_bound := -1e-12 {mol};
		n_Fe.lower_bound := -1e-12 {mol};
		oxygen_remaining.lower_bound := -1e-9 {mol};
		L_bl.lower_bound := 0 {mm};

		tr.h2o_h2.sigma_ij.lower_bound := -1 {m};
		tr.h2o_ar.sigma_ij.lower_bound := -1 {m};
		tr.h2_ar.sigma_ij.lower_bound := -1 {m};
		tr.h2o_h2.eps_over_k_ij.lower_bound := -1 {K};
		tr.h2o_ar.eps_over_k_ij.lower_bound := -1 {K};
		tr.h2_ar.eps_over_k_ij.lower_bound := -1 {K};
		tr.h2o_h2.T_star.lower_bound := -1e6;
		tr.h2o_ar.T_star.lower_bound := -1e6;
		tr.h2_ar.T_star.lower_bound := -1e6;
		tr.h2o_h2.Omega_D.lower_bound := -1e6;
		tr.h2o_ar.Omega_D.lower_bound := -1e6;
		tr.h2_ar.Omega_D.lower_bound := -1e6;
		tr.h2o_h2.D_ij.lower_bound := -1 {m^2/s};
		tr.h2o_ar.D_ij.lower_bound := -1 {m^2/s};
		tr.h2_ar.D_ij.lower_bound := -1 {m^2/s};
		tr.h2o_h2.D_ij_FSG.lower_bound := -1 {m^2/s};
		tr.h2o_ar.D_ij_FSG.lower_bound := -1 {m^2/s};
		tr.h2_ar.D_ij_FSG.lower_bound := -1 {m^2/s};
		fb.tr.h2o_h2.sigma_ij.lower_bound := -1 {m};
		fb.tr.h2o_ar.sigma_ij.lower_bound := -1 {m};
		fb.tr.h2_ar.sigma_ij.lower_bound := -1 {m};
		fb.tr.h2o_h2.eps_over_k_ij.lower_bound := -1 {K};
		fb.tr.h2o_ar.eps_over_k_ij.lower_bound := -1 {K};
		fb.tr.h2_ar.eps_over_k_ij.lower_bound := -1 {K};
		fb.tr.h2o_h2.T_star.lower_bound := -1e6;
		fb.tr.h2o_ar.T_star.lower_bound := -1e6;
		fb.tr.h2_ar.T_star.lower_bound := -1e6;
		fb.tr.h2o_h2.Omega_D.lower_bound := -1e6;
		fb.tr.h2o_ar.Omega_D.lower_bound := -1e6;
		fb.tr.h2_ar.Omega_D.lower_bound := -1e6;
		fb.tr.h2o_h2.D_ij.lower_bound := -1 {m^2/s};
		fb.tr.h2o_ar.D_ij.lower_bound := -1 {m^2/s};
		fb.tr.h2_ar.D_ij.lower_bound := -1 {m^2/s};
		fb.tr.h2o_h2.D_ij_FSG.lower_bound := -1 {m^2/s};
		fb.tr.h2o_ar.D_ij_FSG.lower_bound := -1 {m^2/s};
		fb.tr.h2_ar.D_ij_FSG.lower_bound := -1 {m^2/s};
	END bound_self;

	METHOD use_measured_bed_height;
		FIX H_bed;
		FREE rho_bulk_bed;
	END use_measured_bed_height;

	METHOD use_bulk_density_model;
		FIX rho_bulk_bed;
		FREE H_bed;
	END use_bulk_density_model;

	METHOD algebraic_base;
		RUN reset;
		RUN values;
		RUN bound_self;
		RUN use_measured_bed_height;
	END algebraic_base;

	METHOD steady_init;
		FREE der(n_Fe2O3), der(n_Fe3O4), der(n_FeO), der(n_Fe);
		RUN enter_initial_mode;
		SOLVER QRSlv;
		OPTION convopt 'RELNOM_SCALE';
		OPTION iterationlimit 1000;
		SOLVE;
		RUN leave_initial_mode;
	END steady_init;

	METHOD dynamic_reset;
		n_Fe2O3 := m_sample_init / MW_Fe2O3;
		n_Fe3O4 := 0 {mol};
		n_FeO := 0 {mol};
		n_Fe := 0 {mol};
		t := 0 {s};
	END dynamic_reset;

	METHOD reinitialise;
		RUN dynamic_reset;
		RUN steady_init;
	END reinitialise;

	METHOD observe_default;
		reduction_degree.obs_id := 1;
		m_sample.obs_id := 2;
		y_H2_react.obs_id := 3;
		y_H2O_react.obs_id := 4;
		J_transport.obs_id := 5;
		FOR i IN [0..n_fb_segs] DO
			fb.y_H2[i].obs_id := 6 + i;
			fb.y_H2O[i].obs_id := 40 + i;
		END FOR;
		rate_net[1].obs_id := 18;
		rate_net[2].obs_id := 19;
		rate_net[3].obs_id := 20;
		xi[1].obs_id := 21;
		xi[2].obs_id := 22;
		xi[3].obs_id := 23;
		n_Fe2O3.obs_id := 24;
		n_Fe3O4.obs_id := 25;
		n_FeO.obs_id := 26;
		n_Fe.obs_id := 27;
	END observe_default;

	METHOD observe_cli_default;
		OBSERVE reduction_degree, m_sample,
			n_Fe2O3, n_Fe3O4, n_FeO, n_Fe,
			y_H2_react, y_H2O_react,
			J_transport;
	END observe_cli_default;

	METHOD sahar_873K_setup;
		T := 873.15 {K};
		y_H2_bulk := 0.8;
		H_bed := 2 {mm};
		L_freeboard := 8.3 {mm};
		m_sample_init := 100 {mg};
		RUN use_measured_bed_height;
	END sahar_873K_setup;

	METHOD sahar_1073K_setup;
		T := 1073.15 {K};
		y_H2_bulk := 0.8;
		H_bed := 2 {mm};
		L_freeboard := 8.3 {mm};
		m_sample_init := 100 {mg};
		RUN use_measured_bed_height;
	END sahar_1073K_setup;

	METHOD case_10mg;
		m_sample_init := 10 {mg};
		RUN reinitialise;
	END case_10mg;

	METHOD case_100mg;
		m_sample_init := 100 {mg};
		RUN reinitialise;
	END case_100mg;

	METHOD prep_sahar_873K;
		RUN sahar_873K_setup;
		RUN dynamic_reset;
	END prep_sahar_873K;

	METHOD prep_sahar_1073K;
		RUN sahar_1073K_setup;
		RUN dynamic_reset;
	END prep_sahar_1073K;

	METHOD case_sahar_600C;
		RUN prep_sahar_873K;
		RUN steady_init;
	END case_sahar_600C;

	METHOD case_sahar_800C;
		RUN prep_sahar_1073K;
		RUN steady_init;
	END case_sahar_800C;

	METHOD case_sahar_873K;
		RUN case_sahar_600C;
	END case_sahar_873K;

	METHOD case_sahar_1073K;
		RUN case_sahar_800C;
	END case_sahar_1073K;

	METHOD ode_init;
		FIX t;
		FREE der(n_Fe2O3), der(n_Fe3O4), der(n_FeO), der(n_Fe);
		RUN dynamic_reset;
		RUN observe_default;
	END ode_init;

	METHOD on_load;
		RUN algebraic_base;
		RUN dynamic_reset;
		FREE der(n_Fe2O3), der(n_Fe3O4), der(n_FeO), der(n_Fe);
		RUN observe_default;
		RUN observe_cli_default;
	END on_load;
END tga_reduction_screen_dyn_msfb;

(* vim: sw=4:noet:ts=4
*)
