REQUIRE "johnpye/fprops/reactive_stoic.a4l";

(* Concrete, unparameterized flowsheet connector.  Keeping thermodynamic
   package selection out of the connector permits whole-stream
   ARE_THE_SAME connections even where adjacent units use different
   stage-specific FPROPS packages. *)
MODEL alumina_stream;
	components IS_A set OF symbol_constant;
	components :== ['gibbsite', 'boehmite', 'gamma_alumina', 'water'];
	T IS_A temperature;
	P IS_A pressure;
	f[components] IS_A molar_rate;

	METHODS
	METHOD default_self;
		T := 298.15 {K};
		P := 1 {bar};
		FOR i IN components DO
			f[i] := 0 {mol/s};
		END FOR;
	END default_self;
END alumina_stream;

(*
	Partition a reactive stream's enthalpy flow into selected solid and vapour
	components.  The masked component-flow vectors are evaluated through the
	same FPROPS package as the parent stream, so the two reported contributions
	use exactly the same species data and reference states as the unit energy
	balance.  This is intended as a reporting model for packages containing
	independent pure phases, as used by the alumina flowsheet.
*)
MODEL alumina_enthalpy_split(
	pkg WILL_BE reactive_package;
	solids WILL_BE set OF symbol_constant;
	vapours WILL_BE set OF symbol_constant;
);
	components ALIASES pkg.components;
	T IS_A temperature;
	P IS_A pressure;
	f[components] IS_A molar_rate;
	f_solids[components] IS_A molar_rate;
	f_vapours[components] IS_A molar_rate;
	H_flow_solids IS_A energy_rate;
	H_flow_vapours IS_A energy_rate;

	FOR i IN solids CREATE
		f_solids[i], f[i] ARE_THE_SAME;
		vapours_zero[i]: f_vapours[i] = 0 {mol/s};
	END FOR;
	FOR i IN vapours CREATE
		solids_zero[i]: f_solids[i] = 0 {mol/s};
		f_vapours[i], f[i] ARE_THE_SAME;
	END FOR;
	calc_H_flow_solids: fprops_rxn_h_TPn(
		T, P, f_solids[components] : INPUT;
		H_flow_solids : OUTPUT;
		pkg : DATA
	);
	calc_H_flow_vapours: fprops_rxn_h_TPn(
		T, P, f_vapours[components] : INPUT;
		H_flow_vapours : OUTPUT;
		pkg : DATA
	);
END alumina_enthalpy_split;

MODEL alumina_heater(
	pkg WILL_BE reactive_package;
	solids WILL_BE set OF symbol_constant;
	vapours WILL_BE set OF symbol_constant;
);
	inlet IS_A alumina_stream;
	outlet IS_A alumina_stream;
	IN_SPLIT IS_A alumina_enthalpy_split(pkg, solids, vapours);
	OUT_SPLIT IS_A alumina_enthalpy_split(pkg, solids, vapours);
	Qdot IS_A energy_rate;
	Qdot_solids IS_A energy_rate;
	Qdot_vapours IS_A energy_rate;
	DeltaP IS_A delta_pressure;

	FOR i IN inlet.components CREATE
		outlet.f[i], inlet.f[i] ARE_THE_SAME;
	END FOR;
	IN_SPLIT.T, inlet.T ARE_THE_SAME;
	IN_SPLIT.P, inlet.P ARE_THE_SAME;
	OUT_SPLIT.T, outlet.T ARE_THE_SAME;
	OUT_SPLIT.P, outlet.P ARE_THE_SAME;
	FOR i IN pkg.components CREATE
		IN_SPLIT.f[i], inlet.f[i] ARE_THE_SAME;
		OUT_SPLIT.f[i], outlet.f[i] ARE_THE_SAME;
	END FOR;
	pbal: outlet.P = inlet.P - DeltaP;
	solids_duty: Qdot_solids
		= OUT_SPLIT.H_flow_solids - IN_SPLIT.H_flow_solids;
	vapours_duty: Qdot_vapours
		= OUT_SPLIT.H_flow_vapours - IN_SPLIT.H_flow_vapours;
	ebal: Qdot = Qdot_solids + Qdot_vapours;

	METHODS
	METHOD default_self;
		RUN inlet.default_self;
		RUN outlet.default_self;
		Qdot := 0 {W};
		DeltaP := 0 {Pa};
	END default_self;
END alumina_heater;

MODEL alumina_interstage_heater(
	pkg_in WILL_BE reactive_package;
	pkg_out WILL_BE reactive_package;
	solids_in WILL_BE set OF symbol_constant;
	solids_out WILL_BE set OF symbol_constant;
	vapours WILL_BE set OF symbol_constant;
);
	inlet IS_A alumina_stream;
	outlet IS_A alumina_stream;
	IN_SPLIT IS_A alumina_enthalpy_split(pkg_in, solids_in, vapours);
	OUT_SPLIT IS_A alumina_enthalpy_split(pkg_out, solids_out, vapours);
	Qdot IS_A energy_rate;
	Qdot_solids IS_A energy_rate;
	Qdot_vapours IS_A energy_rate;
	DeltaP IS_A delta_pressure;

	FOR i IN inlet.components CREATE
		outlet.f[i], inlet.f[i] ARE_THE_SAME;
	END FOR;
	IN_SPLIT.T, inlet.T ARE_THE_SAME;
	IN_SPLIT.P, inlet.P ARE_THE_SAME;
	OUT_SPLIT.T, outlet.T ARE_THE_SAME;
	OUT_SPLIT.P, outlet.P ARE_THE_SAME;
	FOR i IN pkg_in.components CREATE
		IN_SPLIT.f[i], inlet.f[i] ARE_THE_SAME;
	END FOR;
	FOR i IN pkg_out.components CREATE
		OUT_SPLIT.f[i], outlet.f[i] ARE_THE_SAME;
	END FOR;
	pbal: outlet.P = inlet.P - DeltaP;
	solids_duty: Qdot_solids
		= OUT_SPLIT.H_flow_solids - IN_SPLIT.H_flow_solids;
	vapours_duty: Qdot_vapours
		= OUT_SPLIT.H_flow_vapours - IN_SPLIT.H_flow_vapours;
	ebal: Qdot = Qdot_solids + Qdot_vapours;

	METHODS
	METHOD default_self;
		RUN inlet.default_self;
		RUN outlet.default_self;
		Qdot := 0 {W};
		DeltaP := 0 {Pa};
	END default_self;
END alumina_interstage_heater;

(* Adapter from the concrete flowsheet stream to the reusable, package-based
   stoichiometric reactor.  Species outside the selected package pass through
   unchanged and contribute no enthalpy, so they must be absent for that
   stage's calculation to be physically meaningful. *)
MODEL alumina_reactor(
	pkg WILL_BE reactive_package;
	reactions WILL_BE set OF symbol_constant;
);
	inlet IS_A alumina_stream;
	outlet IS_A alumina_stream;
	CORE IS_A reactor_stoic(pkg, reactions);
	rxns ALIASES CORE.rxns;
	xi ALIASES CORE.xi;
	mu0 ALIASES CORE.mu0;
	dg0_rxn ALIASES CORE.dg0_rxn;
	DG0dot ALIASES CORE.DG0dot;
	Qdot ALIASES CORE.Qdot;
	DeltaP ALIASES CORE.DeltaP;

	inlet.T, CORE.inlet.T ARE_THE_SAME;
	inlet.P, CORE.inlet.P ARE_THE_SAME;
	outlet.T, CORE.outlet.T ARE_THE_SAME;
	outlet.P, CORE.outlet.P ARE_THE_SAME;
	FOR i IN pkg.components CREATE
		inlet.f[i], CORE.inlet.f[i] ARE_THE_SAME;
		outlet.f[i], CORE.outlet.f[i] ARE_THE_SAME;
	END FOR;
	FOR i IN inlet.components - pkg.components CREATE
		inlet.f[i], outlet.f[i] ARE_THE_SAME;
	END FOR;

	METHODS
	METHOD default_self;
		RUN inlet.default_self;
		RUN outlet.default_self;
		RUN CORE.default_self;
	END default_self;
END alumina_reactor;

(*
	Two-stage isothermal gibbsite calcination flowsheet:

		stage 1: Al2O3.3H2O(cr) -> Al2O3.H2O(cr) + 2 H2O(g)
		stage 2: Al2O3.H2O(cr)  -> gamma-Al2O3(cr) + H2O(g)

	FPROPS stores gibbsite and boehmite on the double-formula basis shown.
	Both reaction extents therefore use one mole of eventual Al2O3 product as
	their basis.  Complete conversion of 1 mol/s gibbsite produces 1 mol/s
	gamma-alumina and 3 mol/s steam.

	The two reaction extents and temperatures are specified independently.
	The interstage heater has a signed duty, so it naturally becomes a cooler
	if T_stage2 is low enough.  Every Qdot uses the convention positive = heat
	supplied to the process, negative = heat removed.
	The default temperatures are practical baseline settings (250 degC for
	stage 1 and 500 degC for stage 2), not equilibrium onset temperatures.

	dg0_stage1 and dg0_stage2 are standard reaction Gibbs energies at the
	package reference pressure.  Their zero crossings assume unit-activity
	solids and steam fugacity equal to 1 bar.  Actual gas environments require
	the appropriate R T ln(f_H2O/f0) correction.
*)

MODEL alumina;
	components1 IS_A set OF symbol_constant;
	components2 IS_A set OF symbol_constant;
	reactions1 IS_A set OF symbol_constant;
	reactions2 IS_A set OF symbol_constant;
	solids1 IS_A set OF symbol_constant;
	solids2 IS_A set OF symbol_constant;
	vapours IS_A set OF symbol_constant;
	solids1 :== ['gibbsite', 'boehmite'];
	solids2 :== ['boehmite', 'gamma_alumina'];
	vapours :== ['water'];

	pkg1 IS_A reactive_package(components1);
	pkg1.source :== 'gibbsite=serena_2009;boehmite=serena_2009;water=ideal+ref0:RPP';
	pkg1.algorithm :== 'auto';
	pkg2 IS_A reactive_package(components2);
	(* Serena boehmite is valid to 900 K, so the non-extrapolated stage-2
	   operating range currently ends at 626.85 degC. *)
	pkg2.source :== 'boehmite=serena_2009;gamma_alumina=usgs_bull_1452_1978;water=ideal+ref0:RPP';
	pkg2.algorithm :== 'auto';

	PREHEATER IS_A alumina_heater(pkg1, solids1, vapours);
	R1 IS_A alumina_reactor(pkg1, reactions1);
	INTERHEATER IS_A alumina_interstage_heater(
		pkg1, pkg2, solids1, solids2, vapours
	);
	R2 IS_A alumina_reactor(pkg2, reactions2);
	COOLER IS_A alumina_heater(pkg2, solids2, vapours);

	TABLE nu1_table[reactions1,components1] IS_A real_constant;
		             gibbsite  boehmite  water
		GIB_TO_BOEHM       -1         1      2
	END TABLE;
	TABLE nu2_table[reactions2,components2] IS_A real_constant;
		             boehmite  gamma_alumina  water
		BOEHM_TO_GAMMA      -1              1      1
	END TABLE;

	T_ambient ALIASES PREHEATER.inlet.T;
	T_stage1 ALIASES R1.inlet.T;
	T_stage2 ALIASES R2.inlet.T;
	(* Backwards-compatible stage-1 aliases. *)
	T_reaction ALIASES R1.inlet.T;
	dg0_rxn ALIASES R1.dg0_rxn['GIB_TO_BOEHM'];
	DG0dot ALIASES R1.DG0dot['GIB_TO_BOEHM'];
	dg0_stage1 ALIASES R1.dg0_rxn['GIB_TO_BOEHM'];
	dg0_stage2 ALIASES R2.dg0_rxn['BOEHM_TO_GAMMA'];
	DG0dot_stage1 ALIASES R1.DG0dot['GIB_TO_BOEHM'];
	DG0dot_stage2 ALIASES R2.DG0dot['BOEHM_TO_GAMMA'];

	(* The flowsheet topology is now expressed directly as whole-stream
	   identity connections. *)
	PREHEATER.outlet, R1.inlet ARE_THE_SAME;
	R1.outlet, INTERHEATER.inlet ARE_THE_SAME;
	INTERHEATER.outlet, R2.inlet ARE_THE_SAME;
	R2.outlet, COOLER.inlet ARE_THE_SAME;

	R1.outlet.T, R1.inlet.T ARE_THE_SAME;
	R2.outlet.T, R2.inlet.T ARE_THE_SAME;
	COOLER.outlet.T, T_ambient ARE_THE_SAME;

	q_rxn1 IS_A molar_energy;
	q_rxn2 IS_A molar_energy;
	stage1_duty_per_extent: R1.Qdot
		= R1.xi['GIB_TO_BOEHM'] * q_rxn1;
	stage2_duty_per_extent: R2.Qdot
		= R2.xi['BOEHM_TO_GAMMA'] * q_rxn2;
	(* Backwards-compatible stage-1 alias. *)
	q_rxn ALIASES q_rxn1;

	Qdot_preheater ALIASES PREHEATER.Qdot;
	Qdot_reactor1 ALIASES R1.Qdot;
	Qdot_interstage ALIASES INTERHEATER.Qdot;
	Qdot_reactor2 ALIASES R2.Qdot;
	Qdot_final_cooler ALIASES COOLER.Qdot;
	(* Signed sensible-duty partitions: positive = heating, negative = cooling. *)
	Qdot_preheater_solids ALIASES PREHEATER.Qdot_solids;
	Qdot_preheater_steam ALIASES PREHEATER.Qdot_vapours;
	Qdot_interstage_solids ALIASES INTERHEATER.Qdot_solids;
	Qdot_interstage_steam ALIASES INTERHEATER.Qdot_vapours;
	Qdot_final_cooler_solids ALIASES COOLER.Qdot_solids;
	Qdot_final_cooler_steam ALIASES COOLER.Qdot_vapours;

	(* Positive summaries make heating and rejected cooling easy to compare. *)
	Qdot_sensible_heating_solids IS_A energy_rate;
	Qdot_sensible_heating_steam IS_A energy_rate;
	Qdot_sensible_cooling_solids IS_A energy_rate;
	Qdot_sensible_cooling_steam IS_A energy_rate;
	sensible_heating_solids: Qdot_sensible_heating_solids
		= Qdot_preheater_solids + Qdot_interstage_solids;
	sensible_heating_steam: Qdot_sensible_heating_steam
		= Qdot_preheater_steam + Qdot_interstage_steam;
	sensible_cooling_solids: Qdot_sensible_cooling_solids = -Qdot_final_cooler_solids;
	sensible_cooling_steam: Qdot_sensible_cooling_steam = -Qdot_final_cooler_steam;
	Qdot_stage1 IS_A energy_rate;
	Qdot_stage2 IS_A energy_rate;
	Qdot_cooling IS_A energy_rate;
	Qdot_sensible_net IS_A energy_rate;
	Qdot_total IS_A energy_rate;
	stage1_total: Qdot_stage1 = PREHEATER.Qdot + R1.Qdot;
	stage2_total: Qdot_stage2 = INTERHEATER.Qdot + R2.Qdot;
	(* COOLER.Qdot is negative; Qdot_cooling reports its positive magnitude. *)
	cooling_duty_positive: Qdot_cooling = -COOLER.Qdot;
	(* Net sensible duty after crediting the heat rejected by the cooler. *)
	sensible_net: Qdot_sensible_net = PREHEATER.Qdot + INTERHEATER.Qdot + COOLER.Qdot;
	(* Overall ambient-feed to ambient-products enthalpy difference. *)
	overall_duty: Qdot_total = PREHEATER.Qdot + R1.Qdot
		+ INTERHEATER.Qdot + R2.Qdot + COOLER.Qdot;

	METHODS
	METHOD default_self;
		RUN PREHEATER.default_self;
		RUN R1.default_self;
		RUN INTERHEATER.default_self;
		RUN R2.default_self;
		RUN COOLER.default_self;

		FIX R1.rxns.nu[components1][reactions1];
		FOR i IN components1 DO
			FOR r IN reactions1 DO
				R1.rxns.nu[i][r] := nu1_table[r][i];
			END FOR;
		END FOR;
		FIX R2.rxns.nu[components2][reactions2];
		FOR i IN components2 DO
			FOR r IN reactions2 DO
				R2.rxns.nu[i][r] := nu2_table[r][i];
			END FOR;
		END FOR;

		FIX PREHEATER.inlet.T;
		FIX PREHEATER.inlet.P;
		FIX PREHEATER.inlet.f[PREHEATER.inlet.components];
		FIX R1.inlet.T;
		FIX R2.inlet.T;
		FIX R1.xi[reactions1];
		FIX R2.xi[reactions2];
		FIX PREHEATER.DeltaP;
		FIX R1.DeltaP;
		FIX INTERHEATER.DeltaP;
		FIX R2.DeltaP;
		FIX COOLER.DeltaP;

		PREHEATER.inlet.T := 298.15 {K};
		PREHEATER.inlet.P := 1 {bar};
		PREHEATER.inlet.f['gibbsite'] := 1 {mol/s};
		PREHEATER.inlet.f['boehmite'] := 0 {mol/s};
		PREHEATER.inlet.f['gamma_alumina'] := 0 {mol/s};
		PREHEATER.inlet.f['water'] := 0 {mol/s};
		R1.inlet.T := 523.15 {K};
		R2.inlet.T := 773.15 {K};

		R1.xi['GIB_TO_BOEHM'] := 1 {mol/s};
		R2.xi['BOEHM_TO_GAMMA'] := 1 {mol/s};
		PREHEATER.DeltaP := 0 {Pa};
		R1.DeltaP := 0 {Pa};
		INTERHEATER.DeltaP := 0 {Pa};
		R2.DeltaP := 0 {Pa};
		COOLER.DeltaP := 0 {Pa};
	END default_self;

	METHOD case_325K;
		T_reaction := 325 {K};
	END case_325K;

	METHOD case_350K;
		T_reaction := 350 {K};
	END case_350K;

	METHOD case_375K;
		T_reaction := 375 {K};
	END case_375K;

	METHOD case_385K;
		T_reaction := 385 {K};
	END case_385K;

	METHOD case_390K;
		T_reaction := 390 {K};
	END case_390K;

	METHOD case_400K;
		T_reaction := 400 {K};
	END case_400K;

	METHOD standard_steam_threshold;
		(* Stage 1: solve dg0(T) = 0 at f_H2O = f0 = 1 bar. *)
		FREE R1.inlet.T;
		FIX R1.dg0_rxn['GIB_TO_BOEHM'];
		R1.inlet.T := 397 {K};
		R1.dg0_rxn['GIB_TO_BOEHM'] := 0 {J/mol};
	END standard_steam_threshold;

	METHOD case_450K;
		T_reaction := 450 {K};
	END case_450K;

	METHOD case_500K;
		T_reaction := 500 {K};
	END case_500K;

	METHOD case_550K;
		T_reaction := 550 {K};
	END case_550K;

	METHOD case_600K;
		T_reaction := 600 {K};
	END case_600K;

	METHOD stage1_200C;
		T_stage1 := 473.15 {K};
	END stage1_200C;

	METHOD stage1_250C;
		T_stage1 := 523.15 {K};
	END stage1_250C;

	METHOD stage1_300C;
		T_stage1 := 573.15 {K};
	END stage1_300C;

	METHOD stage2_350K;
		T_stage2 := 350 {K};
	END stage2_350K;

	METHOD stage2_400K;
		T_stage2 := 400 {K};
	END stage2_400K;

	METHOD stage2_450K;
		T_stage2 := 450 {K};
	END stage2_450K;

	METHOD stage2_500K;
		T_stage2 := 500 {K};
	END stage2_500K;

	METHOD stage2_550K;
		T_stage2 := 550 {K};
	END stage2_550K;

	METHOD stage2_600K;
		T_stage2 := 600 {K};
	END stage2_600K;

	METHOD stage2_400C;
		T_stage2 := 673.15 {K};
	END stage2_400C;

	METHOD stage2_450C;
		T_stage2 := 723.15 {K};
	END stage2_450C;

	METHOD stage2_500C;
		T_stage2 := 773.15 {K};
	END stage2_500C;

	METHOD stage2_550C;
		T_stage2 := 823.15 {K};
	END stage2_550C;

	METHOD stage2_600C;
		T_stage2 := 873.15 {K};
	END stage2_600C;

	METHOD industrial_baseline;
		T_stage1 := 523.15 {K};
		T_stage2 := 773.15 {K};
	END industrial_baseline;

	METHOD standard_steam_threshold_stage2;
		(* Stage 2: solve dg0(T) = 0 at f_H2O = f0 = 1 bar. *)
		FREE R2.inlet.T;
		FIX R2.dg0_rxn['BOEHM_TO_GAMMA'];
		R2.inlet.T := 560 {K};
		R2.dg0_rxn['BOEHM_TO_GAMMA'] := 0 {J/mol};
	END standard_steam_threshold_stage2;

	METHOD self_test;
		ASSERT abs(R1.outlet.f['gibbsite']) < 1e-8 {mol/s};
		ASSERT abs(R1.outlet.f['boehmite'] - 1 {mol/s}) < 1e-8 {mol/s};
		ASSERT abs(R1.outlet.f['water'] - 2 {mol/s}) < 1e-8 {mol/s};
		ASSERT abs(R2.outlet.f['boehmite']) < 1e-8 {mol/s};
		ASSERT abs(R2.outlet.f['gamma_alumina'] - 1 {mol/s}) < 1e-8 {mol/s};
		ASSERT abs(R2.outlet.f['water'] - 3 {mol/s}) < 1e-8 {mol/s};
		ASSERT abs(COOLER.outlet.f['boehmite']) < 1e-8 {mol/s};
		ASSERT abs(COOLER.outlet.f['gamma_alumina'] - 1 {mol/s}) < 1e-8 {mol/s};
		ASSERT abs(COOLER.outlet.f['water'] - 3 {mol/s}) < 1e-8 {mol/s};
		ASSERT PREHEATER.Qdot > 0 {W};
		ASSERT R1.Qdot > 0 {W};
		ASSERT INTERHEATER.Qdot > 0 {W};
		ASSERT R2.Qdot > 0 {W};
		ASSERT COOLER.Qdot < 0 {W};
		ASSERT abs(PREHEATER.Qdot - Qdot_preheater_solids
			- Qdot_preheater_steam) < 1e-6 {W};
		ASSERT abs(INTERHEATER.Qdot - Qdot_interstage_solids
			- Qdot_interstage_steam) < 1e-6 {W};
		ASSERT abs(COOLER.Qdot - Qdot_final_cooler_solids
			- Qdot_final_cooler_steam) < 1e-6 {W};
		ASSERT abs(Qdot_preheater_steam) < 1e-6 {W};
		ASSERT Qdot_sensible_heating_solids > 0 {W};
		ASSERT Qdot_sensible_heating_steam > 0 {W};
		ASSERT Qdot_sensible_cooling_solids > 0 {W};
		ASSERT Qdot_sensible_cooling_steam > 0 {W};
		ASSERT Qdot_cooling > 0 {W};
		ASSERT abs(Qdot_total
			- (COOLER.OUT_SPLIT.H_flow_solids + COOLER.OUT_SPLIT.H_flow_vapours)
			+ (PREHEATER.IN_SPLIT.H_flow_solids + PREHEATER.IN_SPLIT.H_flow_vapours)
		) < 1e-6 {W};
		ASSERT q_rxn1 > 0 {J/mol};
		ASSERT q_rxn2 > 0 {J/mol};
		ASSERT dg0_stage1 < 0 {J/mol};
		ASSERT dg0_stage2 < 0 {J/mol};
		ASSERT abs(DG0dot_stage1
			- R1.xi['GIB_TO_BOEHM'] * dg0_stage1) < 1e-6 {W};
		ASSERT abs(DG0dot_stage2
			- R2.xi['BOEHM_TO_GAMMA'] * dg0_stage2) < 1e-6 {W};
	END self_test;

	METHOD on_load;
		RUN default_self;
	END on_load;
END alumina;
