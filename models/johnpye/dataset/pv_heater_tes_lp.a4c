REQUIRE "atoms.a4l";

(*
	Dimensioned LP/MIP dispatch+sizing model for:
	- PV generation (from Melbourne GHI time-series)
	- direct electric heater to process
	- thermal storage (charge from PV, discharge to process steam)
	- boiler residual

	Storage count is integer-capable (solver_int) and can be relaxed via
	"storage_units.relaxed := TRUE" when desired.
*)

CONSTANT irradiance_data_constant
REFINES real_constant DIMENSION M/T^3;

CONSTANT power_constant
REFINES real_constant DIMENSION M*L^2/T^3;

CONSTANT energy_quantity_constant
REFINES real_constant DIMENSION M*L^2/T^2;

CONSTANT cost_constant
REFINES real_constant DIMENSION C;

CONSTANT cost_per_energy_constant
REFINES real_constant DIMENSION C*T^2/M/L^2;

CONSTANT cost_per_power_constant
REFINES real_constant DIMENSION C*T^3/M/L^2;

CONSTANT cost_rate_constant
REFINES real_constant DIMENSION C/T;

ATOM currency_value REFINES solver_var
	DIMENSION C
	DEFAULT 0 {USD};
	lower_bound := -1e50 {USD};
	upper_bound := 1e50 {USD};
	nominal := 1 {USD};
END currency_value;

ATOM positive_currency_value REFINES currency_value;
	lower_bound := 0 {USD};
END positive_currency_value;

MODEL pv_heater_tes_lp;
	timestep IS_A set OF integer_constant;
	dispatch_step IS_A set OF integer_constant;
	dispatch_step_nonfirst IS_A set OF integer_constant;

	solar_irradiance[timestep] IS_A irradiance_data_constant;

	n_steps IS_A integer_constant;
	n_steps :== 8760;
	horizon_steps IS_A integer_constant;
	horizon_steps :== 168;
	dispatch_step :== [1..horizon_steps];
	dispatch_step_nonfirst :== [2..horizon_steps];
	annualization_factor IS_A factor_constant;
	annualization_factor :== (1.0 * n_steps) / horizon_steps;

	(*
		Unit-checked DATASET mapping:
		- target has irradiance dimension
		- map explicitly states {W/m^2}
	*)
	DATASET melbourne FROM "johnpye/dataset/086282TMY_60min.csv.xz";
		solar_irradiance[timestep] IS_A irradiance_data_constant
			FROM 'Mean global irradiance (over 1 minute) in W/sq m' {W/m^2};
	END DATASET;

	(* Technical constants *)
	step_duration IS_A time_constant;
	step_duration :== 1 {h};
	year_duration IS_A time_constant;
	year_duration :== 1 {yr};

	reference_irradiance IS_A irradiance_data_constant;
	reference_irradiance :== 1000 {W/m^2};

	storage_unit_energy IS_A energy_quantity_constant;
	storage_unit_energy :== 20 {MWh};
	storage_unit_charge_power IS_A power_constant;
	storage_unit_charge_power :== 4 {MW};
	storage_unit_discharge_power IS_A power_constant;
	storage_unit_discharge_power :== 3 {MW};

	eta_charge IS_A factor_constant;
	eta_charge :== 0.99498743710662;
	eta_discharge IS_A factor_constant;
	eta_discharge :== 0.99498743710662;

	soc_initial_fraction IS_A factor_constant;
	soc_initial_fraction :== 0.5;
	soc_final_fraction IS_A factor_constant;
	soc_final_fraction :== 0.5;

	(* Demand and target settings *)
	process_demand IS_A power_constant;
	process_demand :== 3 {MW};
	capacity_factor_target IS_A factor_constant;
	capacity_factor_target :== 0.40;
	annual_demand_target IS_A energy_quantity_constant;
	annual_demand_target :== process_demand * step_duration * n_steps;
	displaced_energy_target IS_A energy_quantity_constant;
	displaced_energy_target :== capacity_factor_target * annual_demand_target;

	(* Economics *)
	fuel_price IS_A cost_per_energy_constant;
	fuel_price :== 110.76923076923077 {USD/MWh};

	wacc IS_A factor_constant;
	wacc :== 0.064;
	life_years IS_A integer_constant;
	life_years :== 25;
	crf IS_A factor_constant;
	crf :== wacc * (1 + wacc)^life_years / ((1 + wacc)^life_years - 1);

	pv_capex_per_power IS_A cost_per_power_constant;
	pv_capex_per_power :== 1030850 {USD/MW};
	pv_om_per_energy_equiv IS_A cost_per_energy_constant;
	pv_om_per_energy_equiv :== 12680 {USD/MW/yr};

	storage_unit_capex IS_A cost_constant;
	storage_unit_capex :== 3503332.8166175787 {USD};
	storage_unit_om_rate IS_A cost_rate_constant;
	storage_unit_om_rate :== 12000 {USD/yr};

	heater_capex_per_power IS_A cost_per_power_constant;
	heater_capex_per_power :== 319330 {USD/MW};
	heater_om_per_energy_equiv IS_A cost_per_energy_constant;
	heater_om_per_energy_equiv :== 2000 {USD/MW/yr};

	(* Design variables *)
	pv_capacity IS_A energy_rate;
	storage_units IS_A solver_int;
	heater_capacity IS_A energy_rate;

	(* Derived design quantities *)
	storage_energy_capacity IS_A energy;
	storage_charge_capacity IS_A energy_rate;
	storage_discharge_capacity IS_A energy_rate;

	(* Dispatch variables *)
	pv_available[dispatch_step] IS_A energy_rate;
	pv_to_process[dispatch_step] IS_A energy_rate;
	pv_to_storage[dispatch_step] IS_A energy_rate;
	storage_to_process[dispatch_step] IS_A energy_rate;
	pv_curtailment[dispatch_step] IS_A energy_rate;
	boiler_to_process[dispatch_step] IS_A energy_rate;
	storage_state[dispatch_step] IS_A energy;

	(* Annual energy tallies *)
	displaced_energy IS_A energy;
	boiler_energy IS_A energy;
	pv_energy IS_A energy;
	annual_demand IS_A energy;
	displaced_fraction IS_A fraction;

	(* Annual cost tallies *)
	fuel_cost_annual IS_A positive_currency_value;
	pv_capex_annual IS_A positive_currency_value;
	pv_om_annual IS_A positive_currency_value;
	storage_capex_annual IS_A positive_currency_value;
	storage_om_annual IS_A positive_currency_value;
	heater_capex_annual IS_A positive_currency_value;
	heater_om_annual IS_A positive_currency_value;
	total_annual_cost IS_A positive_currency_value;

	(* Design couplings *)
	z_storage_energy_capacity:
		storage_energy_capacity = storage_units * storage_unit_energy;
	z_storage_charge_capacity_def:
		storage_charge_capacity = storage_units * storage_unit_charge_power;
	z_storage_discharge_capacity_def:
		storage_discharge_capacity = storage_units * storage_unit_discharge_power;

	(* Dispatch constraints *)
	FOR t IN dispatch_step CREATE
		z_pv_available_limit[t]:
			pv_available[t] <= pv_capacity * solar_irradiance[t] / reference_irradiance;

		z_pv_split[t]:
			pv_available[t] = pv_to_process[t] + pv_to_storage[t] + pv_curtailment[t];

		z_heater_capacity[t]:
			pv_to_process[t] <= heater_capacity;

		z_storage_charge_limit[t]:
			pv_to_storage[t] <= storage_charge_capacity;

		z_storage_discharge_limit[t]:
			storage_to_process[t] <= storage_discharge_capacity;

		z_process_balance[t]:
			pv_to_process[t] + storage_to_process[t] + boiler_to_process[t] = process_demand;

		z_storage_state_upper[t]:
			storage_state[t] <= storage_energy_capacity;
	END FOR;

	z_storage_state_first:
		storage_state[1] = soc_initial_fraction * storage_energy_capacity
			+ step_duration * (eta_charge * pv_to_storage[1] - storage_to_process[1] / eta_discharge);

	FOR t IN dispatch_step_nonfirst CREATE
		z_storage_state_rec[t]:
			storage_state[t] = storage_state[t - 1]
				+ step_duration * (eta_charge * pv_to_storage[t] - storage_to_process[t] / eta_discharge);
	END FOR;

	z_storage_state_cycle:
		storage_state[horizon_steps] = soc_final_fraction * storage_energy_capacity;

	(* Annual tallies *)
	z_displaced_energy:
		displaced_energy = annualization_factor
			* SUM[(pv_to_process[t] + storage_to_process[t]) * step_duration | t IN dispatch_step];
	z_boiler_energy:
		boiler_energy = annualization_factor
			* SUM[boiler_to_process[t] * step_duration | t IN dispatch_step];
	z_pv_energy:
		pv_energy = annualization_factor
			* SUM[pv_available[t] * step_duration | t IN dispatch_step];
	z_annual_demand:
		annual_demand = process_demand * step_duration * horizon_steps * annualization_factor;
	z_displaced_fraction:
		displaced_fraction * annual_demand_target = displaced_energy;

	(* Policy/production target *)
	z_displaced_target:
		displaced_energy >= displaced_energy_target;

	(* Economics *)
	z_fuel_cost_annual:
		fuel_cost_annual = fuel_price * boiler_energy;

	z_pv_capex_annual:
		pv_capex_annual = crf * pv_capex_per_power * pv_capacity;
	z_pv_om_annual:
		pv_om_annual = pv_om_per_energy_equiv * pv_capacity * year_duration;

	z_storage_capex_annual:
		storage_capex_annual = crf * storage_unit_capex * storage_units;
	z_storage_om_annual:
		storage_om_annual = storage_unit_om_rate * year_duration * storage_units;

	z_heater_capex_annual:
		heater_capex_annual = crf * heater_capex_per_power * heater_capacity;
	z_heater_om_annual:
		heater_om_annual = heater_om_per_energy_equiv * heater_capacity * year_duration;

	z_total_annual_cost:
		total_annual_cost = fuel_cost_annual
			+ pv_capex_annual + pv_om_annual
			+ storage_capex_annual + storage_om_annual
			+ heater_capex_annual + heater_om_annual;

	obj: MINIMIZE total_annual_cost;

METHODS
METHOD bound_self;
	pv_capacity.lower_bound := 0 {MW};
	pv_capacity.upper_bound := 100 {MW};
	storage_units.lower_bound := 0;
	storage_units.upper_bound := 200;
	heater_capacity.lower_bound := 0 {MW};
	heater_capacity.upper_bound := 100 {MW};

	storage_energy_capacity.lower_bound := 0 {MWh};
	storage_charge_capacity.lower_bound := 0 {MW};
	storage_discharge_capacity.lower_bound := 0 {MW};

	displaced_energy.lower_bound := 0 {MWh};
	boiler_energy.lower_bound := 0 {MWh};
	pv_energy.lower_bound := 0 {MWh};
	annual_demand.lower_bound := 0 {MWh};

	FOR t IN dispatch_step DO
		pv_available[t].lower_bound := 0 {MW};
		pv_to_process[t].lower_bound := 0 {MW};
		pv_to_storage[t].lower_bound := 0 {MW};
		storage_to_process[t].lower_bound := 0 {MW};
		pv_curtailment[t].lower_bound := 0 {MW};
		boiler_to_process[t].lower_bound := 0 {MW};
		boiler_to_process[t].upper_bound := process_demand;
		storage_state[t].lower_bound := 0 {MWh};
	END FOR;
END bound_self;

METHOD default_self;
	pv_capacity := 0 {MW};
	storage_units := 0;
	storage_units.relaxed := TRUE;
	heater_capacity := 0 {MW};

	storage_energy_capacity := 0 {MWh};
	storage_charge_capacity := 0 {MW};
	storage_discharge_capacity := 0 {MW};

	annual_demand := process_demand * step_duration * n_steps;
	displaced_energy := 0 {MWh};
	boiler_energy := annual_demand;
	pv_energy := 0 {MWh};
	displaced_fraction := 0;

	fuel_cost_annual := fuel_price * annual_demand;
	pv_capex_annual := 0 {USD};
	pv_om_annual := 0 {USD};
	storage_capex_annual := 0 {USD};
	storage_om_annual := 0 {USD};
	heater_capex_annual := 0 {USD};
	heater_om_annual := 0 {USD};
	total_annual_cost := fuel_cost_annual;

	FOR t IN dispatch_step DO
		pv_available[t] := 0 {MW};
		pv_to_process[t] := 0 {MW};
		pv_to_storage[t] := 0 {MW};
		storage_to_process[t] := 0 {MW};
		pv_curtailment[t] := 0 {MW};
		boiler_to_process[t] := process_demand;
		storage_state[t] := 0 {MWh};
	END FOR;
END default_self;

METHOD use_storage_relaxation;
	storage_units.relaxed := TRUE;
END use_storage_relaxation;

METHOD use_storage_integer;
	storage_units.relaxed := FALSE;
END use_storage_integer;

METHOD on_load;
	RUN bound_self;
	RUN default_self;
	ASSERT CARD[timestep] = n_steps;
	ASSERT horizon_steps <= n_steps;
	SOLVER HiGHS;
END on_load;

METHOD self_test;
	ASSERT displaced_energy >= displaced_energy_target - 1e-6 {MWh};
	ASSERT abs((displaced_energy + boiler_energy) - annual_demand) < 1e-4 {MWh};
	ASSERT total_annual_cost >= 0 {USD};
END self_test;
END pv_heater_tes_lp;
