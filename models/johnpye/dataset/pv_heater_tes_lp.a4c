REQUIRE "johnpye/dataset/pv_tes_common.a4c";

MODEL pv_heater_tes_lp REFINES pv_tes_common;
	FOR t IN dispatch_step CREATE
		z_process_dispatch_fixed[t]:
			process_dispatch[t] = process_demand;

		z_process_balance[t]:
			pv_to_process[t] + storage_to_process[t] + boiler_to_process[t] = process_dispatch[t];
	END FOR;

	z_annual_demand:
		annual_demand = process_demand * step_duration * horizon_steps * annualization_factor;

	(* Original LP policy target: displaced (PV+TES) annual energy meets CF target *)
	z_displaced_target:
		displaced_energy >= displaced_energy_target;

METHODS
METHOD self_test;
	ASSERT displaced_energy >= displaced_energy_target - 1e-6 {GJ};
	ASSERT abs((displaced_energy + boiler_energy) - annual_demand) < 1e-4 {GJ};
	ASSERT total_annual_cost >= 0 {USD};
END self_test;
END pv_heater_tes_lp;
