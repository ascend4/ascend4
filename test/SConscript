#!/usr/bin/python invoke_using_scons
Import('test_env')
import platform

# local sources
srcs = ['test.c','test_ascend_base.c','redirectStdStreams.c','printutil.c','assertimpl.c']

# test cases from the different tested modules
for dir in test_env['TESTDIRS']:
	srcs += test_env['TESTSRCS_'+dir.upper()]

test_env.Append(
	LIBS = ['ascend','cunit']
	, LIBPATH = ['#']
	, CPPDEFINES = ['-DASC_SHARED']
)

if test_env.get('WITH_PCRE'):
	_pcre_cpp = test_env.get('PCRE_CPPPATH')
	_pcre_libpath = test_env.get('PCRE_LIBPATH')
	test_env.AppendUnique(
		LIBS=test_env['PCRE_LIBS']
	)
	if _pcre_cpp:
		test_env.AppendUnique(CPPPATH=_pcre_cpp)
	if _pcre_libpath:
		test_env.AppendUnique(LIBPATH=_pcre_libpath)

_cunit_cpp = test_env.get('CUNIT_CPPPATH')
if _cunit_cpp:
	test_env.Append(CPPPATH=_cunit_cpp)

_cunit_libpath = test_env.get('CUNIT_LIBPATH')
if _cunit_libpath:
	test_env.Append(LIBPATH=_cunit_libpath)

# CONOPT-specific tests include conopt_dl.h, which in turn includes the
# installed CONOPT API header. libascend has this path already, but test_env is
# cloned separately from the top-level environment.
if 'CONOPT' in test_env['WITH_SOLVERS']:
	_conopt_cpp = test_env.get('CONOPT_CPPPATH')
	if _conopt_cpp:
		test_env.AppendUnique(CPPPATH=_conopt_cpp)
	elif test_env.get('CONOPT_BUNDLED4'):
		test_env.AppendUnique(CPPPATH=['#solvers/conopt'])

conf = test_env.Configure()
if not conf.CheckDeclaration('CU_set_test_output_capture', '#include <CUnit/TestRun.h>\n'):
	print("ERROR: CUnit is missing CU_set_test_output_capture; install CUnit 2.3.0 or newer.")
	Exit(1)
if not conf.CheckDeclaration('CU_get_skip_list', '#include <CUnit/TestRun.h>\n'):
	print("ERROR: CUnit is missing CU_get_skip_list; install CUnit 2.3.0 or newer.")
	Exit(1)
if not conf.TryCompile("""
#include <CUnit/CUnit.h>
#ifndef CU_SKIP
#error "CUnit 2.3.0 or newer is required for CU_SKIP"
#endif
#ifndef CU_SKIP_IF
#error "CUnit 2.3.0 or newer is required for CU_SKIP_IF"
#endif
int main(void){ return 0; }
""", ".c"):
	print("ERROR: CUnit is missing CU_SKIP/CU_SKIP_IF; install CUnit 2.3.0 or newer.")
	Exit(1)
test_env = conf.Finish()

testprog = test_env.Program('test',srcs)

test_env.Depends(testprog,"#/ascend/utilities/test")
test_env.Depends(testprog,[test_env.Dir('#/solvers'), test_env.Dir('#/models')])

if platform.system()=="Windows":
	test_env.Depends(testprog,test_env['libascend'])
else:
	test_env.Depends(testprog,"#/libascend.so.1")
	
# vim: noet:ts=4:sw=4:syntax=python
